{
  "id": "domain-manager",
  "title": "Domínios // Domain Manager",
  "description": "Sistema de gestão de domínios, bases, economia, projetos e missões para Foundry VTT v13.",
  "version": "0.1.0-dev.103",
  "authors": [
    {
      "name": "Fusion",
      "flags": {}
    }
  ],
  "url": "https://github.com/STR4DZN/domain-manager",
  "manifest": "https://raw.githubusercontent.com/STR4DZN/domain-manager/main/module.json",
  "download": "https://github.com/STR4DZN/domain-manager/releases/download/v0.1.0-dev.103/domain-manager-v0.1.0-dev.103.zip",
  "compatibility": {
    "minimum": "13.341",
    "verified": "13.351"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/shell.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "packs": [
    {
      "name": "domain-manager-macros",
      "label": "Domain Manager — Macros",
      "path": "packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "manifest": "https://github.com/farling42/foundryvtt-socketlib/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "1.1.3"
        }
      }
    ]
  },
  "socket": true
}
