<!-- MODAIS IN-PAGE COMPACTOS COM CONTENÇÃO E SCROLL INTERNO -->

<!-- 1. MODAL: ADICIONAR TAGS -->
{{#if isTagModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-tag text-emerald"></i> Adicionar Tags ao Domínio</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelTagModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc">Digite uma ou mais tags separadas por vírgula.</p>
        <div class="dm-form-group mt-1">
          <label>Novas Tags:</label>
          <input type="text" class="dm-input dm-input--compact" id="dm-new-tag-input" placeholder="Ex: capital, mineração, setor-3" autofocus />
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelTagModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitAddTag"><i class="fa-solid fa-check"></i> Salvar Tags</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 2. MODAL: EXCLUIR DOMÍNIO -->
{{#if isDeletingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-dialog-card--danger dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-triangle-exclamation text-rose"></i> Confirmar Exclusão</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelDeleteDomainModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc font-semibold text-rose">
          Excluir permanentemente "<strong>{{selectedDomain.name}}</strong>"?
        </p>
        <p class="dm-dialog-desc mt-1">
          Bases subordinadas serão desvinculadas automaticamente para a raiz para evitar perda de dados.
        </p>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelDeleteDomainModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--danger-fill" data-action="confirmDeleteDomain">
          <i class="fa-solid fa-trash-can"></i> Excluir
        </button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 3. MODAL: CRIAR NOVO DOMÍNIO / BASE -->
{{#if isCreatingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-large">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-plus-circle text-emerald"></i> Criar Novo Domínio / Base</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelCreateDomain"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Nome do Domínio / Base *</label>
            <input type="text" class="dm-input dm-input--compact" id="dm-new-domain-name" placeholder="Ex: Base Alpha, Forte Solar..." autofocus />
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Categoria (Livre)</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-new-domain-category" value="settlement" />
            </div>
            <div class="dm-form-group">
              <label>Natureza</label>
              <select class="dm-select dm-input--compact" id="dm-new-domain-nature">
                <option value="physical">Físico / Territorial</option>
                <option value="organization">Organização / Guilda</option>
                <option value="hybrid">Híbrido</option>
                <option value="abstract">Esfera Abstrata</option>
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Imagem / Ilustração da Base:</label>
            <div class="dm-file-input-group">
              <input type="text" class="dm-input dm-input--compact dm-img-input" id="dm-new-domain-crest" placeholder="caminho/imagem.webp ou https://..." />
              <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="openFilePicker" data-target="#dm-new-domain-crest">
                <i class="fa-solid fa-file-import"></i> Arquivo
              </button>
            </div>
            <div class="dm-form-row mt-1">
              <div class="dm-form-group">
                <label>Ajuste da Imagem:</label>
                <select class="dm-select dm-input--compact" id="dm-new-domain-fit">
                  <option value="cover">Preencher / Banner (cover)</option>
                  <option value="contain">Conter Inteira (contain)</option>
                </select>
              </div>
              <div class="dm-form-group">
                <label>Foco:</label>
                <select class="dm-select dm-input--compact" id="dm-new-domain-pos">
                  <option value="center">Centro</option>
                  <option value="top">Topo</option>
                  <option value="bottom">Base</option>
                </select>
              </div>
            </div>
            <div class="dm-image-preview-container mt-1" style="display: none;">
              <img src="" class="dm-image-preview-rect" alt="Prévia" />
            </div>
          </div>

          <div class="dm-form-group">
            <label>Jogadores Controladores / Donos:</label>
            <div class="dm-player-list">
              {{#if worldPlayers.length}}
                {{#each worldPlayers}}
                  <label class="dm-player-checkbox">
                    <input type="checkbox" class="dm-create-domain-controller" value="{{id}}" />
                    <span>{{name}}</span>
                  </label>
                {{/each}}
              {{else}}
                <span class="dm-text-muted">Nenhum jogador cadastrado.</span>
              {{/if}}
            </div>
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Tags (vírgula)</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-new-domain-tags" placeholder="capital, mineração" />
            </div>
            <div class="dm-form-group">
              <label>Domínio Superior (Hierarquia)</label>
              <select class="dm-select dm-input--compact" id="dm-new-domain-parent">
                <option value="">Nenhum (Raiz / Independente)</option>
                {{#each availableParentDomains}}
                  <option value="{{uuid}}">{{name}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Descrição Geral</label>
            <textarea class="dm-textarea dm-input--compact" id="dm-new-domain-description" rows="2" placeholder="Resumo sobre a base..."></textarea>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelCreateDomain">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitCreateDomain"><i class="fa-solid fa-check"></i> Criar Domínio</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 4. MODAL: EDITAR DOMÍNIO / BASE (COM GALERIA E AJUSTES DE IMAGEM) -->
{{#if isEditingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-large">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-pen-to-square text-amber"></i> Editar Base / Território: {{selectedDomain.name}}</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelEditDomain"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Nome do Domínio / Base *</label>
            <input type="text" class="dm-input dm-input--compact" id="dm-edit-domain-name" value="{{selectedDomain.name}}" />
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Categoria (Livre)</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-edit-domain-category" value="{{selectedDomain.category}}" />
            </div>
            <div class="dm-form-group">
              <label>Natureza</label>
              <select class="dm-select dm-input--compact" id="dm-edit-domain-nature">
                <option value="physical" {{#if (eq selectedDomain.nature 'physical')}}selected{{/if}}>Físico / Territorial</option>
                <option value="organization" {{#if (eq selectedDomain.nature 'organization')}}selected{{/if}}>Organização / Guilda</option>
                <option value="hybrid" {{#if (eq selectedDomain.nature 'hybrid')}}selected{{/if}}>Híbrido</option>
                <option value="abstract" {{#if (eq selectedDomain.nature 'abstract')}}selected{{/if}}>Esfera Abstrata</option>
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Imagem Principal da Base (URL ou Arquivo):</label>
            <div class="dm-file-input-group">
              <input type="text" class="dm-input dm-input--compact dm-img-input" id="dm-edit-domain-crest" value="{{selectedDomain.image}}" placeholder="caminho/imagem.webp ou link..." />
              <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="openFilePicker" data-target="#dm-edit-domain-crest">
                <i class="fa-solid fa-file-import"></i> Arquivo
              </button>
            </div>

            <div class="dm-form-row mt-1">
              <div class="dm-form-group">
                <label>Ajuste da Imagem:</label>
                <select class="dm-select dm-input--compact" id="dm-edit-domain-fit">
                  <option value="cover" {{#if (eq selectedDomain.imageFit 'cover')}}selected{{/if}}>Preencher / Banner (cover)</option>
                  <option value="contain" {{#if (eq selectedDomain.imageFit 'contain')}}selected{{/if}}>Conter Inteira (contain - sem cortes)</option>
                </select>
              </div>
              <div class="dm-form-group">
                <label>Foco Vertical:</label>
                <select class="dm-select dm-input--compact" id="dm-edit-domain-pos">
                  <option value="center" {{#if (eq selectedDomain.imagePosition 'center')}}selected{{/if}}>Centro</option>
                  <option value="top" {{#if (eq selectedDomain.imagePosition 'top')}}selected{{/if}}>Topo</option>
                  <option value="bottom" {{#if (eq selectedDomain.imagePosition 'bottom')}}selected{{/if}}>Base</option>
                </select>
              </div>
            </div>

            {{#if selectedDomain.image}}
              <div class="dm-image-preview-container {{#if (eq selectedDomain.imageFit 'contain')}}is-contain{{/if}} mt-1">
                <img src="{{selectedDomain.image}}" class="dm-image-preview-rect" alt="Prévia" onerror="this.style.display='none'" />
              </div>
            {{/if}}
          </div>

          <!-- MÚLTIPLAS IMAGENS / GALERIA DA BASE -->
          <div class="dm-form-group">
            <label><i class="fa-solid fa-images text-blue"></i> Galeria de Imagens da Base (Múltiplas Fotos/Conceitos):</label>
            {{#if selectedDomain.gallery.length}}
              <div class="dm-gallery-chips">
                {{#each selectedDomain.gallery}}
                  <div class="dm-gallery-chip">
                    <img src="{{this}}" class="dm-gallery-chip__thumb" alt="Foto {{@index}}" />
                    <button type="button" class="dm-icon-btn dm-icon-btn--xs" data-action="removeGalleryImage" data-src="{{this}}" title="Remover da galeria">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            {{/if}}
            <div class="dm-file-input-group mt-1">
              <input type="text" class="dm-input dm-input--compact" id="dm-new-gallery-img" placeholder="URL ou arquivo de mais uma foto..." />
              <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="openFilePicker" data-target="#dm-new-gallery-img">
                <i class="fa-solid fa-file-import"></i> Arquivo
              </button>
              <button type="button" class="dm-btn dm-btn--primary dm-btn--xs" data-action="addGalleryImage" title="Adicionar à Galeria">
                <i class="fa-solid fa-plus"></i> Adicionar Foto
              </button>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Jogadores Controladores / Donos:</label>
            <div class="dm-player-list">
              {{#if worldPlayers.length}}
                {{#each worldPlayers}}
                  <label class="dm-player-checkbox">
                    <input type="checkbox" class="dm-edit-domain-controller" value="{{id}}" {{#if isSelected}}checked{{/if}} />
                    <span>{{name}}</span>
                  </label>
                {{/each}}
              {{else}}
                <span class="dm-text-muted">Nenhum jogador cadastrado.</span>
              {{/if}}
            </div>
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Defesa Base</label>
              <input type="number" class="dm-input dm-input--compact" id="dm-edit-domain-defense" value="{{selectedDomain.defenseScore}}" />
            </div>
            <div class="dm-form-group">
              <label>Guardas</label>
              <input type="number" class="dm-input dm-input--compact" id="dm-edit-domain-guards" value="{{selectedDomain.guardCount}}" />
            </div>
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Tags (vírgula)</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-edit-domain-tags" value="{{selectedDomainTagsFormatted}}" />
            </div>
            <div class="dm-form-group">
              <label>Domínio Superior (Hierarquia)</label>
              <select class="dm-select dm-input--compact" id="dm-edit-domain-parent">
                <option value="">Nenhum (Raiz / Independente)</option>
                {{#each availableParentDomains}}
                  <option value="{{uuid}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <!-- SUSTENTO DA POPULAÇÃO & DESPESAS GERAIS -->
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label><i class="fa-solid fa-wheat-awn text-amber"></i> Sustento Automático:</label>
              <select class="dm-select dm-input--compact" id="dm-edit-domain-sustenance-enabled">
                <option value="true" {{#if selectedDomain.sustenanceEnabled}}selected{{/if}}>Ativado (Consome Recursos)</option>
                <option value="false" {{#unless selectedDomain.sustenanceEnabled}}selected{{/unless}}>Desativado (Sem Consumo)</option>
              </select>
            </div>
            <div class="dm-form-group">
              <label>Manutenção de Guarda (Créditos/tick):</label>
              <input type="number" step="0.1" min="0" class="dm-input dm-input--compact" id="dm-edit-domain-guard-upkeep" value="{{selectedDomain.guardUpkeepRate}}" />
            </div>
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Comida por 100 hab / tick:</label>
              <input type="number" step="0.1" min="0" class="dm-input dm-input--compact" id="dm-edit-domain-food-rate" value="{{selectedDomain.foodPer100}}" />
            </div>
            <div class="dm-form-group">
              <label>Água por 100 hab / tick:</label>
              <input type="number" step="0.1" min="0" class="dm-input dm-input--compact" id="dm-edit-domain-water-rate" value="{{selectedDomain.waterPer100}}" />
            </div>
          </div>

          <div class="dm-form-group">
            <label>Descrição Geral</label>
            <textarea class="dm-textarea dm-input--compact" id="dm-edit-domain-description" rows="2">{{selectedDomain.description}}</textarea>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelEditDomain">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitEditDomain"><i class="fa-solid fa-floppy-disk"></i> Salvar Alterações</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 5. MODAL: AVANÇAR TEMPO -->
{{#if isAdvancingTimeModal}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-clock-rotate-left text-blue"></i> Avançar Tempo do Mundo</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelAdvanceModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc">Simula a economia, obras, acordos e condições de todos os domínios.</p>
        <div class="dm-advance-options mt-2">
          <div class="dm-pill-row">
            <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="quickAdvanceTicks" data-ticks="1">+1 Dia (1 Tick)</button>
            <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="quickAdvanceTicks" data-ticks="7">+1 Semana (7)</button>
            <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="quickAdvanceTicks" data-ticks="30">+1 Mês (30)</button>
          </div>
          <div class="dm-form-group mt-2">
            <label>Quantidade de Ticks:</label>
            <input type="number" class="dm-input dm-input--compact" id="dm-advance-ticks-input" min="1" max="1000" value="{{advanceCustomTicks}}" />
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelAdvanceModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitAdvance"><i class="fa-solid fa-forward-step"></i> Avançar</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 6. MODAL: EVENTOS -->
{{#if isEventModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-large">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-dice-d20 text-purple"></i> Central de Eventos de Domínio</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelEventModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-event-split">
          <div class="dm-event-col">
            <h4 class="dm-event-col__title"><i class="fa-solid fa-dice"></i> Sorteio com Filtros</h4>
            <div class="dm-form-group">
              <label>Filtrar Categoria:</label>
              <select class="dm-select dm-input--compact" id="dm-event-filter-category">
                <option value="all">Todas as Categorias</option>
                <option value="economy">Economia & Comércio</option>
                <option value="security">Segurança & Conflito</option>
                <option value="population">Social & População</option>
                <option value="crisis">Crise & Desastre</option>
                <option value="opportunity">Oportunidade & Bonança</option>
              </select>
            </div>
            <button type="button" class="dm-btn dm-btn--primary mt-2 w-full" data-action="submitCustomRollEvent">
              <i class="fa-solid fa-dice-d20"></i> Rolar com Filtro
            </button>
          </div>
          <div class="dm-event-divider"></div>
          <div class="dm-event-col">
            <h4 class="dm-event-col__title"><i class="fa-solid fa-feather"></i> Evento Autoral do Mestre</h4>
            <div class="dm-form-group">
              <label>Título do Evento:</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-author-event-title" placeholder="Chuva de Meteoros..." />
            </div>
            <div class="dm-form-group">
              <label>Descrição:</label>
              <textarea class="dm-textarea dm-input--compact" id="dm-author-event-desc" rows="2"></textarea>
            </div>
            <div class="dm-form-row">
              <div class="dm-form-group">
                <label>Severidade:</label>
                <select class="dm-select dm-input--compact" id="dm-author-event-severity">
                  <option value="neutral">Neutra</option>
                  <option value="crisis">Crise</option>
                  <option value="opportunity">Oportunidade</option>
                </select>
              </div>
              <div class="dm-form-group">
                <label>Impacto Tesouro:</label>
                <input type="number" class="dm-input dm-input--compact" id="dm-author-event-stock" value="0" />
              </div>
            </div>
            <button type="button" class="dm-btn dm-btn--outline mt-2 w-full" data-action="submitAuthorEvent">
              <i class="fa-solid fa-check"></i> Aplicar Evento
            </button>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelEventModal">Fechar</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 7. MODAL: ADICIONAR ESTOQUE -->
{{#if isStockModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-cubes-stacked text-amber"></i> Adicionar / Ajustar Estoque</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelStockModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Recurso Existente:</label>
            <select class="dm-select dm-input--compact" id="dm-stock-resource-select">
              <option value="">-- Ou digite um novo recurso abaixo --</option>
              {{#each catalogResources}}
                <option value="{{id}}">{{name}} ({{id}})</option>
              {{/each}}
            </select>
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>ID do Recurso (novo):</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-stock-resource-custom" placeholder="ore, food..." />
            </div>
            <div class="dm-form-group">
              <label>Nome Amigável:</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-stock-resource-name" placeholder="Minério..." />
            </div>
          </div>
          <div class="dm-form-group">
            <label>Saldo Total:</label>
            <input type="number" class="dm-input dm-input--compact" id="dm-stock-amount" value="100" />
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelStockModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitStock"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 8. MODAL: ADICIONAR FLUXO -->
{{#if isFlowModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-arrow-right-arrow-left text-blue"></i> Adicionar Fluxo Econômico</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelFlowModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Descrição do Fluxo:</label>
            <input type="text" class="dm-input dm-input--compact" id="dm-flow-name" placeholder="Rota Comercial, Impostos..." />
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Recurso:</label>
              <select class="dm-select dm-input--compact" id="dm-flow-resource">
                {{#each catalogResources}}
                  <option value="{{id}}">{{name}}</option>
                {{/each}}
              </select>
            </div>
            <div class="dm-form-group">
              <label>Direção:</label>
              <select class="dm-select dm-input--compact" id="dm-flow-direction">
