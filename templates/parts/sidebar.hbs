<aside class="dm-sidebar {{#unless isSidebarOpen}}is-collapsed{{/unless}}" aria-label="Explorador de Domínios">
  <header class="dm-sidebar__header">
    <div class="dm-sidebar__title-row">
      <h2 class="dm-sidebar__title">{{localize 'DOMAIN_MANAGER.Sidebar.Title'}}</h2>
      <div class="dm-sidebar__header-actions">
        <button
          type="button"
          class="dm-icon-btn"
          data-action="toggleAllFolders"
          title="{{#if allFoldersCollapsed}}Expandir Todas as Pastas{{else}}Recolher Todas as Pastas{{/if}}"
        >
          <i class="fa-solid {{#if allFoldersCollapsed}}fa-folder-closed{{else}}fa-folder-open{{/if}}"></i>
        </button>

        {{#if isGM}}
          <button
            type="button"
            class="dm-icon-btn dm-icon-btn--primary"
            data-action="openCreateDomain"
            title="{{localize 'DOMAIN_MANAGER.Sidebar.NewDomain'}}"
            aria-label="{{localize 'DOMAIN_MANAGER.Sidebar.NewDomain'}}"
          >
            <i class="fa-solid fa-plus"></i>
          </button>
        {{/if}}

        <button
          type="button"
          class="dm-icon-btn"
          data-action="toggleSidebar"
          title="Recolher Painel Lateral"
          aria-label="Recolher Painel Lateral"
        >
          <i class="fa-solid fa-chevron-left"></i>
        </button>
      </div>
    </div>

    <div class="dm-search">
      <i class="fa-solid fa-magnifying-glass dm-search__icon"></i>
      <input
        type="search"
        class="dm-search__input"
        placeholder="{{localize 'DOMAIN_MANAGER.SearchPlaceholder'}}"
        value="{{searchQuery}}"
        data-action="search"
      />
    </div>

    <div class="dm-switcher" role="tablist">
      <button
        type="button"
        class="dm-switcher__btn {{#if (eq sidebarMode 'hierarchy')}}is-active{{/if}}"
        data-action="setSidebarMode"
        data-mode="hierarchy"
      >
        {{localize 'DOMAIN_MANAGER.Sidebar.Folders'}}
      </button>
      <button
        type="button"
        class="dm-switcher__btn {{#if (eq sidebarMode 'tags')}}is-active{{/if}}"
        data-action="setSidebarMode"
        data-mode="tags"
      >
        {{localize 'DOMAIN_MANAGER.Sidebar.Tags'}}
      </button>
    </div>
  </header>

  <div class="dm-sidebar__content dm-scrollable">
    {{#if (eq sidebarMode 'tags')}}
      {{#if isGM}}
        <div class="dm-sidebar__tag-actions">
          <button type="button" class="dm-btn dm-btn--outline dm-btn--xs w-full" data-action="openAddTagModal">
            <i class="fa-solid fa-plus"></i> Adicionar Nova Tag
          </button>
        </div>
      {{/if}}

      {{#if tagGroups.length}}
        <ul class="dm-tag-list">
          {{#each tagGroups}}
            <li class="dm-tag-item">
              <button
                type="button"
                class="dm-tag-btn {{#if isSelected}}is-active{{/if}}"
                data-action="filterByTag"
                data-tag="{{tag}}"
              >
                <i class="fa-solid fa-tag dm-tag-icon"></i>
                <span class="dm-tag-label">#{{tag}}</span>
                <span class="dm-tree__badge">{{count}}</span>
              </button>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="dm-empty-state">Nenhuma tag cadastrada.</p>
      {{/if}}
    {{else}}
      {{#if flatDomainTree.length}}
        <ul class="dm-tree">
          {{#each flatDomainTree}}
            <li class="dm-tree__node {{#if isSelected}}is-selected{{/if}} depth-{{depth}}" style="padding-left: {{indentPx}}px;">
              <div class="dm-tree__item-row">
                {{#if hasChildren}}
                  <button
                    type="button"
                    class="dm-tree__expander"
                    data-action="toggleFolder"
                    data-uuid="{{uuid}}"
                    title="{{#if isCollapsed}}Expandir pasta{{else}}Recolher pasta{{/if}}"
                  >
                    <i class="fa-solid {{#if isCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                  </button>
                {{else}}
                  <span class="dm-tree__expander-spacer"></span>
                {{/if}}

                <button
                  type="button"
                  class="dm-tree__item {{#if isSelected}}is-active{{/if}}"
                  data-action="selectDomain"
                  data-uuid="{{uuid}}"
                >
                  {{#if isImageCrest}}
                    <img src="{{icon}}" class="dm-tree__img" alt="" />
                  {{else}}
                    <i class="dm-tree__icon {{icon}}"></i>
                  {{/if}}
                  <span class="dm-tree__label" title="{{name}}">{{name}}</span>
                  {{#if childCount}}
                    <span class="dm-tree__badge" data-action="toggleFolder" data-uuid="{{uuid}}" title="{{childCount}} subdivisões">{{childCount}}</span>
                  {{/if}}
                </button>
              </div>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <div class="dm-empty-state">
          <i class="fa-solid fa-sitemap dm-empty-state__icon"></i>
          <p>{{localize 'DOMAIN_MANAGER.NoDomains'}}</p>
        </div>
      {{/if}}
    {{/if}}
  </div>
</aside>
