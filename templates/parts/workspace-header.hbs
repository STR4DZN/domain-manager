<header class="dm-workspace-header">
  <div class="dm-workspace-header__main">
    {{#if breadcrumbs.length}}
      <nav class="dm-breadcrumbs" aria-label="Caminho Hierárquico">
        {{#each breadcrumbs}}
          <span class="dm-breadcrumbs__item" data-action="selectDomain" data-uuid="{{uuid}}" title="{{name}}">{{name}}</span>
          {{#unless @last}}<span class="dm-breadcrumbs__separator">/</span>{{/unless}}
        {{/each}}
      </nav>
    {{/if}}

    {{#if selectedDomain}}
      <div class="dm-workspace-header__identity">
        <div class="dm-crest">
          <i class="{{selectedDomain.crest}} dm-crest__icon"></i>
        </div>
        <div class="dm-workspace-header__titles">
          <div class="dm-workspace-header__title-row">
            <h1 class="dm-workspace-header__title">{{selectedDomain.name}}</h1>
            <span class="dm-pill dm-pill--category">{{selectedDomain.category}}</span>
            <span class="dm-pill dm-pill--nature">{{selectedDomain.nature}}</span>
            <span class="dm-badge dm-badge--{{selectedDomain.state}}">{{selectedDomain.state}}</span>
          </div>
          <div class="dm-workspace-header__tags">
            {{#each selectedDomain.tags}}
              <span class="dm-tag-chip">
                #{{this}}
                {{#if @root.isGM}}
                  <button type="button" class="dm-tag-chip__del" data-action="removeTag" data-tag="{{this}}" title="Excluir tag #{{this}}">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                {{/if}}
              </span>
            {{/each}}
            {{#if isGM}}
              <button type="button" class="dm-tag-chip dm-tag-chip--add" data-action="openAddTagModal" title="Adicionar nova tag">
                <i class="fa-solid fa-plus"></i> Adicionar Tag
              </button>
            {{/if}}
          </div>
        </div>
      </div>
    {{else}}
      <div class="dm-workspace-header__identity">
        <h1 class="dm-workspace-header__title">{{localize 'DOMAIN_MANAGER.AllDomains'}}</h1>
        <p class="dm-workspace-header__subtitle">Visão Consolidada do Território</p>
      </div>
    {{/if}}
  </div>

  <div class="dm-workspace-header__actions">
    {{#if isGM}}
      {{#if selectedDomain}}
        <button
          type="button"
          class="dm-btn dm-btn--outline"
          data-action="openEditDomain"
          title="Editar identidade deste Domínio"
        >
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Editar</span>
        </button>

        <button
          type="button"
          class="dm-btn dm-btn--danger"
          data-action="openDeleteDomainModal"
          title="Excluir permanentemente este Domínio"
        >
          <i class="fa-solid fa-trash-can"></i>
          <span>Excluir</span>
        </button>
      {{/if}}

      <button
        type="button"
        class="dm-btn dm-btn--outline"
        data-action="openEventModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
      >
        <i class="fa-solid fa-dice-d20"></i>
        <span>{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}</span>
      </button>

      <button
        type="button"
        class="dm-btn dm-btn--primary"
        data-action="openAdvanceModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
      >
        <i class="fa-solid fa-forward-step"></i>
        <span>{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}</span>
      </button>
    {{/if}}
  </div>
</header>
