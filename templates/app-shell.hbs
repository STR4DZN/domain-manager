                {{/each}}
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Descrição Geral</label>
            <textarea class="dm-textarea" id="dm-edit-domain-description" rows="2">{{selectedDomain.description}}</textarea>
          </div>
