          </div>
        {{/if}}

        <!-- PAINEL DE NOTIFICAÇÕES & AVISOS IMPORTANTES -->
        <div class="dm-notifications-feed">
          <div class="dm-notifications-feed__header">
            <div class="dm-notifications-feed__title-group">
              <i class="fa-solid fa-bell dm-notifications-feed__bell {{#if unreadNotificationsCount}}has-unread{{/if}}"></i>
              <h3 class="dm-notifications-feed__title">Avisos & Notificações Importantes</h3>
              {{#if unreadNotificationsCount}}
                <span class="dm-notifications-feed__count-badge">{{unreadNotificationsCount}} PENDENTE{{#if (gt unreadNotificationsCount 1)}}S{{/if}}</span>
              {{/if}}
            </div>
            <div class="dm-notifications-feed__controls">
              {{#if unreadNotificationsCount}}
                <button type="button" class="dm-btn dm-btn--ghost dm-btn--xs" data-action="dismissAllNotifications" title="Marcar todos os avisos como vistos">
                  <i class="fa-solid fa-check-double"></i>
                  <span>Marcar Todos Como Vistos</span>
                </button>
              {{/if}}
              {{#if allNotifications.length}}
                <button type="button" class="dm-btn dm-btn--outline dm-btn--xs" data-action="toggleNotificationsHistory" title="Alternar histórico de avisos">
                  <i class="fa-solid fa-clock-rotate-left"></i>
                  <span>{{#if showNotificationsHistory}}Ocultar Histórico{{else}}Histórico ({{allNotifications.length}}){{/if}}</span>
                </button>
              {{/if}}
              {{#if isGM}}
                <button type="button" class="dm-btn dm-btn--primary dm-btn--xs" data-action="openAddNotificationModal" title="Emitir aviso oficial do GM para os jogadores">
                  <i class="fa-solid fa-bullhorn"></i>
                  <span>Novo Aviso</span>
                </button>
              {{/if}}
            </div>
          </div>

          <!-- Lista de Notificações Ativas Não Lidas -->
          {{#if unreadNotifications.length}}
            <div class="dm-notifications-list">
              {{#each unreadNotifications}}
                <div class="dm-notification-card is-{{this.severity}}">
                  <div class="dm-notification-card__icon">
                    <i class="{{this.icon}}"></i>
                  </div>
                  <div class="dm-notification-card__body">
                    <div class="dm-notification-card__header-row">
                      <strong class="dm-notification-card__item-title">{{this.title}}</strong>
                      <span class="dm-notification-card__timestamp">{{this.timeFormatted}}</span>
                    </div>
                    {{#if this.message}}
                      <p class="dm-notification-card__msg">{{this.message}}</p>
                    {{/if}}
                    <div class="dm-notification-card__footer">
                      {{#if (ne this.targetTab 'overview')}}
                        <button type="button" class="dm-notification-card__goto-btn" data-action="switchTab" data-tab="{{this.targetTab}}">
                          <span>Acessar {{this.targetTabLabel}}</span>
                          <i class="fa-solid fa-arrow-right"></i>
                        </button>
                      {{/if}}
                    </div>
                  </div>
                  <div class="dm-notification-card__actions">
                    <button type="button" class="dm-notification-card__btn-seen" data-action="dismissNotification" data-local-id="{{this.localId}}" title="Marcar como visto (remover pendência)">
                      <i class="fa-solid fa-check"></i>
                      <span>Visto</span>
                    </button>
                    {{#if @root.isGM}}
                      <button type="button" class="dm-notification-card__btn-del" data-action="deleteNotification" data-local-id="{{this.localId}}" title="Excluir notificação">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="dm-notifications-empty">
              <i class="fa-solid fa-circle-check dm-notifications-empty__icon"></i>
              <div class="dm-notifications-empty__text">
                <strong>Tudo em ordem neste domínio!</strong>
                <span>Nenhum aviso urgente ou pendência ativa aguardando leitura.</span>
              </div>
            </div>
          {{/if}}

          <!-- Histórico Completo de Notificações -->
          {{#if showNotificationsHistory}}
            <div class="dm-notifications-history">
              <h4 class="dm-notifications-history__title"><i class="fa-solid fa-timeline"></i> Registros de Notificações Anteriores</h4>
              <div class="dm-notifications-history__list">
                {{#each allNotifications}}
                  <div class="dm-notification-card is-history {{#if this.isRead}}is-read{{/if}}">
                    <div class="dm-notification-card__icon"><i class="{{this.icon}}"></i></div>
                    <div class="dm-notification-card__body">
                      <div class="dm-notification-card__header-row">
                        <strong>{{this.title}}</strong>
                        <span class="dm-notification-card__timestamp">{{this.timeFormatted}}</span>
                      </div>
                      <p class="dm-notification-card__msg">{{this.message}}</p>
                    </div>
                    {{#if @root.isGM}}
                      <div class="dm-notification-card__actions">
                        <button type="button" class="dm-notification-card__btn-del" data-action="deleteNotification" data-local-id="{{this.localId}}" title="Excluir notificação">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}
        </div>

