<div class="dm-shell" data-domain-manager-shell data-section="{{activeSection}}">
  <div class="dm-shell__layout">
    <nav class="dm-rail" aria-label="Navegação Global">
  <div class="dm-rail__brand" title="{{localize 'DOMAIN_MANAGER.Title'}}">
    <i class="fa-solid fa-sitemap dm-rail__logo"></i>
  </div>

  <div class="dm-rail__nav">
    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'dashboard')}}is-active{{/if}}"
      data-action="navigate"
      data-section="dashboard"
      title="{{localize 'DOMAIN_MANAGER.Tabs.Overview'}}"
      aria-label="{{localize 'DOMAIN_MANAGER.Tabs.Overview'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-chart-pie"></i>
    </button>

    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'domains')}}{{#if isSidebarOpen}}is-active{{/if}}{{/if}}"
      data-action="navigate"
      data-section="domains"
      title="Abrir / Recolher Painel Lateral de Bases"
      aria-label="{{localize 'DOMAIN_MANAGER.Sidebar.Title'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-layer-group"></i>
    </button>

    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'economy')}}is-active{{/if}}"
      data-action="navigate"
      data-section="economy"
      title="{{localize 'DOMAIN_MANAGER.Tabs.Economy'}}"
      aria-label="{{localize 'DOMAIN_MANAGER.Tabs.Economy'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-coins"></i>
    </button>

    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'projects')}}is-active{{/if}}"
      data-action="navigate"
      data-section="projects"
      title="{{localize 'DOMAIN_MANAGER.Tabs.Projects'}}"
      aria-label="{{localize 'DOMAIN_MANAGER.Tabs.Projects'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-trowel-bricks"></i>
    </button>

    {{#if isGM}}
      <button
        type="button"
        class="dm-rail__item"
        data-action="openAdvanceModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
        aria-label="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
      >
        <span class="dm-rail__indicator"></span>
        <i class="fa-solid fa-clock-rotate-left"></i>
      </button>

      <button
        type="button"
        class="dm-rail__item"
        data-action="openEventModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
        aria-label="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
      >
        <span class="dm-rail__indicator"></span>
        <i class="fa-solid fa-dice-d20"></i>
      </button>
    {{/if}}
  </div>
</nav>


    <div class="dm-shell__body">
      <aside class="dm-sidebar {{#unless isSidebarOpen}}is-collapsed{{/unless}}" aria-label="Explorador de Domínios">
  <header class="dm-sidebar__header">
    <div class="dm-sidebar__title-row">
      <h2 class="dm-sidebar__title">{{localize 'DOMAIN_MANAGER.Sidebar.Title'}}</h2>
      <div class="dm-sidebar__header-actions">
        <button
          type="button"
          class="dm-icon-btn"
          data-action="toggleAllFolders"
          title="{{#if allFoldersCollapsed}}Expandir Todas as Pastas{{else}}Recolher Todas as Pastas{{/if}}"
        >
          <i class="fa-solid {{#if allFoldersCollapsed}}fa-folder-closed{{else}}fa-folder-open{{/if}}"></i>
        </button>

        {{#if isGM}}
          <button
            type="button"
            class="dm-icon-btn dm-icon-btn--primary"
            data-action="openCreateDomain"
            title="{{localize 'DOMAIN_MANAGER.Sidebar.NewDomain'}}"
            aria-label="{{localize 'DOMAIN_MANAGER.Sidebar.NewDomain'}}"
          >
            <i class="fa-solid fa-plus"></i>
          </button>
        {{/if}}

        <button
          type="button"
          class="dm-icon-btn"
          data-action="toggleSidebar"
          title="Recolher Painel Lateral"
          aria-label="Recolher Painel Lateral"
        >
          <i class="fa-solid fa-chevron-left"></i>
        </button>
      </div>
    </div>

    <div class="dm-search">
      <i class="fa-solid fa-magnifying-glass dm-search__icon"></i>
      <input
        type="search"
        class="dm-search__input"
        placeholder="{{localize 'DOMAIN_MANAGER.SearchPlaceholder'}}"
        value="{{searchQuery}}"
        data-action="search"
      />
    </div>

    <div class="dm-switcher" role="tablist">
      <button
        type="button"
        class="dm-switcher__btn {{#if (eq sidebarMode 'hierarchy')}}is-active{{/if}}"
        data-action="setSidebarMode"
        data-mode="hierarchy"
      >
        {{localize 'DOMAIN_MANAGER.Sidebar.Folders'}}
      </button>
      <button
        type="button"
        class="dm-switcher__btn {{#if (eq sidebarMode 'tags')}}is-active{{/if}}"
        data-action="setSidebarMode"
        data-mode="tags"
      >
        {{localize 'DOMAIN_MANAGER.Sidebar.Tags'}}
      </button>
    </div>
  </header>

  <div class="dm-sidebar__content dm-scrollable">
    {{#if (eq sidebarMode 'tags')}}
      {{#if isGM}}
        <div class="dm-sidebar__tag-actions">
          <button type="button" class="dm-btn dm-btn--outline dm-btn--xs w-full" data-action="openAddTagModal">
            <i class="fa-solid fa-plus"></i> Adicionar Nova Tag
          </button>
        </div>
      {{/if}}

      {{#if tagGroups.length}}
        <ul class="dm-tag-list">
          {{#each tagGroups}}
            <li class="dm-tag-item">
              <button
                type="button"
                class="dm-tag-btn {{#if isSelected}}is-active{{/if}}"
                data-action="filterByTag"
                data-tag="{{tag}}"
              >
                <i class="fa-solid fa-tag dm-tag-icon"></i>
                <span class="dm-tag-label">#{{tag}}</span>
                <span class="dm-tree__badge">{{count}}</span>
              </button>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="dm-empty-state">Nenhuma tag cadastrada.</p>
      {{/if}}
    {{else}}
      {{#if flatDomainTree.length}}
        <ul class="dm-tree">
          {{#each flatDomainTree}}
            <li class="dm-tree__node {{#if isSelected}}is-selected{{/if}} depth-{{depth}}" style="padding-left: {{indentPx}}px;">
              <div class="dm-tree__item-row">
                {{#if hasChildren}}
                  <button
                    type="button"
                    class="dm-tree__expander"
                    data-action="toggleFolder"
                    data-uuid="{{uuid}}"
                    title="{{#if isCollapsed}}Expandir pasta{{else}}Recolher pasta{{/if}}"
                  >
                    <i class="fa-solid {{#if isCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                  </button>
                {{else}}
                  <span class="dm-tree__expander-spacer"></span>
                {{/if}}

                <button
                  type="button"
                  class="dm-tree__item {{#if isSelected}}is-active{{/if}}"
                  data-action="selectDomain"
                  data-uuid="{{uuid}}"
                >
                  {{#if isImageCrest}}
                    <img src="{{icon}}" class="dm-tree__img" alt="" />
                  {{else}}
                    <i class="dm-tree__icon {{icon}}"></i>
                  {{/if}}
                  <span class="dm-tree__label" title="{{name}}">{{name}}</span>
                  {{#if childCount}}
                    <span class="dm-tree__badge" data-action="toggleFolder" data-uuid="{{uuid}}" title="{{childCount}} subdivisões">{{childCount}}</span>
                  {{/if}}
                </button>
              </div>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <div class="dm-empty-state">
          <i class="fa-solid fa-sitemap dm-empty-state__icon"></i>
          <p>{{localize 'DOMAIN_MANAGER.NoDomains'}}</p>
        </div>
      {{/if}}
    {{/if}}
  </div>
</aside>


      <main class="dm-shell__main">
        <header class="dm-workspace-header">
  <div class="dm-workspace-header__main">
    {{#if breadcrumbs.length}}
      <nav class="dm-breadcrumbs" aria-label="Caminho Hierárquico">
        {{#each breadcrumbs}}
          <span class="dm-breadcrumbs__item" data-action="selectDomain" data-uuid="{{uuid}}" title="{{name}}">{{name}}</span>
          {{#unless @last}}<span class="dm-breadcrumbs__separator">/</span>{{/unless}}
        {{/each}}
      </nav>
    {{/if}}

    {{#if selectedDomain}}
      <div class="dm-workspace-header__identity">
        {{#if selectedDomain.hasImage}}
          <img src="{{selectedDomain.image}}" class="dm-base-thumb" alt="{{selectedDomain.name}}" />
        {{else}}
          <div class="dm-base-thumb dm-base-thumb--empty">
            <i class="fa-solid fa-mountain-sun"></i>
          </div>
        {{/if}}

        <div class="dm-workspace-header__titles">
          <div class="dm-workspace-header__title-row">
            <h1 class="dm-workspace-header__title">{{selectedDomain.name}}</h1>
            <span class="dm-pill dm-pill--category">{{selectedDomain.categoryLabel}}</span>
            <span class="dm-pill dm-pill--nature">{{selectedDomain.natureLabel}}</span>
            <span class="dm-badge dm-badge--{{selectedDomain.state}}">{{selectedDomain.stateLabel}}</span>
          </div>

          {{#if selectedDomain.tags.length}}
            <div class="dm-workspace-header__tags">
              {{#each selectedDomain.tags}}
                <span class="dm-tag-chip">
                  #{{this}}
                  {{#if @root.isGM}}
                    <button type="button" class="dm-tag-chip__del" data-action="removeTag" data-tag="{{this}}" title="Remover tag #{{this}}">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  {{/if}}
                </span>
              {{/each}}
            </div>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div class="dm-workspace-header__identity">
        <h1 class="dm-workspace-header__title">{{localize 'DOMAIN_MANAGER.AllDomains'}}</h1>
        <p class="dm-workspace-header__subtitle">Visão Consolidada do Território</p>
      </div>
    {{/if}}
  </div>

  <div class="dm-workspace-header__actions">
    {{#if isGM}}
      {{#if selectedDomain}}
        <button
          type="button"
          class="dm-btn dm-btn--outline"
          data-action="openEditDomain"
          title="Editar identidade deste Domínio"
        >
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Editar</span>
        </button>

        <button
          type="button"
          class="dm-btn dm-btn--danger"
          data-action="openDeleteDomainModal"
          title="Excluir permanentemente este Domínio"
        >
          <i class="fa-solid fa-trash-can"></i>
          <span>Excluir</span>
        </button>
      {{/if}}

      <button
        type="button"
        class="dm-btn dm-btn--outline"
        data-action="openEventModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
      >
        <i class="fa-solid fa-dice-d20"></i>
        <span>{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}</span>
      </button>

      <button
        type="button"
        class="dm-btn dm-btn--primary"
        data-action="openAdvanceModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
      >
        <i class="fa-solid fa-forward-step"></i>
        <span>{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}</span>
      </button>
    {{/if}}
  </div>
</header>

        <section class="dm-overview-cards" aria-label="Métricas Gerais">
  <!-- Card 1: Economia -->
  <article class="dm-card dm-card--stat">
    <div class="dm-card__header">
      <span class="dm-card__title">{{localize 'DOMAIN_MANAGER.Metrics.Treasury'}}</span>
      <i class="fa-solid fa-coins dm-card__icon text-amber"></i>
    </div>
    <div class="dm-card__value">{{metrics.primaryStockDisplay}}</div>
    <div class="dm-card__footer">
      <span class="dm-rate dm-rate--{{metrics.netDirection}}">
        {{metrics.netRateDisplay}}/tick
      </span>
      {{#if metrics.runwayDisplay}}
        <span class="dm-card__subtext">· {{metrics.runwayDisplay}}</span>
      {{/if}}
    </div>
  </article>

  <!-- Card 2: Segurança & Defesa -->
  <article class="dm-card dm-card--stat">
    <div class="dm-card__header">
      <span class="dm-card__title">{{localize 'DOMAIN_MANAGER.Metrics.Security'}}</span>
      <i class="fa-solid fa-shield-halved dm-card__icon text-blue"></i>
    </div>
    <div class="dm-card__value">{{metrics.defenseRating}} DEF</div>
    <div class="dm-card__footer">
      <span class="dm-card__subtext">{{metrics.guardCount}} guardas</span>
      <span class="dm-badge dm-badge--risk is-{{metrics.unrestRiskLevel}}">
        {{metrics.unrestRiskPercent}}% agitação
      </span>
    </div>
  </article>

  <!-- Card 3: População -->
  <article class="dm-card dm-card--stat">
    <div class="dm-card__header">
      <span class="dm-card__title">{{localize 'DOMAIN_MANAGER.Metrics.Population'}}</span>
      <i class="fa-solid fa-users dm-card__icon text-emerald"></i>
    </div>
    <div class="dm-card__value">{{metrics.populationTotal}}</div>
    <div class="dm-card__footer">
      <span class="dm-card__subtext">{{metrics.groupCount}} grupos</span>
      <span class="dm-card__subtext">· {{metrics.notableCount}} notáveis</span>
    </div>
  </article>

  <!-- Card 4: Obras & Construções -->
  <article class="dm-card dm-card--stat">
    <div class="dm-card__header">
      <span class="dm-card__title">{{localize 'DOMAIN_MANAGER.Metrics.Projects'}}</span>
      <i class="fa-solid fa-trowel-bricks dm-card__icon text-indigo"></i>
    </div>
    <div class="dm-card__value">{{metrics.activeProjectsCount}} ativas</div>
    <div class="dm-card__footer">
      <div class="dm-mini-progress" title="{{metrics.averageProjectProgress}}% concluído">
        <div class="dm-mini-progress__bar" style="width: {{metrics.averageProjectProgress}}%;"></div>
      </div>
      <span class="dm-card__subtext">{{metrics.averageProjectProgress}}%</span>
    </div>
  </article>
</section>
        <!-- MODAIS IN-PAGE COM ARQUITETURA COMPACTA E SCROLL INTERNO -->

{{#if isTagModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-tag text-emerald"></i> Adicionar Tags ao Domínio</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelTagModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc">Digite uma ou mais tags separadas por vírgula para categorizar este domínio.</p>
        <div class="dm-form-group mt-2">
          <label>Novas Tags (separadas por vírgula):</label>
          <input type="text" class="dm-input" id="dm-new-tag-input" placeholder="Ex: capital, mineração, setor-3, estratégico" autofocus />
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelTagModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitAddTag"><i class="fa-solid fa-check"></i> Adicionar Tags</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if isDeletingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-dialog-card--danger dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-triangle-exclamation text-rose"></i> Confirmar Exclusão do Domínio</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelDeleteDomainModal" title="Fechar"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc font-semibold text-rose">
          Tem certeza que deseja excluir o domínio "<strong>{{selectedDomain.name}}</strong>"?
        </p>
        <p class="dm-dialog-desc mt-2">
          Esta ação é <strong>irreversível</strong> e só pode ser executada pelo Mestre. Se este domínio possuir subdivisões ou bases subordinadas, elas serão desvinculadas automaticamente para a raiz territorial para evitar perda de dados.
        </p>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelDeleteDomainModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--danger-fill" data-action="confirmDeleteDomain">
          <i class="fa-solid fa-trash-can"></i> Sim, Excluir Domínio
        </button>
      </div>
    </div>
  </div>
{{/if}}

{{#if isCreatingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-large">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-plus-circle text-emerald"></i> Criar Novo Domínio / Base</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelCreateDomain" title="Fechar"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc">Defina a identidade, imagem da base, jogadores controladores e hierarquia.</p>
        
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Nome do Domínio / Base *</label>
            <input type="text" class="dm-input" id="dm-new-domain-name" placeholder="Ex: Base Alpha, Forte Solar, Cidade Baixa..." autofocus />
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Categoria (Customizável)</label>
              <input type="text" class="dm-input" id="dm-new-domain-category" placeholder="Ex: settlement, outpost, planet, galaxy..." value="settlement" />
            </div>
            <div class="dm-form-group">
              <label>Natureza</label>
              <select class="dm-select" id="dm-new-domain-nature">
                <option value="physical">Físico / Territorial</option>
                <option value="organization">Organização / Guilda</option>
                <option value="hybrid">Híbrido</option>
                <option value="abstract">Esfera Abstrata</option>
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Imagem / Ilustração da Base (Arquivo ou Link URL):</label>
            <div class="dm-file-input-group">
              <input type="text" class="dm-input dm-img-input" id="dm-new-domain-crest" placeholder="caminho/imagem.webp ou https://.../imagem.png" />
              <button type="button" class="dm-btn dm-btn--outline dm-btn--sm" data-action="openFilePicker" data-target="#dm-new-domain-crest">
                <i class="fa-solid fa-file-import"></i> Arquivo
              </button>
            </div>
            <div class="dm-image-preview-container mt-1" style="display: none;">
              <img src="" class="dm-image-preview-rect" alt="Prévia da Base" />
            </div>
          </div>

          <div class="dm-form-group">
            <label>Jogadores Controladores / Donos do Domínio:</label>
            <div class="dm-player-list">
              {{#if worldPlayers.length}}
                {{#each worldPlayers}}
                  <label class="dm-player-checkbox">
                    <input type="checkbox" class="dm-create-domain-controller" value="{{id}}" />
                    <span>{{name}}</span>
                  </label>
                {{/each}}
              {{else}}
                <span class="dm-text-muted">Nenhum jogador cadastrado no mundo.</span>
              {{/if}}
            </div>
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Tags (separadas por vírgula)</label>
              <input type="text" class="dm-input" id="dm-new-domain-tags" placeholder="Ex: capital, mineração, fronteira" />
            </div>
            <div class="dm-form-group">
              <label>Domínio Superior (Hierarquia)</label>
              <select class="dm-select" id="dm-new-domain-parent">
                <option value="">Nenhum (Raiz / Independente)</option>
                {{#each availableParentDomains}}
                  <option value="{{uuid}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Descrição Geral</label>
            <textarea class="dm-textarea" id="dm-new-domain-description" rows="2" placeholder="Breve resumo sobre a base..."></textarea>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelCreateDomain">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitCreateDomain"><i class="fa-solid fa-check"></i> Criar Domínio</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if isEditingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-large">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-pen-to-square text-amber"></i> Editar Base / Território: {{selectedDomain.name}}</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelEditDomain" title="Fechar"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc">Altere a ilustração da base, donos, categoria, defesa e hierarquia.</p>
        
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Nome do Domínio / Base *</label>
            <input type="text" class="dm-input" id="dm-edit-domain-name" value="{{selectedDomain.name}}" />
          </div>

          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Categoria (Customizável)</label>
              <input type="text" class="dm-input" id="dm-edit-domain-category" value="{{selectedDomain.category}}" />
            </div>
            <div class="dm-form-group">
              <label>Natureza</label>
              <select class="dm-select" id="dm-edit-domain-nature">
                <option value="physical" {{#if (eq selectedDomain.nature 'physical')}}selected{{/if}}>Físico / Territorial</option>
                <option value="organization" {{#if (eq selectedDomain.nature 'organization')}}selected{{/if}}>Organização / Guilda</option>
                <option value="hybrid" {{#if (eq selectedDomain.nature 'hybrid')}}selected{{/if}}>Híbrido</option>
                <option value="abstract" {{#if (eq selectedDomain.nature 'abstract')}}selected{{/if}}>Esfera Abstrata</option>
              </select>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Imagem / Ilustração da Base (Arquivo ou Link URL):</label>
            <div class="dm-file-input-group">
              <input type="text" class="dm-input dm-img-input" id="dm-edit-domain-crest" value="{{selectedDomain.crest}}" placeholder="caminho/imagem.webp ou link..." />
              <button type="button" class="dm-btn dm-btn--outline dm-btn--sm" data-action="openFilePicker" data-target="#dm-edit-domain-crest">
                <i class="fa-solid fa-file-import"></i> Arquivo
              </button>
            </div>
            {{#if selectedDomain.crest}}
              <div class="dm-image-preview-container mt-1">
                <img src="{{selectedDomain.crest}}" class="dm-image-preview-rect" alt="Ilustração da Base" onerror="this.style.display='none'" />
              </div>
            {{/if}}
          </div>

          <div class="dm-form-group">
            <label>Jogadores Controladores / Donos do Domínio:</label>
            <div class="dm-player-list">
              {{#if worldPlayers.length}}
                {{#each worldPlayers}}
                  <label class="dm-player-checkbox">
                    <input type="checkbox" class="dm-edit-domain-controller" value="{{id}}" {{#if isSelected}}checked{{/if}} />
