<div class="dm-shell" data-domain-manager-shell data-section="{{activeSection}}">
  <div class="dm-hud-transition-overlay dm-hud-transition-overlay--fullscreen" aria-hidden="true">
  <!-- Cantoneiras Táticas de Enquadramento -->
  <div class="dm-hud-bracket dm-hud-bracket--tl"></div>
  <div class="dm-hud-bracket dm-hud-bracket--tr"></div>
  <div class="dm-hud-bracket dm-hud-bracket--bl"></div>
  <div class="dm-hud-bracket dm-hud-bracket--br"></div>

  <!-- Barra Superior de Telemetria (100% em Português) -->
  <div class="dm-hud-transition__top-bar">
    <div class="dm-hud-transition__sys-pill is-active">
      <span class="dm-hud-dot"></span> SISTEMAS
    </div>
    <div class="dm-hud-transition__sys-pill">LOGÍSTICA</div>
    <div class="dm-hud-transition__sys-pill">BANCO DE DADOS</div>
    <div class="dm-hud-transition__sys-meta">
      <span>CANAL SEGURO: CRIPTO-SHA256</span>
      <span>NÚCLEO TÁTICO v2.4 // REGISTRO: {{selectedDomain.name}}</span>
    </div>
  </div>

  <!-- Texturas Táticas de Fundo (Dot Matrix & Scanlines) -->
  <div class="dm-hud-transition__scanlines"></div>
  <div class="dm-hud-transition__dot-grid"></div>
  <div class="dm-hud-transition__glitch-beam"></div>

  <!-- Radar Tático Central com Mira e Coordenadas -->
  <div class="dm-hud-transition__radar-wrap">
    <div class="dm-hud-transition__radar-crosshair dm-hud-transition__radar-crosshair--h"></div>
    <div class="dm-hud-transition__radar-crosshair dm-hud-transition__radar-crosshair--v"></div>
    <div class="dm-hud-transition__radar-circle"></div>
    <div class="dm-hud-transition__radar-circle dm-hud-transition__radar-circle--lg"></div>
    <div class="dm-hud-transition__radar-circle dm-hud-transition__radar-circle--xl"></div>
    <div class="dm-hud-transition__radar-sweep"></div>
    <div class="dm-hud-transition__radar-coords">
      <span>AZIMUTE: 042° // ELEVAÇÃO: 850M</span>
      <span>LAT: 44° 12' S // LONG: 53° 08' O // ALCANCE: 100 KM</span>
    </div>
  </div>

  <!-- Banner Central Tático (Placa Escura com Borda Iluminada e Chanfro) -->
  <div class="dm-hud-transition__sector-banner">
    <div class="dm-hud-transition__sector-accent"></div>
    <div class="dm-hud-transition__sector-text">
      <div class="dm-hud-transition__sector-title">{{sectorCallout}}</div>
      <div class="dm-hud-transition__sector-sub">ACESSO AUTORIZADO · PROTOCOLO SINCRONIZADO</div>
    </div>
  </div>

  <!-- Painéis Inferiores Dinâmicos e Únicos por Página (Sem Vazamento) -->
  <div class="dm-hud-transition__bottom-panels">
    <!-- Bloco 1: Rotina Dinâmica em Português -->
    <div class="dm-hud-transition__code-panel">
      <div class="dm-hud-transition__code-header">
        <span>{{hudTelemetry.routineHeader}}</span>
        <span class="text-crimson">AUTORIZADO</span>
      </div>
      <div class="dm-hud-transition__code-wrapper">
        <div class="dm-hud-transition__code-stream">
          {{#each hudTelemetry.routineLines}}
            <div class="dm-code-line"><span class="dm-line-no">{{this.no}}</span> {{this.code}}</div>
          {{/each}}
        </div>
      </div>
      <div class="dm-hud-transition__tag">
        <span class="dm-hud-transition__tag-accent"></span>
        <span>{{hudTelemetry.routineTag}}</span>
      </div>
    </div>

    <!-- Bloco 2: Matriz Dinâmica de Dados e Telemetria -->
    <div class="dm-hud-transition__binary-panel">
      <div class="dm-hud-transition__code-header">
        <span>{{hudTelemetry.matrixHeader}}</span>
        <span class="text-amber">FLUXO_ONLINE</span>
      </div>
      <div class="dm-hud-transition__code-wrapper">
        <div class="dm-hud-transition__binary-stream">
          {{#each hudTelemetry.matrixLines}}
            <div class="dm-bin-line">{{this}}</div>
          {{/each}}
        </div>
      </div>
      <div class="dm-hud-transition__tag">
        <span class="dm-hud-transition__tag-accent"></span>
        <span>{{hudTelemetry.matrixTag}}</span>
      </div>
    </div>
  </div>
</div>

  <!-- OVERLAY DE BOOT TÁTICO AAA (EXECUTA EXCLUSIVAMENTE NA ABERTURA DO MÓDULO) -->
  <div class="dm-boot-welcome-overlay {{#if shouldPlayBootWelcome}}is-active{{else}}is-finished{{/if}}" aria-hidden="true">
    <!-- 1. Textura Hexagonal de Fundo (GIF 3) -->
    <div class="dm-boot-hex-grid"></div>
    <div class="dm-boot-scanline"></div>

    <!-- 2. Pista em Perspectiva e Horizonte (GIF 2) -->
    <div class="dm-boot-runway-perspective">
      <div class="dm-boot-runway-plane"></div>
    </div>
    <div class="dm-boot-horizon"></div>
    <div class="dm-boot-laser-tracer dm-boot-laser-tracer--left"></div>
    <div class="dm-boot-laser-tracer dm-boot-laser-tracer--right"></div>

    <!-- 3. Cantoneiras de Cockpit (GIF 1 & 2) -->
    <div class="dm-boot-cockpit-bracket dm-boot-cockpit-bracket--left"></div>
    <div class="dm-boot-cockpit-bracket dm-boot-cockpit-bracket--right"></div>

    <!-- 4. Núcleo Holográfico com Globo e Anéis Concéntricos (GIF 3) -->
    <div class="dm-boot-core-system">
      <div class="dm-boot-ring dm-boot-ring-outer"></div>
      <div class="dm-boot-ring dm-boot-ring-ticks"></div>
      <div class="dm-boot-ring dm-boot-ring-inner"></div>
      <div class="dm-boot-sphere"></div>
    </div>

    <!-- 5. Painel de Holo-Projeção Superior Direito (GIF 3) -->
    <div class="dm-boot-holo-projector">
      <div class="dm-boot-holo-projector__header">
        <span>// HOLO-DIAG</span>
        <span>ESTRUTURA: ATIVA</span>
      </div>
      <div class="dm-boot-holo-mesh">
        <div class="dm-boot-holo-rig"></div>
      </div>
    </div>

    <!-- 6. Painel de Telemetria e Frequência Superior Esquerdo (GIF 3 & 1) -->
    <div class="dm-boot-telemetry-panel">
      <div class="dm-boot-telemetry-header">
        <span>SISTEMA TÁTICO v0.1</span>
        <span>LINK 100%</span>
      </div>
      <div class="dm-boot-equalizer">
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
        <div class="dm-boot-eq-bar"></div>
      </div>
      <div class="dm-boot-port-check">
        PORT CHECK: 399.160.01:60.000<br>
        ENCRIPTADOR: ATIVO // ALFA
      </div>
    </div>

    <!-- 7. Card de Boas-Vindas Central ao Usuário -->
    <div class="dm-boot-welcome-card">
      <div class="dm-boot-status-badge">
        <span class="dm-boot-status-dot"></span>
        <span>AUTORIZAÇÃO NÍVEL ALFA CONCEDIDA</span>
      </div>
      <h1 class="dm-boot-welcome-title">SEJA BEM-VINDO, <span>{{currentUserName}}</span></h1>
      <p class="dm-boot-welcome-subtitle">// TERMINAL DE SOBERANIA OPERACIONAL CARREGADO //</p>
      <div class="dm-boot-progress-bar">
        <div class="dm-boot-progress-fill"></div>
      </div>
    </div>
  </div>

  <div class="dm-shell__layout">
    <nav class="dm-rail" aria-label="Navegação Global">
  <div class="dm-rail__brand" title="{{localize 'DOMAIN_MANAGER.Title'}}">
    <i class="fa-solid fa-sitemap dm-rail__logo"></i>
  </div>

  <div class="dm-rail__nav">
    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'dashboard')}}is-active{{/if}}"
      data-action="navigate"
      data-section="dashboard"
      title="{{localize 'DOMAIN_MANAGER.Tabs.Overview'}}"
      aria-label="{{localize 'DOMAIN_MANAGER.Tabs.Overview'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-chart-pie"></i>
    </button>

    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'domains')}}{{#if isSidebarOpen}}is-active{{/if}}{{/if}}"
      data-action="navigate"
      data-section="domains"
      title="Abrir / Recolher Painel Lateral de Bases"
      aria-label="{{localize 'DOMAIN_MANAGER.Sidebar.Title'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-layer-group"></i>
    </button>

    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'economy')}}is-active{{/if}}"
      data-action="navigate"
      data-section="economy"
      title="{{localize 'DOMAIN_MANAGER.Tabs.Economy'}}"
      aria-label="{{localize 'DOMAIN_MANAGER.Tabs.Economy'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-coins"></i>
    </button>

    <button
      type="button"
      class="dm-rail__item {{#if (eq activeSection 'projects')}}is-active{{/if}}"
      data-action="navigate"
      data-section="projects"
      title="{{localize 'DOMAIN_MANAGER.Tabs.Projects'}}"
      aria-label="{{localize 'DOMAIN_MANAGER.Tabs.Projects'}}"
    >
      <span class="dm-rail__indicator"></span>
      <i class="fa-solid fa-trowel-bricks"></i>
    </button>

    {{#if isGM}}
      <button
        type="button"
        class="dm-rail__item"
        data-action="openAdvanceModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
        aria-label="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
      >
        <span class="dm-rail__indicator"></span>
        <i class="fa-solid fa-clock-rotate-left"></i>
      </button>

      <button
        type="button"
        class="dm-rail__item"
        data-action="openEventModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
        aria-label="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
      >
        <span class="dm-rail__indicator"></span>
        <i class="fa-solid fa-dice-d20"></i>
      </button>
    {{/if}}
  </div>
</nav>


    <div class="dm-shell__body">
      <aside class="dm-sidebar {{#if isSidebarOpen}}is-expanded{{else}}is-collapsed{{/if}}" aria-label="Terminal Operacional">
  <!-- CABEÇALHO DO TERMINAL -->
  <header class="dm-sidebar__header">
    {{#if isSidebarOpen}}
      <div class="dm-sidebar__title-row">
        <div class="dm-sidebar__brand">
          <i class="fa-solid fa-sitemap text-crimson"></i>
          <span class="dm-sidebar__brand-title">TERMINAL TÁTICO</span>
        </div>
        <div class="dm-sidebar__header-actions">
          {{#if isGM}}
            <button
              type="button"
              class="dm-icon-btn dm-icon-btn--primary"
              data-action="openCreateDomain"
              title="{{localize 'DOMAIN_MANAGER.Sidebar.NewDomain'}}"
              aria-label="{{localize 'DOMAIN_MANAGER.Sidebar.NewDomain'}}"
            >
              <i class="fa-solid fa-plus"></i>
            </button>
          {{/if}}

          <button
            type="button"
            class="dm-icon-btn"
            data-action="toggleSidebar"
            title="Recolher Painel Lateral"
            aria-label="Recolher Painel Lateral"
          >
            <i class="fa-solid fa-chevron-left"></i>
          </button>
        </div>
      </div>

      <!-- SWITCHER 2-WAY (Módulos / Territórios - sem o Tudo) -->
      <div class="dm-sidebar__view-switcher" role="tablist">
        <button
          type="button"
          class="dm-sidebar__view-btn {{#if (eq sidebarView 'modules')}}is-active{{/if}}"
          data-action="setSidebarView"
          data-view="modules"
          title="Focar nos Módulos Operacionais da base"
        >
          <i class="fa-solid fa-microchip"></i>
          <span>Módulos</span>
        </button>
        <button
          type="button"
          class="dm-sidebar__view-btn {{#if (eq sidebarView 'domains')}}is-active{{/if}}"
          data-action="setSidebarView"
          data-view="domains"
          title="Focar nos Territórios e Pastas do mundo"
        >
          <i class="fa-solid fa-folder-tree"></i>
          <span>Territórios</span>
        </button>
      </div>
    {{else}}
      <!-- MODO RECOLHIDO: Botão único de expansão centralizado -->
      <div class="dm-sidebar__collapsed-header">
        <button
          type="button"
          class="dm-icon-btn dm-icon-btn--primary dm-sidebar__expand-btn"
          data-action="toggleSidebar"
          title="Expandir Painel Lateral"
          aria-label="Expandir Painel Lateral"
        >
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    {{/if}}
  </header>

  <!-- CONTEÚDO DA SIDEBAR -->
  <div class="dm-sidebar__scroll-area">
    {{#if (eq sidebarView 'modules')}}
      {{#if selectedDomain}}
        <!-- MÓDULOS TÁTICOS DA BASE ATIVA -->
        <nav class="dm-tactical-nav dm-sidebar__tactical-nav" aria-label="Módulos Operacionais">
          {{#if isSidebarOpen}}
            <div class="dm-sidebar__section-divider">
              <span>// MÓDULOS OPERACIONAIS</span>
            </div>
          {{/if}}

          <div class="dm-sidebar__nav-list">
            {{#each navigationHubItems}}
              <button
                type="button"
                class="dm-sidebar__nav-item {{#if (eq this.tab @root.activeTab)}}is-active{{/if}}"
                data-action="switchTab"
                data-tab="{{this.tab}}"
                title="{{this.title}}"
              >
                {{#if @root.isSidebarOpen}}
                  <span class="dm-sidebar__nav-idx">{{this.index}}</span>
                {{/if}}
                <i class="{{this.icon}} dm-sidebar__nav-icon"></i>
                {{#if @root.isSidebarOpen}}
                  <span class="dm-sidebar__nav-label">{{this.shortTitle}}</span>
                  {{#if this.badge}}
                    <span class="dm-sidebar__nav-badge">{{this.badge}}</span>
                  {{/if}}
                {{/if}}
              </button>
            {{/each}}
          </div>
        </nav>
      {{else}}
        <div class="dm-empty dm-p-4 text-center text-muted">
          <i class="fa-solid fa-satellite dm-mb-2"></i>
          <p>Selecione um domínio na aba Territórios para acessar os módulos.</p>
        </div>
      {{/if}}
    {{else}}
      <!-- ÁRVORE DE DOMÍNIOS E PASTAS DO MUNDO -->
      {{#if isSidebarOpen}}
        <div class="dm-sidebar__domains-section">
          <div class="dm-sidebar__section-divider">
            <span>// SETORES & TERRITÓRIOS</span>
            <button
              type="button"
              class="dm-sidebar__sub-btn"
              data-action="toggleAllFolders"
              title="{{#if allFoldersCollapsed}}Expandir Todas as Pastas{{else}}Recolher Todas as Pastas{{/if}}"
            >
              <i class="fa-solid {{#if allFoldersCollapsed}}fa-folder-closed{{else}}fa-folder-open{{/if}}"></i>
            </button>
          </div>

          <div class="dm-search">
            <i class="fa-solid fa-magnifying-glass dm-search__icon"></i>
            <input
              type="search"
              class="dm-search__input"
              placeholder="{{localize 'DOMAIN_MANAGER.SearchPlaceholder'}}"
              value="{{searchQuery}}"
              data-action="search"
            />
          </div>

          <div class="dm-switcher" role="tablist">
            <button
              type="button"
              class="dm-switcher__btn {{#if (eq sidebarMode 'hierarchy')}}is-active{{/if}}"
              data-action="setSidebarMode"
              data-mode="hierarchy"
            >
              {{localize 'DOMAIN_MANAGER.Sidebar.Folders'}}
            </button>
            <button
              type="button"
              class="dm-switcher__btn {{#if (eq sidebarMode 'tags')}}is-active{{/if}}"
              data-action="setSidebarMode"
              data-mode="tags"
            >
              {{localize 'DOMAIN_MANAGER.Sidebar.Tags'}}
            </button>
          </div>

          <div class="dm-sidebar__content">
            {{#if (eq sidebarMode 'hierarchy')}}
              <div class="dm-tree" role="tree">
                <div
                  class="dm-tree-item dm-tree-item--root {{#unless selectedDomain}}is-selected{{/unless}}"
                  data-action="selectDomain"
                  data-uuid=""
                  role="treeitem"
                  tabindex="0"
                >
                  <i class="fa-solid fa-globe dm-tree-item__icon text-amber"></i>
                  <span class="dm-tree-item__label">{{localize 'DOMAIN_MANAGER.AllDomains'}}</span>
                </div>

                {{#each flatDomainTree}}
                  <div
                    class="dm-tree-item {{#if isSelected}}is-selected{{/if}} {{#if isFolder}}dm-tree-item--folder{{else}}dm-tree-item--leaf{{/if}}"
                    data-uuid="{{uuid}}"
                    data-depth="{{depth}}"
                    style="padding-left: calc({{depth}} * 14px + 8px);"
                    role="treeitem"
                    tabindex="0"
                  >
                    {{#if isFolder}}
                      <button
                        type="button"
                        class="dm-tree-item__toggle"
                        data-action="toggleFolder"
                        data-folder-id="{{folderId}}"
                        aria-label="{{#if isCollapsed}}Expandir{{else}}Recolher{{/if}}"
                      >
                        <i class="fa-solid {{#if isCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                      </button>
                    {{else}}
                      {{#if (gt depth 0)}}
                        <span class="dm-tree-branch">└─</span>
                      {{else}}
                        <span class="dm-tree-spacer"></span>
                      {{/if}}
                    {{/if}}

                    <div class="dm-tree-item__content" data-action="selectDomain" data-uuid="{{uuid}}">
                      {{#if hasImage}}
                        <img src="{{image}}" class="dm-tree-item__thumb" alt="{{name}}" />
                      {{else}}
                        <i class="fa-solid {{#if isFolder}}fa-folder text-amber{{else}}fa-shield-halved text-blue{{/if}} dm-tree-item__icon"></i>
                      {{/if}}
                      <span class="dm-tree-item__label" title="{{name}}">{{name}}</span>
                      {{#if childCount}}
                        <span class="dm-tree-item__count">{{childCount}}</span>
                      {{/if}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <!-- Modo Tags -->
              <div class="dm-tag-list">
                {{#each tagList}}
                  <button
                    type="button"
                    class="dm-tag-item {{#if isSelected}}is-active{{/if}}"
                    data-action="filterByTag"
                    data-tag="{{tag}}"
                  >
                    <span class="dm-tag-item__name">#{{tag}}</span>
                    <span class="dm-tag-item__count">{{count}}</span>
                  </button>
                {{/each}}
              </div>
            {{/if}}
          </div>
        </div>
      {{/if}}
    {{/if}}
  </div>
</aside>


      <main class="dm-shell__main">
        <header class="dm-workspace-header dm-hud-header">
  <div class="dm-workspace-header__main">

    {{#if selectedDomain}}
      <div class="dm-workspace-header__identity">
        {{#if selectedDomain.hasImage}}
          <img src="{{selectedDomain.image}}" class="dm-base-thumb" alt="{{selectedDomain.name}}" />
        {{else}}
          <div class="dm-base-thumb dm-base-thumb--empty">
            <i class="fa-solid fa-mountain-sun"></i>
          </div>
        {{/if}}

        <div class="dm-workspace-header__titles">
          <div class="dm-workspace-header__title-row">
            <h1 class="dm-workspace-header__title">{{selectedDomain.name}}</h1>
            <span class="dm-pill dm-pill--category">{{selectedDomain.categoryLabel}}</span>
            <span class="dm-pill dm-pill--nature">{{selectedDomain.natureLabel}}</span>
            <span class="dm-badge dm-badge--{{selectedDomain.state}}">{{selectedDomain.stateLabel}}</span>
          </div>
        </div>
      </div>
    {{else}}
      <div class="dm-workspace-header__identity">
        <h1 class="dm-workspace-header__title">{{localize 'DOMAIN_MANAGER.AllDomains'}}</h1>
        <p class="dm-workspace-header__subtitle">Visão Consolidada do Território</p>
      </div>
    {{/if}}
  </div>

  <div class="dm-workspace-header__actions">
    {{#if isGM}}
      {{#if selectedDomain}}
        <button
          type="button"
          class="dm-btn dm-btn--outline dm-btn--sm"
          data-action="openEditDomain"
          title="Editar identidade deste Domínio"
        >
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Editar</span>
        </button>

        <button
          type="button"
          class="dm-btn dm-btn--danger dm-btn--sm"
          data-action="openDeleteDomainModal"
          title="Excluir permanentemente este Domínio"
        >
          <i class="fa-solid fa-trash-can"></i>
        </button>
      {{/if}}

      <button
        type="button"
        class="dm-btn dm-btn--outline dm-btn--sm"
        data-action="openEventModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.RollEvent'}}"
      >
        <i class="fa-solid fa-dice-d20"></i>
        <span>Evento</span>
      </button>

      <button
        type="button"
        class="dm-btn dm-btn--primary dm-btn--sm"
        data-action="openAdvanceModal"
        title="{{localize 'DOMAIN_MANAGER.Actions.AdvanceTime'}}"
      >
        <i class="fa-solid fa-forward-step"></i>
        <span>Avançar Tempo</span>
      </button>
    {{/if}}
  </div>
</header>

        <!-- MODAIS IN-PAGE COMPACTOS COM CONTENÇÃO E SCROLL INTERNO -->

<!-- 1. MODAL: ADICIONAR TAGS -->
{{#if isTagModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-tag text-emerald"></i> Adicionar Tags ao Domínio</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelTagModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc">Digite uma ou mais tags separadas por vírgula.</p>
        <div class="dm-form-group mt-1">
          <label>Novas Tags:</label>
          <input type="text" class="dm-input dm-input--compact" id="dm-new-tag-input" placeholder="Ex: capital, mineração, setor-3" autofocus />
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelTagModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitAddTag"><i class="fa-solid fa-check"></i> Salvar Tags</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 2. MODAL: EXCLUIR DOMÍNIO -->
{{#if isDeletingDomain}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-dialog-card--danger dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-triangle-exclamation text-rose"></i> Confirmar Exclusão</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelDeleteDomainModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <p class="dm-dialog-desc font-semibold text-rose">
