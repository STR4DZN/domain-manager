<div class="dm-os dm-app-v4 dm-workspace--{{activeWorkspace}} dm-active-view--{{activeView}} {{#if inspectorOpen}}is-inspector-open{{/if}}">
  <aside class="dm-app-sidebar">
    <header class="dm-sidebar-brand">
      <div class="dm-brand-mark" aria-hidden="true"><span></span><span></span><span></span></div>
      <div><small>SISTEMA ESTRATÉGICO</small><strong>DOMAIN//OS</strong><em>{{appVersion}}</em></div>
    </header>

    {{#if selectedDomain}}
      <button type="button" class="dm-domain-switcher" data-action="navigate" data-view="domains" title="Abrir domínios">
        <span class="dm-domain-switcher__status dm-domain-switcher__status--{{selectedDomain.stateTone}}"></span>
        <span><small>{{selectedDomain.category}} / {{selectedDomain.presetLabel}}</small><strong>{{selectedDomain.name}}</strong><em>{{selectedDomain.entityIdShort}}</em></span>
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    {{else}}
      <button type="button" class="dm-domain-switcher" data-action="navigate" data-view="domains"><span class="dm-domain-switcher__status"></span><span><small>REDE DE DOMÍNIOS</small><strong>Selecionar domínio</strong><em>{{domainCount}} DOMÍNIO(S)</em></span><i class="fa-solid fa-chevron-right"></i></button>
    {{/if}}

    <nav class="dm-app-nav" aria-label="Navegação principal">
      <section class="dm-nav-section dm-nav-section--global">
        <span class="dm-nav-section__label">SISTEMA</span>
        {{#each globalNav}}
          <button type="button" class="dm-nav-item {{#if active}}is-active{{/if}}" data-action="navigate" data-view="{{id}}"><i class="{{icon}}"></i><span>{{label}}</span>{{#if active}}<em>ATIVO</em>{{/if}}</button>
        {{/each}}
      </section>

      {{#if selectedDomain}}
        <label class="dm-nav-workspace-picker"><span>Área</span><select data-workspace-select aria-label="Selecionar área de trabalho">{{#each workspaceNav}}<option value="{{view}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <section class="dm-nav-section dm-nav-section--workspaces">
          <span class="dm-nav-section__label">ÁREAS</span>
          {{#each workspaceNav}}
            <div class="dm-nav-workspace dm-nav-workspace--{{id}} {{#if active}}is-active{{/if}}">
              <button type="button" class="dm-nav-workspace__head" data-action="navigate" data-view="{{view}}"><i class="{{icon}}"></i><span><strong>{{label}}</strong><small>{{code}} / {{childCount}} ferramentas</small></span><em>{{code}}</em></button>
              <div class="dm-nav-workspace__children">
                {{#each children}}
                  <button type="button" class="dm-nav-subitem {{#if active}}is-active{{/if}}" data-action="navigate" data-view="{{id}}"><span></span><i class="{{icon}}"></i><strong>{{label}}</strong></button>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </section>
      {{/if}}
    </nav>

    <footer class="dm-sidebar-system">
      <div><span class="dm-sysdot {{#if authorityReady}}is-online{{else}}is-offline{{/if}}"></span><span><small>AUTORIDADE</small><strong>{{system.authority}}</strong></span></div>
      <div><small>SESSÃO</small><strong>{{system.primary}}</strong></div>
    </footer>
  </aside>

  <section class="dm-app-main">
    <header class="dm-app-topbar">
      <div class="dm-app-breadcrumb">
        <span>REDE DE DOMÍNIOS</span><i class="fa-solid fa-chevron-right"></i>
        {{#if selectedDomain}}<strong>{{selectedDomain.name}}</strong><i class="fa-solid fa-chevron-right"></i>{{/if}}
        <em>{{activeWorkspace}}</em>
      </div>

      <form class="dm-command-search" onsubmit="return false">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input data-dm-search type="search" value="{{searchQuery}}" placeholder="Pesquisar domínios por nome, categoria ou tag..." aria-label="Pesquisar domínios" />
        <kbd>⌘ K</kbd>
        {{#if searchQuery}}<button type="button" data-action="clearSearch" title="Limpar"><i class="fa-solid fa-xmark"></i></button>{{else}}<button type="button" data-action="applySearch" title="Pesquisar"><i class="fa-solid fa-arrow-right"></i></button>{{/if}}
      </form>

      <div class="dm-app-topbar__actions">
        {{#if isGM}}<button type="button" class="dm-top-action" data-action="openCreateDomain" title="Registrar domínio"><i class="fa-solid fa-plus"></i><span>Novo domínio</span></button>{{/if}}
        <button type="button" class="dm-top-action dm-inspector-toggle" data-action="toggleInspector" title="Abrir painel de contexto" aria-label="Abrir painel de contexto"><i class="fa-solid fa-circle-info"></i><span>Contexto</span></button>
        <button type="button" class="dm-top-status dm-top-status--{{system.authorityTone}}" title="Autoridade: {{system.authority}}"><span class="dm-sysdot {{#if authorityReady}}is-online{{else}}is-offline{{/if}}"></span><span><small>AUT.</small><strong>{{system.authority}}</strong></span></button>
      </div>
    </header>

    {{#if selectedDomain}}
      {{#unless view.command}}{{#unless view.domains}}{{#unless view.operations}}{{#unless view.system}}
      <section class="dm-domain-toolbar">
        <div class="dm-domain-toolbar__identity">{{#if selectedDomain.visuals.crestImg}}<span class="dm-domain-toolbar__crest"><img src="{{selectedDomain.visuals.crestImg}}" alt="" /></span>{{/if}}<span class="dm-kicker">{{selectedDomain.natureLabel}} / {{selectedDomain.category}}</span><strong>{{selectedDomain.name}}</strong><span class="dm-chip dm-chip--{{selectedDomain.stateTone}}">{{selectedDomain.stateLabel}}</span>{{#if isGM}}<button type="button" class="dm-domain-media-button" data-action="openDomainMedia" title="Gerenciar imagens e aparência"><i class="fa-solid fa-image"></i><span>Aparência</span></button>{{/if}}</div>
        <div class="dm-domain-toolbar__signals">
          <span><small>POP</small><strong>{{telemetry.population}}</strong></span>
          <span><small>ATIVOS</small><strong>{{telemetry.operationalStructures}}</strong></span>
          <span><small>OPS</small><strong>{{telemetry.activeMissions}}</strong></span>
          <span><small>COND.</small><strong>{{telemetry.conditions}}</strong></span>
        </div>
      </section>
      {{/unless}}{{/unless}}{{/unless}}{{/unless}}
    {{/if}}

    <div class="dm-app-workarea">
      <main class="dm-stage">
      <div class="dm-app__workspace-scroll">
        {{#if view.command}}
          <section class="dm-view dm-view--command">
            <header class="dm-view-header dm-view-header--command">
              <div><span class="dm-kicker">COMANDO GLOBAL // REDE ATIVA</span><h2>Comando Estratégico</h2><p>Visão consolidada de domínios, forças, projetos e operações.</p></div>
              <div class="dm-live-clock"><span>ESTADO DA REDE</span><strong>{{system.authority}}</strong><small>{{domainCount}} DOMÍNIOS INDEXADOS</small></div>
            </header>

            <div class="dm-command-grid">
              <section class="dm-command-domains">
                <header class="dm-module-header"><div><span>01</span><div><small>DOMÍNIOS CADASTRADOS</small><strong>Rede sob gestão</strong></div></div><em>{{domainCount}} REGISTROS</em></header>
                <div class="dm-command-domain-head"><span>Domínio</span><span>Categoria</span><span>População</span><span>Estado</span></div>
                <div class="dm-command-domain-list">
                  {{#each domains}}
                    <button type="button" class="dm-command-domain-row {{#if selected}}is-selected{{/if}}" data-action="selectDomain" data-uuid="{{uuid}}">
                      <span class="dm-command-domain-row__identity"><i class="dm-status-pip dm-status-pip--{{stateTone}}"></i><span><strong>{{name}}</strong><small>{{entityId}}</small></span></span>
                      <span>{{category}}</span><strong>{{population}}</strong><em class="dm-chip dm-chip--{{stateTone}}">{{state}}</em>
                    </button>
                  {{else}}
                    <div class="dm-empty"><i class="fa-solid fa-sitemap"></i><strong>Nenhum domínio cadastrado</strong><span>Crie o primeiro domínio para iniciar a gestão do mundo.</span>{{#if ../isGM}}<button type="button" class="dm-action-button" data-action="openCreateDomain">CRIAR PRIMEIRO DOMÍNIO</button>{{/if}}</div>
                  {{/each}}
                </div>
              </section>

              <aside class="dm-command-summary">
                <section class="dm-command-stats" aria-label="Resumo da rede">
                  <article><small>DOMÍNIOS</small><strong>{{globalCounts.domains}}</strong></article>
                  <article><small>PROJETOS</small><strong>{{globalCounts.projects}}</strong></article>
                  <article><small>MISSÕES</small><strong>{{globalCounts.missions}}</strong></article>
                  <article><small>FORÇAS</small><strong>{{globalCounts.squads}}</strong></article>
                  <article><small>ESTRUTURAS</small><strong>{{globalCounts.structures}}</strong></article>
                </section>
                <section class="dm-command-activity">
                  <header><div><span class="dm-kicker">OPERAÇÕES</span><strong>Atividade atual</strong></div><em>{{globalCounts.missions}}</em></header>
                  <div class="dm-ops-feed">
                    {{#each allMissions}}
                      <div class="dm-ops-feed__entry"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{name}}</strong><small>{{statusLabel}}</small></div><em title="{{entityId}}">{{entityId}}</em></div>
                    {{else}}<div class="dm-empty-signal">NENHUMA OPERAÇÃO ATIVA</div>{{/each}}
                  </div>
                </section>
                <section class="dm-command-session">
                  <header><span class="dm-kicker">SESSÃO</span><strong>{{system.authority}}</strong></header>
                  <dl><div><dt>GM ativo</dt><dd>{{system.activeGM}}</dd></div><div><dt>Função</dt><dd>{{system.primary}}</dd></div><div><dt>Tempo</dt><dd>{{system.timeProvider}}</dd></div></dl>
                </section>
              </aside>
            </div>
          </section>
        {{/if}}

        {{#if view.domains}}
          <section class="dm-view dm-view--registry">
            <header class="dm-view-header"><div><span class="dm-kicker">REGISTRO // DOMÍNIOS CADASTRADOS</span><h2>Domínios</h2><p>Cadastre, localize, edite e selecione os domínios gerenciados pelo módulo.</p></div>{{#if isGM}}<div class="dm-view-header__actions">{{#if selectedDomain}}<button class="dm-action-button dm-action-button--secondary" type="button" data-action="openEditDomain" data-uuid="{{selectedDomain.uuid}}"><i class="fa-solid fa-pen"></i> EDITAR</button><button class="dm-action-button dm-action-button--critical" type="button" data-action="openDeleteDomain" data-uuid="{{selectedDomain.uuid}}"><i class="fa-solid fa-trash"></i> EXCLUIR</button>{{/if}}<button class="dm-action-button" type="button" data-action="openCreateDomain"><i class="fa-solid fa-plus"></i> NOVO DOMÍNIO</button></div>{{/if}}</header>
            <div class="dm-registry-layout">
              <section class="dm-registry-index">
                <div class="dm-registry-index__header"><span>DOMÍNIO</span><span>CATEGORIA</span><span>PERFIL</span><span>POP</span><span>ESTADO</span></div>
                {{#each domains}}
                  <button type="button" class="dm-registry-row {{#if selected}}is-selected{{/if}}" data-action="selectDomain" data-uuid="{{uuid}}">
                    <span><i></i><strong>{{name}}</strong><small>{{entityId}}</small></span><span>{{category}}</span><span>{{preset}}</span><span>{{population}}</span><span class="dm-chip dm-chip--{{stateTone}}">{{state}}</span>
                  </button>
                {{else}}<div class="dm-empty-signal">NENHUM DOMÍNIO CADASTRADO</div>{{/each}}
              </section>
            </div>
          </section>
        {{/if}}

        {{#if view.operations}}
          <section class="dm-view dm-view--global-ops">
            <header class="dm-view-header"><div><span class="dm-kicker">OPERAÇÕES // VISÃO CONSOLIDADA</span><h2>Operações</h2><p>Acompanhe missões, forças e projetos em um único lugar.</p></div><div class="dm-view-code">OPS//{{globalCounts.missions}}-{{globalCounts.squads}}-{{globalCounts.projects}}</div></header>
            <div class="dm-operations-radar">
              <section class="dm-op-channel dm-op-channel--mission"><header><span>MISSÕES</span><strong>{{globalCounts.missions}}</strong></header>{{#each allMissions}}<div class="dm-op-line"><i class="dm-status-pip dm-status-pip--{{tone}}"></i><span><strong>{{name}}</strong><small>{{statusLabel}}</small></span><em>{{entityId}}</em></div>{{else}}<div class="dm-empty-signal">NENHUMA MISSÃO</div>{{/each}}</section>
              <section class="dm-op-channel dm-op-channel--force"><header><span>FORÇAS</span><strong>{{globalCounts.squads}}</strong></header>{{#each allSquads}}<div class="dm-op-line"><i class="dm-status-pip dm-status-pip--{{tone}}"></i><span><strong>{{name}}</strong><small>{{statusLabel}}</small></span><em>{{entityId}}</em></div>{{else}}<div class="dm-empty-signal">NENHUMA FORÇA</div>{{/each}}</section>
              <section class="dm-op-channel dm-op-channel--project"><header><span>PROJETOS</span><strong>{{globalCounts.projects}}</strong></header>{{#each allProjects}}<div class="dm-op-line"><i class="dm-status-pip dm-status-pip--{{tone}}"></i><span><strong>{{name}}</strong><small>{{statusLabel}}</small></span><em>{{entityId}}</em></div>{{else}}<div class="dm-empty-signal">NENHUM PROJETO</div>{{/each}}</section>
            </div>
          </section>
        {{/if}}

        {{#if view.system}}
          <section class="dm-view dm-view--system">
            <header class="dm-view-header"><div><span class="dm-kicker">SISTEMA // CONTROLE E SIMULAÇÃO</span><h2>Sistema</h2><p>Estado do módulo e controles de simulação do mundo.</p></div><span class="dm-chip dm-chip--{{system.authorityTone}}">{{system.authority}}</span></header>
            <div class="dm-system-core-grid">
              <section class="dm-core-diagram"><div class="dm-core-orbit"><span>NÚCLEO</span><i></i><i></i><i></i></div><div class="dm-core-readouts"><div><small>FUNÇÃO</small><strong>{{system.primary}}</strong></div><div><small>GM ATIVO</small><strong>{{system.activeGM}}</strong></div><div><small>TEMPO</small><strong>{{system.timeProvider}}</strong></div><div><small>CONEXÃO</small><strong>{{system.authority}}</strong></div></div></section>
              {{#if isGM}}<section class="dm-simulation-console"><header><span class="dm-kicker">SIMULAÇÃO</span><strong>AVANÇAR MUNDO</strong></header><p>Executa a passagem de tempo pelo GM primário.</p><div class="dm-sim-buttons"><button class="dm-action-button" type="button" data-action="advanceTicks" data-ticks="1">+01</button><button class="dm-action-button dm-action-button--secondary" type="button" data-action="advanceTicks" data-ticks="7">+07</button><button class="dm-action-button dm-action-button--secondary" type="button" data-action="advanceTicks" data-ticks="30">+30</button></div></section>{{/if}}
            </div>
          </section>
        {{/if}}

        {{#if view.overview}}
          <section class="dm-view dm-view--overview">
            {{#if selectedDomain.visuals.image}}
              <figure class="dm-domain-hero">
                <div class="dm-domain-hero__media dm-fit--{{selectedDomain.visuals.imageFit}}" style="--dm-img-x:{{selectedDomain.visuals.imagePosX}}%;--dm-img-y:{{selectedDomain.visuals.imagePosY}}%;--dm-img-zoom:{{selectedDomain.visuals.imageZoom}}%;">
                  <img src="{{selectedDomain.visuals.image}}" alt="Imagem de {{selectedDomain.name}}" />
                </div>
                <figcaption><span class="dm-kicker">DOMÍNIO ATUAL</span><strong>{{selectedDomain.name}}</strong><small>{{selectedDomain.presetLabel}} · {{selectedDomain.stateLabel}}</small></figcaption>
              </figure>
            {{else}}{{#if selectedDomain.visuals.bannerImg}}
              <figure class="dm-domain-hero dm-domain-hero--banner">
                <div class="dm-domain-hero__media dm-fit--cover"><img src="{{selectedDomain.visuals.bannerImg}}" alt="Imagem de {{selectedDomain.name}}" /></div>
                <figcaption><span class="dm-kicker">DOMÍNIO ATUAL</span><strong>{{selectedDomain.name}}</strong><small>{{selectedDomain.presetLabel}} · {{selectedDomain.stateLabel}}</small></figcaption>
              </figure>
            {{/if}}{{/if}}
            <div class="dm-overview-grid">
              <section class="dm-domain-core">
                <header class="dm-module-header"><div><span>01</span><div><small>DOMÍNIO</small><strong>Estado Operacional</strong></div></div><em>{{selectedDomain.stateLabel}}</em></header>
                <div class="dm-domain-core__body">
                  <div class="dm-core-gauge"><div class="dm-core-gauge__rings"><i></i><i></i><i></i></div><span>{{telemetry.conditions}}</span><small>CONDIÇÕES</small></div>
                  <div class="dm-core-matrix">
                    <div><small>POPULAÇÃO</small><strong>{{telemetry.population}}</strong><span>REGISTRADA</span></div>
                    <div><small>RECURSOS</small><strong>{{telemetry.resourceKinds}}</strong><span>TIPOS</span></div>
                    <div><small>PROJETOS</small><strong>{{telemetry.activeProjects}}</strong><span>ATIVOS</span></div>
                    <div><small>MISSÕES</small><strong>{{telemetry.activeMissions}}</strong><span>ACOMPANHADAS</span></div>
                    <div><small>FORÇAS</small><strong>{{telemetry.readySquads}}</strong><span>PRONTAS</span></div>
                    <div><small>ATIVOS</small><strong>{{telemetry.operationalStructures}}</strong><span>ATIVOS</span></div>
                  </div>
                </div>
              </section>
              <section class="dm-flow-board">
                <header class="dm-module-header"><div><span>02</span><div><small>RECURSOS</small><strong>Fluxo de Recursos</strong></div></div><button class="dm-text-button" type="button" data-action="navigate" data-view="economy">ABRIR RECURSOS</button></header>
                <div class="dm-flow-board__rows">{{#each resources}}<div class="dm-flow-channel"><span><strong>{{name}}</strong><small>{{availableDisplay}} DISPONÍVEL</small></span><i></i><em class="dm-flow dm-flow--{{tone}}">{{netPerTickDisplay}} /T</em></div>{{else}}<div class="dm-empty-signal">NENHUM RECURSO CADASTRADO</div>{{/each}}</div>
              </section>
              <section class="dm-alert-console">
                <header class="dm-module-header"><div><span>03</span><div><small>CONDIÇÕES</small><strong>Alertas</strong></div></div><em>{{activeConditions.length}}</em></header>
                <div class="dm-alert-console__feed">{{#each activeConditions}}<div class="dm-alert-signal dm-alert-signal--{{tone}}"><i class="fa-solid fa-triangle-exclamation"></i><span><strong>{{label}}</strong><small>{{description}}</small></span></div>{{else}}<div class="dm-nominal-stamp"><i class="fa-solid fa-check"></i><span>NORMAL</span><small>NENHUMA CONDIÇÃO ATIVA</small></div>{{/each}}</div>
              </section>
              <section class="dm-active-ops-strip">
                <header><span class="dm-kicker">OPERAÇÕES ATIVAS</span><strong>{{missions.length}}</strong></header>
                <div>{{#each missions}}<span class="dm-op-chip dm-op-chip--{{tone}}"><i></i><strong>{{name}}</strong><small>{{statusLabel}}</small></span>{{else}}<span class="dm-muted">Nenhuma missão em andamento.</span>{{/each}}</div>
              </section>
            </div>
          </section>
        {{/if}}

        {{#if view.requests}}
          <section class="dm-view dm-view--requests dm-page--forensic">
            <header class="dm-view-header"><div><span class="dm-kicker">GESTÃO // SOLICITAÇÕES</span><h2>Solicitações</h2><p>Pedidos formais entre responsáveis do domínio e o GM.</p></div><div class="dm-view-header__actions"><span class="dm-view-code">{{requests.length}} VISÍVEIS</span>{{#if canCreateRequest}}<button type="button" class="dm-action-button" data-action="openRequestCreate"><i class="fa-solid fa-paper-plane"></i> NOVA SOLICITAÇÃO</button>{{/if}}</div></header>
            <section class="dm-request-board">
              <header><span>SOLICITAÇÃO</span><span>TIPO</span><span>SOLICITANTE</span><span>ESTADO</span><span>ENCAMINHAMENTO</span></header>
              {{#each requests}}
                <button type="button" class="dm-request-row {{#if selected}}is-selected{{/if}}" data-action="selectRequest" data-request-uuid="{{uuid}}">
                  <span class="dm-request-row__identity"><i class="dm-status-pip dm-status-pip--{{tone}}"></i><span><strong>{{name}}</strong><small>{{entityId}}</small></span></span>
                  <span>{{typeLabel}}</span><span>{{requesterName}}</span><span><em class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</em></span><span>{{handlingLabel}}</span>
                </button>
              {{else}}<div class="dm-empty"><i class="fa-solid fa-inbox"></i><strong>NENHUMA SOLICITAÇÃO VISÍVEL</strong><span>Nenhuma solicitação visível para este operador.</span>{{#if canCreateRequest}}<button type="button" class="dm-action-button" data-action="openRequestCreate">NOVA SOLICITAÇÃO</button>{{/if}}</div>{{/each}}
            </section>
          </section>
        {{/if}}

        {{#if view.conditions}}
          <section class="dm-view dm-view--conditions dm-page--forensic">
            <header class="dm-view-header"><div><span class="dm-kicker">GESTÃO // CONDIÇÕES</span><h2>Condições</h2><p>Efeitos temporários, alertas persistentes e fatores que afetam este domínio.</p></div><div class="dm-view-header__actions"><span class="dm-view-code">{{conditionStats.active}} ATIVA(S)</span>{{#if canManageConditions}}<button type="button" class="dm-action-button" data-action="openConditionEditor" data-condition-id="__new__"><i class="fa-solid fa-plus"></i> NOVA CONDIÇÃO</button>{{/if}}</div></header>
            <section class="dm-condition-summary">
              <span><small>TOTAL</small><strong>{{conditionStats.total}}</strong><em>registros</em></span>
              <span><small>ATIVAS</small><strong>{{conditionStats.active}}</strong><em>afetando o domínio</em></span>
              <span><small>GRAVES</small><strong>{{conditionStats.severe}}</strong><em>alertas prioritários</em></span>
              <span><small>COM PRAZO</small><strong>{{conditionStats.finite}}</strong><em>duração definida</em></span>
              <span><small>INDEFINIDAS</small><strong>{{conditionStats.indefinite}}</strong><em>sem expiração</em></span>
            </section>
            <section class="dm-condition-board">
              <header><span>CONDIÇÃO</span><span>GRAVIDADE</span><span>CATEGORIA</span><span>DURAÇÃO</span><span>ESTADO</span><span>AÇÕES</span></header>
              {{#each conditions}}
                <article class="dm-condition-row {{#unless active}}is-inactive{{/unless}}">
                  <span class="dm-condition-row__identity"><i class="dm-status-pip dm-status-pip--{{tone}}"></i><span><strong>{{name}}</strong><small>{{#if description}}{{description}}{{else}}Sem descrição adicional{{/if}}</small></span></span>
                  <span><em class="dm-chip dm-chip--{{tone}}">{{severityLabel}}</em></span>
                  <span>{{categoryLabel}}</span><span>{{durationLabel}}</span><span><strong>{{stateLabel}}</strong></span>
                  <span class="dm-condition-row__actions">{{#if ../canManageConditions}}<button type="button" class="dm-icon-button" data-action="toggleCondition" data-condition-id="{{localId}}" title="{{#if active}}Desativar{{else}}Ativar{{/if}} condição"><i class="fa-solid {{#if active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></button><button type="button" class="dm-icon-button" data-action="openConditionEditor" data-condition-id="{{localId}}" title="Editar condição"><i class="fa-solid fa-pen"></i></button><button type="button" class="dm-icon-button dm-icon-button--danger" data-action="removeCondition" data-condition-id="{{localId}}" title="Remover condição"><i class="fa-solid fa-trash"></i></button>{{else}}<span>SOMENTE LEITURA</span>{{/if}}</span>
                </article>
              {{else}}<div class="dm-empty"><i class="fa-solid fa-shield-check"></i><strong>NENHUMA CONDIÇÃO CADASTRADA</strong><span>O domínio não possui efeitos ou alertas registrados.</span>{{#if canManageConditions}}<button type="button" class="dm-action-button" data-action="openConditionEditor" data-condition-id="__new__">CRIAR PRIMEIRA CONDIÇÃO</button>{{/if}}</div>{{/each}}
            </section>
          </section>
        {{/if}}

        {{#if view.economy}}
          <section class="dm-view dm-view--economy">
            <header class="dm-view-header"><div><span class="dm-kicker">BASE // RECURSOS</span><h2>Recursos</h2><p>Estoque, reservas, produção, consumo e capacidade do domínio.</p></div><div class="dm-view-header__actions"><span class="dm-view-code">{{telemetry.activeFlows}} FLUXO(S)</span>{{#if canConfigureEconomy}}<button type="button" class="dm-action-button" data-action="openEconomyConfig"><i class="fa-solid fa-sliders"></i> CONFIGURAR</button>{{/if}}</div></header>
            <div class="dm-economy-scope">
              <section class="dm-resource-matrix-live dm-resource-matrix-live--strategic">
