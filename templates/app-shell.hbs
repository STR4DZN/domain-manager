<div class="dm-os">
  <header class="dm-topbar">
    <div class="dm-topbar__brand">
      <div class="dm-brand-mark" aria-hidden="true"><span></span><span></span><span></span></div>
      <div>
        <div class="dm-kicker">STRATEGIC OPERATIONS SYSTEM</div>
        <div class="dm-title">DOMAIN MANAGER</div>
      </div>
    </div>

    <div class="dm-topbar__context">
      {{#if selectedDomain}}
        <span class="dm-context-id">NODE // {{selectedDomain.entityIdShort}}</span>
        <span class="dm-context-name">{{selectedDomain.name}}</span>
        <span class="dm-chip dm-chip--{{selectedDomain.stateTone}}">{{selectedDomain.stateLabel}}</span>
      {{else}}
        <span class="dm-context-id">GLOBAL // COMMAND</span>
        <span class="dm-context-name">Visão estratégica</span>
      {{/if}}
    </div>

    <div class="dm-topbar__system">
      <span class="dm-sysdot {{#if authorityReady}}is-online{{else}}is-offline{{/if}}"></span>
      <span>AUTH {{system.authority}}</span>
      <span class="dm-divider-vert"></span>
      <span>{{system.primary}}</span>
      <span class="dm-divider-vert"></span>
      <span>v{{appVersion}}</span>
    </div>
  </header>

  <div class="dm-frame">
    <nav class="dm-command-rail" aria-label="Navegação global">
      <div class="dm-command-rail__top">
        {{#each globalNav}}
          <button class="dm-rail-button {{#if active}}is-active{{/if}}" type="button" data-action="navigate" data-view="{{id}}" title="{{label}}">
            <i class="{{icon}}"></i>
            <span>{{label}}</span>
          </button>
        {{/each}}
      </div>
      <div class="dm-command-rail__bottom">
        <div class="dm-rail-readout">
          <span class="dm-rail-readout__label">DOM</span>
          <strong>{{domainCount}}</strong>
        </div>
        <div class="dm-rail-readout">
          <span class="dm-rail-readout__label">OPS</span>
          <strong>{{globalCounts.missions}}</strong>
        </div>
      </div>
    </nav>

    <aside class="dm-entity-deck">
      <div class="dm-entity-deck__header">
        <div>
          <span class="dm-kicker">ENTITY DECK</span>
          <strong>Domínios</strong>
        </div>
        {{#if isGM}}
          <button class="dm-icon-button" type="button" data-action="openCreateDomain" title="Novo domínio">
            <i class="fa-solid fa-plus"></i>
          </button>
        {{/if}}
      </div>

      <div class="dm-searchbar">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input data-dm-search type="search" value="{{searchQuery}}" placeholder="Buscar domínio, tag ou categoria..." />
        {{#if searchQuery}}
          <button type="button" data-action="clearSearch" title="Limpar busca"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <button type="button" data-action="applySearch" title="Buscar"><i class="fa-solid fa-arrow-right"></i></button>
        {{/if}}
      </div>

      <div class="dm-entity-deck__list">
        {{#each domains}}
          <button class="dm-domain-node {{#if selected}}is-selected{{/if}}" type="button" data-action="selectDomain" data-uuid="{{uuid}}">
            <span class="dm-domain-node__rail"></span>
            <span class="dm-domain-node__main">
              <span class="dm-domain-node__topline">
                <strong>{{name}}</strong>
                <span class="dm-chip dm-chip--{{stateTone}}">{{state}}</span>
              </span>
              <span class="dm-domain-node__meta">{{category}} · {{preset}}</span>
              <span class="dm-domain-node__telemetry">
                <span><i class="fa-solid fa-users"></i>{{population}}</span>
                <span><i class="fa-solid fa-user-shield"></i>{{controllers}}</span>
              </span>
            </span>
          </button>
        {{else}}
          <div class="dm-empty dm-empty--compact">
            <i class="fa-solid fa-satellite"></i>
            <strong>Nenhum domínio visível</strong>
            <span>{{#if isGM}}Crie o primeiro node estratégico.{{else}}Aguarde um domínio ser atribuído a você.{{/if}}</span>
          </div>
        {{/each}}
      </div>

      <div class="dm-entity-deck__footer">
        <span>{{domainCount}} NODE(S)</span>
        <span>INDEX // LIVE</span>
      </div>
    </aside>

    <main class="dm-app__workspace">
      {{#if selectedDomain}}
        <section class="dm-domain-commandbar">
          <div class="dm-domain-commandbar__identity">
            <span class="dm-kicker">{{selectedDomain.category}} // {{selectedDomain.presetLabel}}</span>
            <h1>{{selectedDomain.name}}</h1>
            <p>{{#if selectedDomain.description}}{{selectedDomain.description}}{{else}}Sem descrição operacional registrada.{{/if}}</p>
          </div>
          <div class="dm-domain-commandbar__metrics">
            <div class="dm-mini-stat"><span>POP</span><strong>{{telemetry.population}}</strong></div>
            <div class="dm-mini-stat"><span>RES</span><strong>{{telemetry.resourceKinds}}</strong></div>
            <div class="dm-mini-stat"><span>OPS</span><strong>{{telemetry.activeMissions}}</strong></div>
            <div class="dm-mini-stat"><span>COND</span><strong>{{telemetry.conditions}}</strong></div>
          </div>
        </section>

        <nav class="dm-domain-tabs" aria-label="Módulos do domínio">
          {{#each domainNav}}
            <button type="button" class="dm-domain-tab {{#if active}}is-active{{/if}}" data-action="navigate" data-view="{{id}}">
              <i class="{{icon}}"></i><span>{{label}}</span>
            </button>
          {{/each}}
        </nav>
      {{/if}}

      <div class="dm-app__workspace-scroll">
        {{#if view.command}}
          <section class="dm-page dm-page--command">
            <div class="dm-page-heading">
              <div>
                <span class="dm-kicker">GLOBAL COMMAND // LIVE STATE</span>
                <h2>Visão Estratégica</h2>
                <p>Leitura consolidada do ecossistema operacional.</p>
              </div>
              <div class="dm-heading-code">SYS.01 / NOMINAL</div>
            </div>

            <div class="dm-stat-grid dm-stat-grid--five">
              <article class="dm-stat"><span class="dm-stat__label">DOMÍNIOS</span><strong>{{globalCounts.domains}}</strong><span class="dm-stat__meta">nodes indexados</span></article>
              <article class="dm-stat"><span class="dm-stat__label">PROJETOS</span><strong>{{globalCounts.projects}}</strong><span class="dm-stat__meta">registros globais</span></article>
              <article class="dm-stat"><span class="dm-stat__label">MISSÕES</span><strong>{{globalCounts.missions}}</strong><span class="dm-stat__meta">operações rastreadas</span></article>
              <article class="dm-stat"><span class="dm-stat__label">SQUADS</span><strong>{{globalCounts.squads}}</strong><span class="dm-stat__meta">unidades registradas</span></article>
              <article class="dm-stat"><span class="dm-stat__label">ESTRUTURAS</span><strong>{{globalCounts.structures}}</strong><span class="dm-stat__meta">ativos físicos</span></article>
            </div>

            <div class="dm-grid dm-grid--command">
              <section class="dm-panel dm-panel--primary">
                <header class="dm-panel__header"><div><span class="dm-kicker">NODE MATRIX</span><h3>Domínios em foco</h3></div><span>{{domainCount}} total</span></header>
                <div class="dm-node-matrix">
                  {{#each domains}}
                    <button class="dm-node-card {{#if selected}}is-selected{{/if}}" type="button" data-action="selectDomain" data-uuid="{{uuid}}">
                      <span class="dm-node-card__id">{{category}}</span>
                      <strong>{{name}}</strong>
                      <span class="dm-node-card__description">{{#if description}}{{description}}{{else}}Sem briefing.{{/if}}</span>
                      <span class="dm-node-card__bottom"><span class="dm-chip dm-chip--{{stateTone}}">{{state}}</span><span>{{population}} pop</span></span>
                    </button>
                  {{/each}}
                </div>
              </section>

              <section class="dm-panel">
                <header class="dm-panel__header"><div><span class="dm-kicker">OPERATIONS FEED</span><h3>Missões</h3></div><span>{{globalCounts.missions}}</span></header>
                <div class="dm-list">
                  {{#each allMissions}}
                    <div class="dm-list-row"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{name}}</strong><span>{{statusLabel}}</span></div><span class="dm-row-code">{{entityId}}</span></div>
                  {{else}}
                    <div class="dm-empty dm-empty--compact"><i class="fa-solid fa-crosshairs"></i><strong>Sem missões</strong><span>Operações futuras aparecerão aqui.</span></div>
                  {{/each}}
                </div>
              </section>
            </div>
          </section>
        {{/if}}

        {{#if view.domains}}
          <section class="dm-page">
            <div class="dm-page-heading"><div><span class="dm-kicker">ENTITY REGISTRY</span><h2>Domínios</h2><p>Registro mestre de entidades estratégicas.</p></div>{{#if isGM}}<button class="dm-action-button" type="button" data-action="openCreateDomain"><i class="fa-solid fa-plus"></i> NOVO DOMÍNIO</button>{{/if}}</div>
            <section class="dm-panel">
              <div class="dm-table dm-table--domains">
                <div class="dm-table__head"><span>NODE</span><span>TIPO</span><span>PRESET</span><span>POPULAÇÃO</span><span>ESTADO</span></div>
                {{#each domains}}
                  <button type="button" class="dm-table__row {{#if selected}}is-selected{{/if}}" data-action="selectDomain" data-uuid="{{uuid}}"><span><strong>{{name}}</strong><small>{{entityId}}</small></span><span>{{category}}</span><span>{{preset}}</span><span>{{population}}</span><span><span class="dm-chip dm-chip--{{stateTone}}">{{state}}</span></span></button>
                {{/each}}
              </div>
            </section>
          </section>
        {{/if}}

        {{#if view.operations}}
          <section class="dm-page">
            <div class="dm-page-heading"><div><span class="dm-kicker">OPERATIONAL LAYER</span><h2>Operações</h2><p>Missões, squads e projetos em uma única leitura operacional.</p></div><div class="dm-heading-code">OPS / CONSOLIDATED</div></div>
            <div class="dm-grid dm-grid--3">
              <section class="dm-panel"><header class="dm-panel__header"><h3>Missões</h3><span>{{globalCounts.missions}}</span></header><div class="dm-list">{{#each allMissions}}<div class="dm-list-row"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{name}}</strong><span>{{statusLabel}}</span></div></div>{{else}}<div class="dm-empty dm-empty--compact"><strong>Nenhuma missão</strong></div>{{/each}}</div></section>
              <section class="dm-panel"><header class="dm-panel__header"><h3>Squads</h3><span>{{globalCounts.squads}}</span></header><div class="dm-list">{{#each allSquads}}<div class="dm-list-row"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{name}}</strong><span>{{statusLabel}}</span></div></div>{{else}}<div class="dm-empty dm-empty--compact"><strong>Nenhum squad</strong></div>{{/each}}</div></section>
              <section class="dm-panel"><header class="dm-panel__header"><h3>Projetos</h3><span>{{globalCounts.projects}}</span></header><div class="dm-list">{{#each allProjects}}<div class="dm-list-row"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{name}}</strong><span>{{statusLabel}}</span></div></div>{{else}}<div class="dm-empty dm-empty--compact"><strong>Nenhum projeto</strong></div>{{/each}}</div></section>
            </div>
          </section>
        {{/if}}

        {{#if view.system}}
          <section class="dm-page">
            <div class="dm-page-heading"><div><span class="dm-kicker">SYSTEM CONTROL</span><h2>Kernel & Autoridade</h2><p>Estado técnico, simulação e diagnóstico do módulo.</p></div><div class="dm-chip dm-chip--{{system.authorityTone}}">{{system.authority}}</div></div>
            <div class="dm-grid dm-grid--system">
              <section class="dm-panel dm-panel--primary"><header class="dm-panel__header"><h3>Authority Matrix</h3><span>LIVE</span></header><div class="dm-readout-grid"><div class="dm-data-row"><span>ROLE</span><strong>{{system.primary}}</strong></div><div class="dm-data-row"><span>ACTIVE GM</span><strong>{{system.activeGM}}</strong></div><div class="dm-data-row"><span>SOCKET</span><strong>{{system.authority}}</strong></div><div class="dm-data-row"><span>TIME PROVIDER</span><strong>{{system.timeProvider}}</strong></div></div></section>
              {{#if isGM}}
                <section class="dm-panel"><header class="dm-panel__header"><h3>Simulation Advance</h3><span>PRIMARY GM ONLY</span></header><p class="dm-panel-copy">Avança o kernel determinístico. A persistência oficial bloqueia GMs secundários.</p><div class="dm-action-strip"><button class="dm-action-button" type="button" data-action="advanceTicks" data-ticks="1">+1 TICK</button><button class="dm-action-button dm-action-button--secondary" type="button" data-action="advanceTicks" data-ticks="7">+7</button><button class="dm-action-button dm-action-button--secondary" type="button" data-action="advanceTicks" data-ticks="30">+30</button></div></section>
              {{/if}}
            </div>
          </section>
        {{/if}}

        {{#if view.overview}}
          <section class="dm-page">
            <div class="dm-page-heading"><div><span class="dm-kicker">DOMAIN // OVERVIEW</span><h2>{{selectedDomain.name}}</h2><p>Diagnóstico operacional consolidado do node.</p></div><div class="dm-heading-code">{{selectedDomain.natureLabel}} / {{selectedDomain.stateLabel}}</div></div>
            <div class="dm-stat-grid dm-stat-grid--four">
              <article class="dm-stat"><span class="dm-stat__label">POPULAÇÃO</span><strong>{{telemetry.population}}</strong><span class="dm-stat__meta">residentes / membros</span></article>
              <article class="dm-stat"><span class="dm-stat__label">RECURSOS</span><strong>{{telemetry.resourceKinds}}</strong><span class="dm-stat__meta">classes em estoque</span></article>
              <article class="dm-stat"><span class="dm-stat__label">PROJETOS</span><strong>{{telemetry.activeProjects}}</strong><span class="dm-stat__meta">ativos / bloqueados</span></article>
              <article class="dm-stat"><span class="dm-stat__label">MISSÕES</span><strong>{{telemetry.activeMissions}}</strong><span class="dm-stat__meta">rastreadas</span></article>
            </div>
            <div class="dm-grid dm-grid--overview">
              <section class="dm-panel dm-panel--primary"><header class="dm-panel__header"><div><span class="dm-kicker">RESOURCE SNAPSHOT</span><h3>Logística</h3></div><button class="dm-text-button" type="button" data-action="navigate" data-view="economy">ABRIR ECONOMIA</button></header><div class="dm-resource-preview">{{#each resources}}<div class="dm-resource-preview__row"><div><strong>{{name}}</strong><span>{{availableDisplay}} disponível</span></div><span class="dm-flow dm-flow--{{tone}}">{{netPerTickDisplay}} / t</span></div>{{else}}<div class="dm-empty dm-empty--compact"><strong>Sem recursos catalogados</strong><span>O catálogo global ainda está vazio.</span></div>{{/each}}</div></section>
              <section class="dm-panel"><header class="dm-panel__header"><div><span class="dm-kicker">ACTIVE CONDITIONS</span><h3>Condições</h3></div><span>{{telemetry.conditions}}</span></header><div class="dm-list">{{#each conditions}}<div class="dm-alert-row dm-alert-row--{{tone}}"><i class="fa-solid fa-triangle-exclamation"></i><div><strong>{{name}}</strong><span>{{description}}</span></div></div>{{else}}<div class="dm-empty dm-empty--compact"><i class="fa-solid fa-circle-check"></i><strong>Nenhuma condição ativa</strong><span>Node em estado nominal.</span></div>{{/each}}</div></section>
              <section class="dm-panel"><header class="dm-panel__header"><div><span class="dm-kicker">CAPABILITY MAP</span><h3>Módulos ativos</h3></div></header><div class="dm-chip-cloud">{{#each selectedDomain.capabilities}}<span class="dm-chip dm-chip--neutral">{{this}}</span>{{/each}}</div><div class="dm-readout-grid dm-readout-grid--compact"><div class="dm-data-row"><span>PROFILE</span><strong>{{selectedDomain.presetLabel}}</strong></div><div class="dm-data-row"><span>STATE</span><strong>{{selectedDomain.stateLabel}}</strong></div>{{#each controllers}}<div class="dm-data-row"><span>CTRL</span><strong>{{this}}</strong></div>{{/each}}</div></section>
            </div>
          </section>
        {{/if}}

        {{#if view.economy}}
          <section class="dm-page">
            <div class="dm-page-heading"><div><span class="dm-kicker">LOGISTICS // ECONOMY</span><h2>Recursos & Fluxos</h2><p>Estoque, reservas, tendência e autonomia.</p></div><div class="dm-heading-code">{{telemetry.activeFlows}} FLOW(S) ACTIVE</div></div>
            <section class="dm-panel dm-panel--primary">
              <div class="dm-table dm-table--economy">
                <div class="dm-table__head"><span>RECURSO</span><span>ESTOQUE</span><span>RESERVADO</span><span>DISPONÍVEL</span><span>FLUXO / T</span><span>AUTONOMIA</span></div>
                {{#each resources}}
                  <div class="dm-table__row"><span><strong>{{name}}</strong><small>{{resourceId}}</small></span><span>{{stockDisplay}}</span><span>{{reservedDisplay}}</span><span>{{availableDisplay}}</span><span><span class="dm-flow dm-flow--{{tone}}">{{netPerTickDisplay}}</span></span><span>{{runway}}</span></div>
                {{else}}
                  <div class="dm-empty"><i class="fa-solid fa-box-open"></i><strong>Nenhum recurso configurado</strong><span>O catálogo global de recursos está vazio ou este Domain ainda não possui estoques.</span></div>
                {{/each}}
              </div>
            </section>
          </section>
        {{/if}}

        {{#if view.population}}
          <section class="dm-page">
            <div class="dm-page-heading"><div><span class="dm-kicker">DEMOGRAPHICS // POPULATION</span><h2>População</h2><p>Composição e grupos agregados do domínio.</p></div><div class="dm-heading-code">TOTAL {{domainData.population.total}}</div></div>
            <div class="dm-stat-grid dm-stat-grid--three"><article class="dm-stat"><span class="dm-stat__label">TOTAL</span><strong>{{domainData.population.total}}</strong><span class="dm-stat__meta">modo {{domainData.population.countMode}}</span></article><article class="dm-stat"><span class="dm-stat__label">GRUPOS</span><strong>{{domainData.population.groups.length}}</strong><span class="dm-stat__meta">segmentos</span></article><article class="dm-stat"><span class="dm-stat__label">NOTÁVEIS</span><strong>{{people.length}}</strong><span class="dm-stat__meta">identidades rastreadas</span></article></div>
            <section class="dm-panel"><header class="dm-panel__header"><h3>Grupos</h3></header><div class="dm-table dm-table--population"><div class="dm-table__head"><span>GRUPO</span><span>CONTAGEM</span><span>FUNÇÃO</span><span>QUALIDADE</span><span>STATUS</span></div>{{#each domainData.population.groups}}<div class="dm-table__row"><span><strong>{{name}}</strong></span><span>{{count}}</span><span>{{function}}</span><span>{{quality}}</span><span>{{status}}</span></div>{{else}}<div class="dm-empty"><strong>Nenhum grupo populacional</strong><span>Use grupos quando precisar administrar população agregada.</span></div>{{/each}}</div></section>
          </section>
        {{/if}}

        {{#if view.people}}
          <section class="dm-page dm-page--forensic">
            <div class="dm-page-heading"><div><span class="dm-kicker">IDENTITY // PERSONNEL</span><h2>Pessoas</h2><p>Dossiês, especialistas e indivíduos notáveis.</p></div><div class="dm-heading-code">{{people.length}} IDENTITY RECORD(S)</div></div>
            <div class="dm-person-grid">
              {{#each people}}
                <article class="dm-person-card">
                  <div class="dm-person-card__portrait">{{#if portrait}}<img src="{{portrait}}" alt="" />{{else}}<i class="fa-solid fa-user-secret"></i>{{/if}}<span class="dm-scan-corner"></span></div>
                  <div class="dm-person-card__body"><span class="dm-kicker">IDENTITY RECORD</span><h3>{{name}}</h3><p>{{role}}</p><span>{{specialization}}</span><div class="dm-person-card__footer"><span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span><span class="dm-row-code">{{uuid}}</span></div></div>
                </article>
              {{else}}
                <div class="dm-empty"><i class="fa-solid fa-user-plus"></i><strong>Nenhuma identidade registrada</strong><span>Personagens notáveis e especialistas aparecerão aqui.</span></div>
              {{/each}}
            </div>
          </section>
        {{/if}}

        {{#if view.structures}}
          <section class="dm-page dm-page--structures dm-page--infrastructure">
            <div class="dm-page-heading">
              <div>
                <span class="dm-kicker">INFRASTRUCTURE CONTROL // PHYSICAL ASSETS</span>
                <h2>Infrastructure Control</h2>
                <p>Construção, condição, capacidade e vetores econômicos dos ativos físicos do Domain.</p>
              </div>
              <div class="dm-page-heading__actions">
                <div class="dm-heading-code">{{structures.length}} ASSET(S)</div>
                {{#if canBeginStructureConstruction}}<button type="button" class="dm-action-button dm-action-button--compact" data-action="openCreateStructure" data-mode="construction"><i class="fa-solid fa-compass-drafting"></i> NOVA CONSTRUÇÃO</button>{{/if}}
                {{#if canRegisterStructure}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openCreateStructure" data-mode="direct"><i class="fa-solid fa-building-circle-check"></i> REGISTRAR ATIVO</button>{{/if}}
              </div>
            </div>

            <div class="dm-infra-summary">
              <div><span>INDEXED</span><strong>{{structureStats.total}}</strong></div>
              <div><span>OPERATIONAL</span><strong>{{structureStats.operational}}</strong></div>
              <div><span>PLANNED</span><strong>{{structureStats.planned}}</strong></div>
              <div><span>DAMAGED</span><strong>{{structureStats.damaged}}</strong></div>
              <div><span>OFFLINE</span><strong>{{structureStats.disabled}}</strong></div>
            </div>

            <div class="dm-infrastructure-grid">
              {{#each structures}}
                <article class="dm-infrastructure-card dm-infrastructure-card--{{status}}">
                  <header class="dm-infrastructure-card__header">
                    <div><span class="dm-kicker">ASSET // {{category}}</span><span class="dm-row-code">{{entityId}}</span></div>
                    <span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span>
                  </header>
                  <div class="dm-infrastructure-card__title">
                    <div><h3>{{name}}</h3>{{#if description}}<p>{{description}}</p>{{else}}<p class="dm-muted">Sem descrição técnica.</p>{{/if}}</div>
                    <div class="dm-infrastructure-card__tier"><small>TIER</small><strong>{{tier}}</strong><span>/ {{maxTier}}</span></div>
                  </div>
                  <div class="dm-infrastructure-card__condition">
                    <div><span>STRUCTURAL CONDITION</span><strong>{{conditionDisplay}}</strong></div>
                    <div class="dm-meter">{{#each conditionSegments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div>
                  </div>
                  <div class="dm-infrastructure-card__telemetry">
                    <span><small>CAPACITY</small><strong>{{capacity}}</strong></span>
                    <span><small>MAINT. LINES</small><strong>{{maintenance.length}}</strong></span>
                    <span><small>OUTPUT LINES</small><strong>{{production.length}}</strong></span>
                  </div>
                  <div class="dm-infrastructure-vectors">
                    <section><header><span>MAINTENANCE / TICK</span><i class="fa-solid fa-arrow-trend-down"></i></header>{{#each maintenance}}<div><span>{{name}}</span><strong>-{{displayAmount}} {{unit}}</strong></div>{{else}}<div class="dm-muted">Nenhuma manutenção recorrente.</div>{{/each}}</section>
                    <section><header><span>PRODUCTION / TICK</span><i class="fa-solid fa-arrow-trend-up"></i></header>{{#each production}}<div><span>{{name}}</span><strong>+{{displayAmount}} {{unit}}</strong></div>{{else}}<div class="dm-muted">Nenhuma produção recorrente.</div>{{/each}}</section>
                  </div>
                  {{#if project}}
                    <div class="dm-construction-link">
                      <header><span class="dm-kicker">LINKED PROJECT</span><span class="dm-chip dm-chip--{{project.tone}}">{{project.statusLabel}}</span></header>
                      <div><strong>{{project.name}}</strong><span>{{project.progressDisplay}}</span></div>
                      <div class="dm-meter">{{#each project.segments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div>
                    </div>
                  {{/if}}
                  <footer class="dm-infrastructure-card__footer">
                    <span>{{#if tags.length}}{{#each tags}}<span class="dm-mini-tag">{{this}}</span>{{/each}}{{else}}<span class="dm-muted">NO TAGS</span>{{/if}}</span>
                    {{#if canOperate}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openStructureControl" data-structure-uuid="{{uuid}}"><i class="fa-solid fa-sliders"></i> CONTROLE</button>{{else}}{{#if canAdmin}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openStructureControl" data-structure-uuid="{{uuid}}"><i class="fa-solid fa-screwdriver-wrench"></i> ADMIN</button>{{/if}}{{/if}}
                  </footer>
                </article>
              {{else}}
                <div class="dm-empty dm-empty--infrastructure">
                  <i class="fa-solid fa-city"></i>
                  <strong>Nenhum ativo físico indexado</strong>
                  <span>Inicie uma construção para criar Structure + Project vinculados, ou registre um ativo existente como GM.</span>
                  {{#if canBeginStructureConstruction}}<button type="button" class="dm-action-button" data-action="openCreateStructure" data-mode="construction">INICIAR PRIMEIRA CONSTRUÇÃO</button>{{/if}}
                </div>
              {{/each}}
            </div>
          </section>
        {{/if}}

        {{#if view.projects}}
          <section class="dm-page"><div class="dm-page-heading"><div><span class="dm-kicker">ENGINEERING // PROJECTS</span><h2>Projetos</h2><p>Transformações persistentes e progresso financiado.</p></div><div class="dm-heading-code">{{projects.length}} PROJECT(S)</div></div><div class="dm-card-grid">{{#each projects}}<article class="dm-project-card"><header><span class="dm-kicker">PROJECT</span><span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span></header><h3>{{name}}</h3><p>{{description}}</p><div class="dm-meter">{{#each segments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div><footer><span>PROGRESS</span><strong>{{progressDisplay}}</strong></footer></article>{{else}}<div class="dm-empty"><i class="fa-solid fa-diagram-project"></i><strong>Nenhum projeto</strong><span>Projetos ativos e planejados aparecerão aqui.</span></div>{{/each}}</div></section>
        {{/if}}

        {{#if view.squads}}
          <section class="dm-page dm-page--force-control">
            <div class="dm-page-heading">
              <div>
                <span class="dm-kicker">FORCE CONTROL // OPERATIONAL UNITS</span>
                <h2>Esquadrões</h2>
                <p>Efetivo, prontidão, operadores e vínculo de missão em uma única malha operacional.</p>
              </div>
              <div class="dm-page-heading__actions">
                <div class="dm-heading-code">{{squads.length}} UNIT(S)</div>
                {{#if canCreateSquad}}
                  <button type="button" class="dm-action-button dm-action-button--compact" data-action="openCreateSquad"><i class="fa-solid fa-plus"></i> NOVA UNIDADE</button>
                {{/if}}
              </div>
            </div>

            <div class="dm-force-summary">
              <div><span>UNITS INDEXED</span><strong>{{squads.length}}</strong></div>
              <div><span>DOMAIN NODE</span><strong>{{selectedDomain.name}}</strong></div>
              <div><span>AUTHORITY</span><strong>{{system.primary}}</strong></div>
              <div><span>OPERATIONS</span><strong>{{telemetry.activeMissions}}</strong></div>
            </div>

            <div class="dm-card-grid dm-card-grid--squads">
              {{#each squads}}
                <article class="dm-squad-card {{#if controlledByMe}}is-controlled{{/if}}">
                  <header>
                    <div><span class="dm-kicker">UNIT // {{entityIdShort}}</span><span class="dm-squad-card__operator">{{controllerLabel}}</span></div>
                    <span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span>
                  </header>
                  <h3>{{name}}</h3>
                  {{#if description}}<p class="dm-squad-card__description">{{description}}</p>{{else}}<p class="dm-squad-card__description dm-muted">Sem briefing operacional.</p>{{/if}}
                  <div class="dm-squad-strength"><strong>{{strength}}</strong><span>/ {{capacity}} EFETIVO</span></div>
                  <div class="dm-dual-meter">
                    <div><span>MORAL</span><div class="dm-meter">{{#each moraleSegments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div><strong>{{moraleDisplay}}</strong></div>
                    <div><span>CONDIÇÃO</span><div class="dm-meter">{{#each conditionSegments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div><strong>{{conditionDisplay}}</strong></div>
                  </div>
                  <div class="dm-squad-telemetry">
                    <span><small>MISSION</small><strong>{{currentMissionName}}</strong></span>
                    <span><small>SUPPLY</small><strong>{{resourceKinds}}</strong></span>
                    <span><small>LOADOUT</small><strong>{{equipmentKinds}}</strong></span>
                    <span><small>GROUPS</small><strong>{{compositionGroups}}</strong></span>
                  </div>
                  <footer class="dm-squad-card__footer">
                    <span class="dm-row-code">{{entityId}}</span>
                    <div class="dm-squad-card__actions">
                      {{#if canUseSupply}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openSquadSupply" data-uuid="{{uuid}}"><i class="fa-solid fa-boxes-stacked"></i> SUPPLY</button>{{/if}}
                      {{#if canOperate}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openSquadControl" data-uuid="{{uuid}}"><i class="fa-solid fa-sliders"></i> CONTROLE</button>{{/if}}
                    </div>
                  </footer>
                </article>
              {{else}}
                <div class="dm-empty dm-empty--force">
                  <i class="fa-solid fa-person-military-rifle"></i>
                  <strong>Nenhuma unidade operacional</strong>
                  <span>Crie um Squad, atribua operadores e use esta área como console de força do Domain.</span>
                  {{#if canCreateSquad}}<button type="button" class="dm-action-button" data-action="openCreateSquad">CRIAR PRIMEIRO SQUAD</button>{{/if}}
                </div>
              {{/each}}
            </div>
          </section>
        {{/if}}

        {{#if view.missions}}
          <section class="dm-page dm-page--forensic dm-mission-control">
            <div class="dm-page-heading">
              <div>
                <span class="dm-kicker">MISSION CONTROL // OPERATIONAL NETWORK</span>
                <h2>Mission Control</h2>
                <p>Preparação, comprometimento de força, lançamento e resolução de operações.</p>
              </div>
              <div class="dm-heading-actions">
                <div class="dm-heading-code">{{missions.length}} MISSION(S)</div>
                {{#if canCreateMission}}
                  <button type="button" class="dm-action-button" data-action="openCreateMission"><i class="fa-solid fa-plus"></i> NOVA OPERAÇÃO</button>
                {{/if}}
              </div>
            </div>

            <div class="dm-mission-list dm-mission-list--control">
              {{#each missions}}
                <article class="dm-mission-card dm-mission-card--control is-{{status}}">
                  <div class="dm-mission-card__rail">
                    <div class="dm-mission-card__target"><i class="fa-solid fa-crosshairs"></i><span>{{objectiveCount}} OBJ</span></div>
                    <div class="dm-mission-card__rail-code"><span>FORCE</span><strong>{{committedStrength}}</strong></div>
                    <div class="dm-mission-card__rail-code"><span>UNITS</span><strong>{{assignmentCount}}</strong></div>
                  </div>

                  <div class="dm-mission-card__body">
                    <header class="dm-mission-card__header">
                      <div>
                        <span class="dm-kicker">OPERATION // {{entityId}}</span>
                        <h3>{{name}}</h3>
                      </div>
                      <span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span>
                    </header>

                    <p class="dm-mission-card__brief">{{#if briefing}}{{briefing}}{{else}}Sem briefing operacional.{{/if}}</p>

                    <div class="dm-mission-telemetry">
                      <span><small>AUDIENCE</small><strong>{{audienceLabel}}</strong></span>
                      <span><small>OBJECTIVES</small><strong>{{completedObjectives}} / {{objectiveCount}}</strong></span>
                      <span><small>FAILED</small><strong>{{failedObjectives}}</strong></span>
                      <span><small>ASSIGNMENTS</small><strong>{{assignmentCount}}</strong></span>
                    </div>

                    <div class="dm-objective-grid">
                      {{#each objectives}}
                        <div class="dm-objective-row is-{{status}}">
                          <span class="dm-objective-row__status"></span>
                          <div><strong>{{title}}</strong>{{#if description}}<small>{{description}}</small>{{/if}}</div>
                          <span>{{status}}</span>
                        </div>
                      {{else}}
                        <div class="dm-muted">Nenhum objetivo registrado.</div>
                      {{/each}}
                    </div>

                    {{#if assignments.length}}
                      <div class="dm-mission-units">
                        <div class="dm-mission-subhead"><span>COMMITTED UNITS</span><strong>{{assignmentCount}}</strong></div>
                        {{#each assignments}}
                          <div class="dm-mission-unit">
                            <div class="dm-mission-unit__id"><span class="dm-status-pip dm-status-pip--{{../tone}}"></span><div><strong>{{squadName}}</strong><small>{{stateLabel}} · {{committedStrength}} personnel</small></div></div>
                            <div class="dm-mission-unit__resources">
                              {{#each resources}}<span>{{name}} <strong>{{amountDisplay}}{{#if unit}} {{unit}}{{/if}}</strong></span>{{else}}<span>NO COMMITTED SUPPLY</span>{{/each}}
                            </div>
                            {{#if canRelease}}
                              <button type="button" class="dm-icon-button" title="Liberar unidade" data-action="releaseMissionAssignment" data-mission-uuid="{{../uuid}}" data-squad-uuid="{{squadUuid}}"><i class="fa-solid fa-link-slash"></i></button>
                            {{/if}}
                          </div>
                        {{/each}}
                      </div>
                    {{/if}}

                    {{#if isAvailable}}
                      <div class="dm-mission-ready-units">
                        <div class="dm-mission-subhead"><span>AVAILABLE FORCE</span><strong>{{eligibleSquads.length}}</strong></div>
                        <div class="dm-mission-ready-grid">
                          {{#each eligibleSquads}}
                            <button type="button" class="dm-mission-ready-unit {{#if isPrepared}}is-prepared{{/if}}" data-action="openMissionPrepare" data-mission-uuid="{{../uuid}}" data-squad-uuid="{{uuid}}">
                              <span><strong>{{name}}</strong><small>{{strength}} / {{capacity}} · {{statusLabel}}</small></span>
                              <span>{{prepareLabel}}</span>
                            </button>
                          {{else}}
                            <div class="dm-muted">Nenhum Squad controlável está disponível para esta operação.</div>
                          {{/each}}
                        </div>
                      </div>
                    {{/if}}

                    {{#if outcomeSummary}}
                      <div class="dm-mission-outcome"><span>AFTER ACTION REPORT</span><p>{{outcomeSummary}}</p></div>
                    {{/if}}

                    <footer class="dm-mission-card__actions">
                      {{#if canLaunch}}<button type="button" class="dm-action-button" data-action="launchMission" data-mission-uuid="{{uuid}}"><i class="fa-solid fa-play"></i> LAUNCH OPERATION</button>{{/if}}
                      {{#if canResolve}}<button type="button" class="dm-action-button dm-action-button--critical" data-action="openMissionResolve" data-mission-uuid="{{uuid}}"><i class="fa-solid fa-flag-checkered"></i> RESOLVE OPERATION</button>{{/if}}
                    </footer>
                  </div>
                </article>
              {{else}}
                <div class="dm-empty dm-empty--force">
                  <i class="fa-solid fa-location-crosshairs"></i>
                  <strong>Nenhuma operação registrada</strong>
                  <span>O Mission Control exibirá aqui briefings, forças comprometidas, suprimentos e resultados.</span>
                  {{#if canCreateMission}}<button type="button" class="dm-action-button" data-action="openCreateMission">CRIAR PRIMEIRA OPERAÇÃO</button>{{/if}}
                </div>
              {{/each}}
            </div>
          </section>
        {{/if}}

        {{#if view.diplomacy}}
          <section class="dm-page"><div class="dm-page-heading"><div><span class="dm-kicker">EXTERNAL RELATIONS</span><h2>Diplomacia</h2><p>Posturas, acordos e relações externas.</p></div><div class="dm-heading-code">{{relations.length}} LINK(S)</div></div><div class="dm-grid dm-grid--2"><section class="dm-panel"><header class="dm-panel__header"><h3>Relações</h3></header><div class="dm-list">{{#each relations}}<div class="dm-list-row"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{targetName}}</strong><span>{{postureLabel}} · {{notes}}</span></div></div>{{else}}<div class="dm-empty dm-empty--compact"><strong>Sem relações</strong></div>{{/each}}</div></section><section class="dm-panel"><header class="dm-panel__header"><h3>Acordos</h3></header><div class="dm-list">{{#each agreements}}<div class="dm-list-row"><span class="dm-status-pip dm-status-pip--{{tone}}"></span><div><strong>{{name}}</strong><span>{{statusLabel}}</span></div></div>{{else}}<div class="dm-empty dm-empty--compact"><strong>Sem acordos</strong></div>{{/each}}</div></section></div></section>
        {{/if}}

        {{#if view.territory}}
          <section class="dm-page"><div class="dm-page-heading"><div><span class="dm-kicker">SPATIAL CONTROL // TERRITORY</span><h2>Território</h2><p>Camada espacial preparada para controle, influência e hierarquia física.</p></div><div class="dm-heading-code">SPATIAL LAYER / READY</div></div><section class="dm-panel dm-panel--map"><div class="dm-map-placeholder"><div class="dm-map-grid"></div><div class="dm-map-reticle"><span></span></div><div class="dm-map-callout"><span class="dm-kicker">CURRENT NODE</span><strong>{{selectedDomain.name}}</strong><span>{{selectedDomain.category}}</span></div></div></section></section>
        {{/if}}

        {{#if view.intel}}
          <section class="dm-page dm-page--forensic"><div class="dm-page-heading"><div><span class="dm-kicker">INTELLIGENCE // ANALYSIS</span><h2>Inteligência</h2><p>Fatos, rumores, segredos e fontes verificadas.</p></div><div class="dm-heading-code">{{intel.length}} INTEL PACKET(S)</div></div><div class="dm-intel-grid">{{#each intel}}<article class="dm-intel-card"><header><span class="dm-kicker">{{category}} // {{credibility}}</span><span class="dm-chip dm-chip--{{tone}}">{{visibility}}</span></header><h3>{{title}}</h3><p>{{content}}</p><footer><span>SOURCE</span><strong>{{#if source}}{{source}}{{else}}CLASSIFIED{{/if}}</strong></footer></article>{{else}}<div class="dm-empty"><i class="fa-solid fa-satellite-dish"></i><strong>Nenhum pacote de inteligência</strong><span>Informações coletadas aparecerão aqui.</span></div>{{/each}}</div></section>
        {{/if}}

        {{#if view.security}}
          <section class="dm-page dm-page--forensic"><div class="dm-page-heading"><div><span class="dm-kicker">SECURITY // DEFENSE GRID</span><h2>Segurança</h2><p>Defesa, guarnição e fortificações.</p></div><div class="dm-heading-code">DEF GRID / {{domainData.security.defenseRating}}</div></div><div class="dm-stat-grid dm-stat-grid--three"><article class="dm-stat"><span class="dm-stat__label">DEFENSE RATING</span><strong>{{domainData.security.defenseRating}}</strong><span class="dm-stat__meta">nível agregado</span></article><article class="dm-stat"><span class="dm-stat__label">GUARD COUNT</span><strong>{{domainData.security.guardCount}}</strong><span class="dm-stat__meta">efetivo de segurança</span></article><article class="dm-stat"><span class="dm-stat__label">FORTIFICATIONS</span><strong>{{domainData.security.fortifications.length}}</strong><span class="dm-stat__meta">camadas registradas</span></article></div><section class="dm-panel"><header class="dm-panel__header"><h3>Defense Layers</h3></header><div class="dm-chip-cloud">{{#each domainData.security.fortifications}}<span class="dm-chip dm-chip--neutral">{{this}}</span>{{else}}<span class="dm-muted">Nenhuma fortificação registrada.</span>{{/each}}</div></section></section>
        {{/if}}

        {{#if view.history}}
          <section class="dm-page"><div class="dm-page-heading"><div><span class="dm-kicker">ARCHIVE // CHRONOLOGY</span><h2>Histórico</h2><p>Crônica persistente de alterações e eventos.</p></div><div class="dm-heading-code">{{history.length}} ENTRY(S)</div></div><section class="dm-panel"><div class="dm-timeline">{{#each history}}<article class="dm-timeline__entry"><span class="dm-timeline__dot"></span><div><span class="dm-kicker">{{category}}</span><h3>{{title}}</h3><p>{{description}}</p><small>{{timestamp}}</small></div></article>{{else}}<div class="dm-empty"><i class="fa-solid fa-clock-rotate-left"></i><strong>Arquivo vazio</strong><span>Eventos históricos persistentes aparecerão aqui.</span></div>{{/each}}</div></section></section>
        {{/if}}
      </div>
    </main>
  </div>

  <footer class="dm-system-footer">
    <div><span class="dm-sysdot {{#if authorityReady}}is-online{{else}}is-offline{{/if}}"></span><span>KERNEL {{system.authority}}</span><span class="dm-divider-vert"></span><span>ACTIVE GM // {{system.activeGM}}</span></div>
    <div><span>DOMAIN INDEX // {{domainCount}}</span><span class="dm-divider-vert"></span><span>CLIENT // {{system.primary}}</span></div>
  </footer>

  {{#if isCreateDomainOpen}}
    <div class="dm-modal-layer">
      <form id="dm-create-domain-form" class="dm-system-dialog" autocomplete="off">
        <header class="dm-system-dialog__header"><div><span class="dm-kicker">CREATE ENTITY</span><h2>Novo Domínio</h2></div><button type="button" class="dm-icon-button" data-action="cancelCreateDomain"><i class="fa-solid fa-xmark"></i></button></header>
        <div class="dm-system-dialog__body">
          <label class="dm-field"><span>Nome</span><input name="name" required placeholder="Base Aurelia" /></label>
          <label class="dm-field"><span>Categoria</span><input name="category" value="Base" /></label>
          <label class="dm-field"><span>Natureza</span><select name="nature"><option value="physical">Físico</option><option value="organization">Organização</option><option value="hybrid">Híbrido</option><option value="abstract">Abstrato</option></select></label>
          <label class="dm-field"><span>Perfil de gerenciamento</span><select name="preset"><option value="base">Base</option><option value="outpost">Outpost</option><option value="strategic-organization">Organização Estratégica</option><option value="squad">Squad</option><option value="custom">Custom</option></select></label>
          <label class="dm-field dm-field--wide"><span>Descrição</span><textarea name="description" rows="4" placeholder="Briefing operacional..."></textarea></label>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelCreateDomain">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitCreateDomain">CRIAR NODE</button></footer>
      </form>
    </div>
  {{/if}}


  {{#if isCreateMissionOpen}}
    <div class="dm-modal-layer">
      <form id="dm-create-mission-form" class="dm-system-dialog dm-system-dialog--wide" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">MISSION CONTROL // REGISTER OPERATION</span><h2>Nova Operação</h2></div>
          <button type="button" class="dm-icon-button" data-action="cancelCreateMission"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__body">
          <label class="dm-field"><span>Designação</span><input name="name" required placeholder="Operação Farpoint" /></label>
          <label class="dm-field"><span>Disponibilidade</span><select name="status"><option value="available" selected>Disponível para preparação</option><option value="planned">Planejada</option></select></label>
          <label class="dm-field dm-field--wide"><span>Briefing</span><textarea name="briefing" rows="4" placeholder="Objetivo estratégico, contexto, restrições..."></textarea></label>
          <label class="dm-field dm-field--wide"><span>Objetivos · um por linha</span><textarea name="objectives" rows="4" placeholder="Localizar o transmissor&#10;Recuperar inteligência&#10;Extrair sem comprometer a posição"></textarea></label>
          <fieldset class="dm-controller-grid dm-field--wide">
            <legend>Audiência operacional</legend>
            {{#each missionAudienceOptions}}
              <label class="dm-controller-option"><input type="checkbox" name="audienceUserIds" value="{{id}}" /><span class="dm-sysdot {{#if active}}is-online{{/if}}"></span><strong>{{name}}</strong><small>{{#if active}}ONLINE{{else}}OFFLINE{{/if}}</small></label>
            {{else}}<div class="dm-muted">Nenhum jogador disponível para a audiência.</div>{{/each}}
          </fieldset>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelCreateMission">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitCreateMission">REGISTRAR OPERAÇÃO</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if preparingMission}}
    <div class="dm-modal-layer">
      <form id="dm-mission-prepare-form" class="dm-system-dialog dm-system-dialog--wide" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">MISSION CONTROL // FORCE COMMITMENT</span><h2>{{preparingMission.name}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="closeMissionPrepare"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>UNIT</small><strong>{{preparingSquad.name}}</strong></span>
          <span><small>STRENGTH</small><strong>{{preparingSquad.strength}} / {{preparingSquad.capacity}}</strong></span>
          <span><small>MORALE</small><strong>{{preparingSquad.moraleDisplay}}</strong></span>
          <span><small>CONDITION</small><strong>{{preparingSquad.conditionDisplay}}</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          <label class="dm-field dm-field--wide"><span>Efetivo comprometido</span><input name="committedStrength" type="number" min="1" max="{{preparingSquad.strength}}" value="{{#if existingPreparation}}{{existingPreparation.committedStrength}}{{else}}{{preparingSquad.strength}}{{/if}}" required /></label>
          <div class="dm-field dm-field--wide"><span>Suprimentos comprometidos</span><div class="dm-mission-resource-form">
            {{#each missionPrepareResources}}
              <label class="dm-mission-resource-input"><span><strong>{{name}}</strong><small>AVAILABLE {{stockDisplay}}{{#if unit}} {{unit}}{{/if}}</small></span><input name="resource:{{resourceId}}" inputmode="decimal" value="{{committedDisplay}}" placeholder="0" /></label>
            {{else}}<div class="dm-muted">Este Squad não possui recursos registrados.</div>{{/each}}
          </div></div>
          <div class="dm-mission-dialog-note dm-field--wide"><i class="fa-solid fa-circle-info"></i><span>A preparação reserva o compromisso. O estoque só é consumido quando o GM lança a operação.</span></div>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closeMissionPrepare">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitMissionPrepare">CONFIRMAR PREPARAÇÃO</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if resolvingMission}}
    <div class="dm-modal-layer">
      <form id="dm-mission-resolve-form" class="dm-system-dialog dm-system-dialog--mission-resolve" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">MISSION CONTROL // AFTER ACTION</span><h2>{{resolvingMission.name}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="closeMissionResolve"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>UNITS</small><strong>{{resolvingMission.assignmentCount}}</strong></span>
          <span><small>FORCE</small><strong>{{resolvingMission.committedStrength}}</strong></span>
          <span><small>OBJECTIVES</small><strong>{{resolvingMission.objectiveCount}}</strong></span>
          <span><small>STATUS</small><strong>ACTIVE</strong></span>
        </div>
        <div class="dm-system-dialog__body dm-system-dialog__body--stacked">
          <section class="dm-resolution-section">
            <header><span>UNIT CONSEQUENCES</span><strong>{{resolvingMission.assignmentCount}}</strong></header>
            {{#each resolvingMission.assignments}}
              <div class="dm-resolution-unit">
                <div class="dm-resolution-unit__title"><strong>{{squadName}}</strong><span>{{committedStrength}} committed</span></div>
                <label class="dm-field"><span>Baixas</span><input name="casualties:{{localId}}" type="number" min="0" max="{{committedStrength}}" value="0" /></label>
                <label class="dm-field"><span>Δ Moral</span><input name="moraleDelta:{{localId}}" type="number" min="-100" max="100" value="0" /></label>
                <label class="dm-field"><span>Δ Condição</span><input name="conditionDelta:{{localId}}" type="number" min="-100" max="100" value="0" /></label>
                <label class="dm-field dm-field--wide"><span>Notas</span><input name="notes:{{localId}}" placeholder="Resistência, ferimentos, perdas de equipamento..." /></label>
              </div>
            {{/each}}
          </section>
          <section class="dm-resolution-section">
            <header><span>OBJECTIVE STATUS</span><strong>{{resolvingMission.objectiveCount}}</strong></header>
            {{#each resolvingMission.objectives}}
              <label class="dm-resolution-objective"><span><strong>{{title}}</strong>{{#if description}}<small>{{description}}</small>{{/if}}</span><select name="objective:{{localId}}"><option value="pending" {{#if isPending}}selected{{/if}}>Pendente</option><option value="completed" {{#if isCompleted}}selected{{/if}}>Concluído</option><option value="failed" {{#if isFailed}}selected{{/if}}>Falhou</option></select></label>
            {{/each}}
          </section>
          <label class="dm-field"><span>Resultado final</span><select name="status"><option value="resolved">Resolvida</option><option value="failed">Falhou</option></select></label>
          <label class="dm-field dm-field--wide"><span>After Action Report</span><textarea name="outcomeSummary" rows="4" placeholder="Resumo das consequências estratégicas..."></textarea></label>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closeMissionResolve">CANCELAR</button><button type="button" class="dm-action-button dm-action-button--critical" data-action="submitMissionResolve">APLICAR CONSEQUÊNCIAS</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if isCreateSquadOpen}}
    <div class="dm-modal-layer">
      <form id="dm-create-squad-form" class="dm-system-dialog dm-system-dialog--wide" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">FORCE CONTROL // CREATE UNIT</span><h2>Novo Squad</h2></div>
          <button type="button" class="dm-icon-button" data-action="cancelCreateSquad"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__body">
          <label class="dm-field"><span>Designação</span><input name="name" required placeholder="Raven-01" /></label>
          <label class="dm-field"><span>Status inicial</span><select name="status"><option value="forming">Formação</option><option value="ready" selected>Pronto</option><option value="deployed">Em campo</option><option value="recovering">Recuperando</option><option value="inactive">Inativo</option></select></label>
          <label class="dm-field"><span>Capacidade</span><input name="capacity" type="number" min="1" value="20" required /></label>
          <label class="dm-field"><span>Efetivo</span><input name="strength" type="number" min="0" value="20" required /></label>
          <label class="dm-field"><span>Moral</span><input name="morale" type="number" min="0" max="100" value="60" required /></label>
          <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="100" required /></label>
          <label class="dm-field dm-field--wide"><span>Briefing da unidade</span><textarea name="description" rows="3" placeholder="Função, doutrina, especialização..."></textarea></label>
          <fieldset class="dm-controller-grid dm-field--wide">
            <legend>Operadores autorizados</legend>
            {{#each controllerOptions}}
              <label class="dm-controller-option"><input type="checkbox" name="controllerIds" value="{{id}}" /><span class="dm-sysdot {{#if active}}is-online{{/if}}"></span><strong>{{name}}</strong><small>{{#if active}}ONLINE{{else}}OFFLINE{{/if}}</small></label>
            {{else}}
              <div class="dm-muted">Nenhum jogador disponível para atribuição.</div>
            {{/each}}
          </fieldset>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelCreateSquad">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitCreateSquad">CRIAR UNIDADE</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if supplySquad}}
    <div class="dm-modal-layer">
      <form id="dm-squad-supply-form" class="dm-system-dialog dm-system-dialog--wide" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">LOGISTICS // UNIT SUPPLY</span><h2>{{supplySquad.name}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="closeSquadSupply"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>UNIT</small><strong>{{supplySquad.strength}} / {{supplySquad.capacity}}</strong></span>
          <span><small>RESOURCE TYPES</small><strong>{{supplySquad.resourceKinds}}</strong></span>
          <span><small>DOMAIN</small><strong>{{selectedDomain.name}}</strong></span>
          <span><small>LINK</small><strong>{{#if isGM}}FULL DUPLEX{{else}}RETURN ONLY{{/if}}</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          <label class="dm-field"><span>Recurso</span><select name="resourceId" required>{{#each supplyResourceOptions}}<option value="{{id}}">{{name}}{{#if unit}} · {{unit}}{{/if}}</option>{{/each}}</select></label>
          {{#if isGM}}
            <label class="dm-field"><span>Direção</span><select name="direction"><option value="domain-to-squad">Domain → Squad</option><option value="squad-to-domain">Squad → Domain</option></select></label>
          {{else}}
            <input type="hidden" name="direction" value="squad-to-domain" />
            <div class="dm-field"><span>Direção autorizada</span><div class="dm-readonly-field">Squad → Domain</div></div>
          {{/if}}
          <label class="dm-field dm-field--wide"><span>Quantidade</span><input name="amount" inputmode="decimal" required placeholder="0" /></label>
          <div class="dm-supply-ledger dm-field--wide">
            <div class="dm-supply-ledger__head"><span>RECURSO</span><span>DOMAIN</span><span>SQUAD</span></div>
            {{#each supplyResourceOptions}}<div class="dm-supply-ledger__row"><strong>{{name}}</strong><span>{{domainDisplay}} {{unit}}</span><span>{{squadDisplay}} {{unit}}</span></div>{{else}}<div class="dm-muted">O catálogo de recursos está vazio.</div>{{/each}}
          </div>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closeSquadSupply">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitSquadSupply">TRANSFERIR</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if editingSquad}}
    <div class="dm-modal-layer">
      <form id="dm-squad-control-form" class="dm-system-dialog dm-system-dialog--wide" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">UNIT CONTROL // {{editingSquad.entityIdShort}}</span><h2>{{editingSquad.name}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="closeSquadControl"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>STRENGTH</small><strong>{{editingSquad.strength}} / {{editingSquad.capacity}}</strong></span>
          <span><small>MORALE</small><strong>{{editingSquad.moraleDisplay}}</strong></span>
          <span><small>CONDITION</small><strong>{{editingSquad.conditionDisplay}}</strong></span>
          <span><small>MISSION</small><strong>{{editingSquad.currentMissionName}}</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          {{#if isGM}}
            <label class="dm-field"><span>Designação</span><input name="name" value="{{editingSquad.name}}" required /></label>
          {{else}}
            <input name="name" type="hidden" value="{{editingSquad.name}}" />
          {{/if}}
          <label class="dm-field"><span>Status</span><select name="status">{{#each squadStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{#if isGM}}
            <label class="dm-field"><span>Capacidade</span><input name="capacity" type="number" min="1" value="{{editingSquad.capacity}}" required /></label>
            <label class="dm-field"><span>Efetivo</span><input name="strength" type="number" min="0" value="{{editingSquad.strength}}" required /></label>
          {{else}}
            <input name="capacity" type="hidden" value="{{editingSquad.capacity}}" /><input name="strength" type="hidden" value="{{editingSquad.strength}}" />
          {{/if}}
          <label class="dm-field"><span>Moral</span><input name="morale" type="number" min="0" max="100" value="{{editingSquad.morale}}" required /></label>
          <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="{{editingSquad.condition}}" required /></label>
          <label class="dm-field dm-field--wide"><span>Briefing operacional</span><textarea name="description" rows="3">{{editingSquad.description}}</textarea></label>
          {{#if isGM}}
            <fieldset class="dm-controller-grid dm-field--wide">
              <legend>Operadores autorizados</legend>
              {{#each controllerOptions}}
                <label class="dm-controller-option"><input type="checkbox" name="controllerIds" value="{{id}}" {{#if checked}}checked{{/if}} /><span class="dm-sysdot {{#if active}}is-online{{/if}}"></span><strong>{{name}}</strong><small>{{#if active}}ONLINE{{else}}OFFLINE{{/if}}</small></label>
              {{else}}<div class="dm-muted">Nenhum jogador disponível.</div>{{/each}}
            </fieldset>
          {{/if}}
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closeSquadControl">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitSquadControl">SINCRONIZAR UNIDADE</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if isCreateStructureOpen}}
    <div class="dm-modal-layer">
      <form id="dm-create-structure-form" class="dm-system-dialog dm-system-dialog--wide dm-structure-dialog" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">INFRASTRUCTURE // {{#if structureCreateIsConstruction}}CONSTRUCTION PROJECT{{else}}ASSET REGISTRY{{/if}}</span><h2>{{#if structureCreateIsConstruction}}Nova Construção{{else}}Registrar Structure{{/if}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="cancelCreateStructure"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>DOMAIN</small><strong>{{selectedDomain.name}}</strong></span>
          <span><small>MODE</small><strong>{{#if structureCreateIsConstruction}}PROJECT LINKED{{else}}DIRECT REGISTRY{{/if}}</strong></span>
          <span><small>AUTHORITY</small><strong>{{system.primary}}</strong></span>
          <span><small>SCHEMA</small><strong>STRUCTURE / V6</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          <label class="dm-field"><span>Designação</span><input name="name" required placeholder="Reator Helios" /></label>
          <label class="dm-field"><span>Categoria</span><input name="category" value="general" placeholder="power / logistics / defense" /></label>
          <label class="dm-field"><span>Tier</span><input name="tier" type="number" min="1" value="1" required /></label>
          <label class="dm-field"><span>Tier máximo</span><input name="maxTier" type="number" min="1" value="3" required /></label>
          <label class="dm-field"><span>Capacidade</span><input name="capacity" type="number" min="0" value="0" required /></label>
          <label class="dm-field"><span>Tags</span><input name="tags" placeholder="critical, power, reactor" /></label>
          <label class="dm-field dm-field--wide"><span>Descrição técnica</span><textarea name="description" rows="3" placeholder="Função do ativo dentro da base..."></textarea></label>

          {{#if structureCreateIsDirect}}
            <label class="dm-field"><span>Status inicial</span><select name="status"><option value="operational" selected>Operacional</option><option value="damaged">Danificada</option><option value="disabled">Desativada</option><option value="planned">Planejada</option></select></label>
            <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="100" /></label>
          {{/if}}

          {{#if structureCreateIsConstruction}}
            <section class="dm-infra-project-config dm-field--wide">
              <header><span class="dm-kicker">PROJECT CONTRACT</span><strong>O ativo permanece PLANNED até o Project concluir.</strong></header>
              <div class="dm-dialog-grid">
                <label class="dm-field"><span>Nome do Project</span><input name="projectName" placeholder="Construção // automático" /></label>
                <label class="dm-field"><span>Trabalho total</span><input name="workRequired" type="number" min="1" value="100" /></label>
                <label class="dm-field"><span>Trabalho / período</span><input name="rateAmount" type="number" min="1" value="10" /></label>
                <label class="dm-field"><span>Período (ticks)</span><input name="periodTicks" type="number" min="1" value="1" /></label>
                <label class="dm-field dm-field--wide"><span>Descrição do Project</span><textarea name="projectDescription" rows="2"></textarea></label>
              </div>
            </section>
          {{/if}}

          <section class="dm-resource-matrix dm-field--wide">
            <header><div><span class="dm-kicker">ECONOMIC VECTOR</span><h3>Manutenção e Produção</h3></div><span>valores por tick</span></header>
            <div class="dm-resource-matrix__head"><span>RECURSO</span><span>MANUTENÇÃO</span><span>PRODUÇÃO</span>{{#if structureCreateIsConstruction}}<span>CUSTO DO PROJECT</span><span>MODO</span>{{/if}}</div>
            {{#each structureResourceOptions}}
              <div class="dm-resource-matrix__row">
                <strong>{{name}} {{#if unit}}<small>{{unit}}</small>{{/if}}</strong>
                <input name="maintenance:{{id}}" inputmode="decimal" placeholder="—" />
                <input name="production:{{id}}" inputmode="decimal" placeholder="—" />
                {{#if ../structureCreateIsConstruction}}<input name="cost:{{id}}" inputmode="decimal" placeholder="—" /><select name="costMode:{{id}}"><option value="reserved">Reserved</option><option value="progressive">Progressive</option></select>{{/if}}
              </div>
            {{else}}<div class="dm-muted">Cadastre recursos no catálogo para configurar vetores econômicos.</div>{{/each}}
          </section>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelCreateStructure">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitCreateStructure">{{#if structureCreateIsConstruction}}INICIAR CONSTRUÇÃO{{else}}REGISTRAR ATIVO{{/if}}</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if editingStructure}}
    <div class="dm-modal-layer">
      <form id="dm-structure-control-form" class="dm-system-dialog dm-system-dialog--wide dm-structure-dialog" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">INFRASTRUCTURE CONTROL // {{editingStructure.entityId}}</span><h2>{{editingStructure.name}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="closeStructureControl"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>STATUS</small><strong>{{editingStructure.statusLabel}}</strong></span>
          <span><small>CONDITION</small><strong>{{editingStructure.conditionDisplay}}</strong></span>
          <span><small>TIER</small><strong>{{editingStructure.tier}} / {{editingStructure.maxTier}}</strong></span>
          <span><small>CAPACITY</small><strong>{{editingStructure.capacity}}</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          {{#if isGM}}
            <label class="dm-field"><span>Designação</span><input name="name" value="{{editingStructure.name}}" required /></label>
            <label class="dm-field"><span>Categoria</span><input name="category" value="{{editingStructure.rawCategory}}" required /></label>
            <label class="dm-field"><span>Tier</span><input name="tier" type="number" min="1" value="{{editingStructure.tier}}" required /></label>
            <label class="dm-field"><span>Tier máximo</span><input name="maxTier" type="number" min="1" value="{{editingStructure.maxTier}}" required /></label>
            <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="{{editingStructure.condition}}" required /></label>
            <label class="dm-field"><span>Capacidade</span><input name="capacity" type="number" min="0" value="{{editingStructure.capacity}}" required /></label>
            <label class="dm-field"><span>Status</span><select name="status">{{#each structureStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label class="dm-field"><span>Tags</span><input name="tags" value="{{#each editingStructure.tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}" /></label>
          {{else}}
            <label class="dm-field"><span>Status operacional</span><select name="status">{{#each structureOperatorStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{/if}}
          <label class="dm-field dm-field--wide"><span>Descrição operacional</span><textarea name="description" rows="3">{{editingStructure.description}}</textarea></label>

          {{#if isGM}}
            <section class="dm-resource-matrix dm-field--wide">
              <header><div><span class="dm-kicker">ECONOMIC VECTOR</span><h3>Manutenção e Produção</h3></div><span>valores por tick</span></header>
              <div class="dm-resource-matrix__head"><span>RECURSO</span><span>MANUTENÇÃO</span><span>PRODUÇÃO</span></div>
              {{#each structureResourceOptions}}
                <div class="dm-resource-matrix__row"><strong>{{name}} {{#if unit}}<small>{{unit}}</small>{{/if}}</strong><input name="maintenance:{{id}}" inputmode="decimal" value="{{maintenanceValue}}" placeholder="—" /><input name="production:{{id}}" inputmode="decimal" value="{{productionValue}}" placeholder="—" /></div>
              {{/each}}
            </section>
          {{/if}}
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closeStructureControl">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitStructureControl">SINCRONIZAR ATIVO</button></footer>
      </form>
    </div>
  {{/if}}

</div>
