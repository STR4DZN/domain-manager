      <form id="dm-person-editor-form" class="dm-system-dialog dm-system-dialog--wide dm-person-dialog" autocomplete="off">
        <input type="hidden" name="expectedModifiedTime" value="{{editingPerson.expectedModifiedTime}}" />
        <header class="dm-system-dialog__header"><div><span class="dm-kicker">PESSOAS // {{#if editingPerson}}EDITAR{{else}}NOVA{{/if}}</span><h2>{{#if editingPerson}}{{editingPerson.name}}{{else}}Nova Pessoa{{/if}}</h2><p>Identidade, retrato, função e vínculos da pessoa.</p></div><button type="button" class="dm-icon-button" data-action="closePersonEditor" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button></header>
        <div class="dm-system-dialog__body dm-person-dialog__body">
          <section class="dm-person-editor-preview dm-field--wide">
            <div class="dm-person-editor-preview__portrait" data-preview-container-for="portrait">{{#if editingPerson.portrait}}<img data-preview-for="portrait" src="{{editingPerson.portrait}}" alt="Retrato" />{{else}}<i class="fa-solid fa-user"></i>{{/if}}</div>
            <div><strong>{{#if editingPerson}}{{editingPerson.name}}{{else}}Nova pessoa{{/if}}</strong><span>O retrato também aparecerá na lista e no perfil.</span></div>
          </section>
          <label class="dm-field"><span>Nome</span><input name="name" value="{{editingPerson.name}}" required /></label>
          <label class="dm-field"><span>Estado</span><select name="status">{{#each personStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="dm-field"><span>Função</span><input name="role" value="{{editingPerson.role}}" /></label>
          <label class="dm-field"><span>Especialização</span><input name="specialization" value="{{editingPerson.specialization}}" /></label>
          <label class="dm-field"><span>Moral</span><input name="morale" type="number" min="0" max="100" value="{{#if editingPerson}}{{editingPerson.morale}}{{else}}60{{/if}}" /></label>
          <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="{{#if editingPerson}}{{editingPerson.condition}}{{else}}100{{/if}}" /></label>
          <label class="dm-field"><span>Unidade</span><select name="squadEntityId"><option value="">— Nenhuma —</option>{{#each personSquadOptions}}<option value="{{entityId}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          <label class="dm-field"><span>UUID do Ator</span><input name="actorUuid" value="{{editingPerson.actorUuid}}" /></label>
          <label class="dm-field dm-field--wide"><span>Retrato</span><div class="dm-file-field"><input name="portrait" value="{{editingPerson.portrait}}" placeholder="caminho/para/imagem.webp" /><button type="button" class="dm-action-button dm-action-button--secondary" data-action="browseImageField" data-field="portrait"><i class="fa-solid fa-folder-open"></i> ESCOLHER IMAGEM</button></div></label>
          <label class="dm-field dm-field--wide"><span>Marcadores</span><input name="tags" value="{{#each editingPerson.tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}" /></label>
          <label class="dm-field dm-field--wide"><span>Descrição</span><textarea name="description" rows="3">{{editingPerson.data.description}}</textarea></label>
          <label class="dm-field dm-field--wide"><span>Notas</span><textarea name="notes" rows="3">{{editingPerson.notes}}</textarea></label>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closePersonEditor">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitPersonEditor"><i class="fa-solid fa-floppy-disk"></i> SALVAR PESSOA</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if isCreateStructureOpen}}
    <div class="dm-modal-layer">
      <form id="dm-create-structure-form" class="dm-system-dialog dm-system-dialog--wide dm-structure-dialog" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">INFRAESTRUTURA // {{#if structureCreateIsConstruction}}PROJETO DE CONSTRUÇÃO{{else}}CADASTRO DE ATIVO{{/if}}</span><h2>{{#if structureCreateIsConstruction}}Nova Construção{{else}}Registrar Estrutura{{/if}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="cancelCreateStructure"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>DOMÍNIO</small><strong>{{selectedDomain.name}}</strong></span>
          <span><small>MODO</small><strong>{{#if structureCreateIsConstruction}}VINCULADO A PROJETO{{else}}CADASTRO DIRETO{{/if}}</strong></span>
          <span><small>AUTORIDADE</small><strong>{{system.primary}}</strong></span>
          <span><small>ESQUEMA</small><strong>ESTRUTURA / V6</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          <label class="dm-field"><span>Designação</span><input name="name" required placeholder="Reator Helios" /></label>
          <label class="dm-field"><span>Categoria</span><input name="category" value="general" placeholder="energia / logística / defesa" /></label>
          <label class="dm-field"><span>Nível</span><input name="tier" type="number" min="1" value="1" required /></label>
          <label class="dm-field"><span>Nível máximo</span><input name="maxTier" type="number" min="1" value="3" required /></label>
          <label class="dm-field"><span>Capacidade</span><input name="capacity" type="number" min="0" value="0" required /></label>
          <label class="dm-field"><span>Prioridade de manutenção</span><input name="maintenancePriority" type="number" min="0" max="100" value="50" required /></label>
          <label class="dm-field"><span>Trabalhadores necessários</span><input name="workforceRequired" type="number" min="0" value="0" required /></label>
          <label class="dm-field"><span>Marcadores</span><input name="tags" placeholder="crítica, energia, reator" /></label>
          <label class="dm-field dm-field--wide"><span>Descrição técnica</span><textarea name="description" rows="3" placeholder="Função do ativo dentro da base..."></textarea></label>

          {{#if structureCreateIsDirect}}
            <label class="dm-field"><span>Estado inicial</span><select name="status"><option value="operational" selected>Operacional</option><option value="damaged">Danificada</option><option value="disabled">Desativada</option><option value="planned">Planejada</option></select></label>
            <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="100" /></label>
          {{/if}}

          {{#if structureCreateIsConstruction}}
            <section class="dm-infra-project-config dm-field--wide">
              <header><span class="dm-kicker">VÍNCULO COM PROJETO</span><strong>A estrutura permanece planejada até o projeto ser concluído.</strong></header>
              <div class="dm-dialog-grid">
                <label class="dm-field"><span>Nome do Projeto</span><input name="projectName" placeholder="Construção // automático" /></label>
                <label class="dm-field"><span>Trabalho total</span><input name="workRequired" type="number" min="1" value="100" /></label>
                <label class="dm-field"><span>Trabalho / período</span><input name="rateAmount" type="number" min="1" value="10" /></label>
                <label class="dm-field"><span>Período (ticks)</span><input name="periodTicks" type="number" min="1" value="1" /></label>
                <label class="dm-field dm-field--wide"><span>Descrição do Projeto</span><textarea name="projectDescription" rows="2"></textarea></label>
              </div>
            </section>
          {{/if}}

          <section class="dm-resource-matrix dm-field--wide">
            <header><div><span class="dm-kicker">FLUXO ECONÔMICO</span><h3>Manutenção e Produção</h3></div><span>valores por tick</span></header>
            <div class="dm-resource-matrix__head"><span>RECURSO</span><span>MANUTENÇÃO</span><span>PRODUÇÃO</span>{{#if structureCreateIsConstruction}}<span>CUSTO DO PROJETO</span><span>MODO</span>{{/if}}</div>
            {{#each structureResourceOptions}}
              <div class="dm-resource-matrix__row">
                <strong>{{name}} {{#if unit}}<small>{{unit}}</small>{{/if}}</strong>
                <input name="maintenance:{{id}}" inputmode="decimal" placeholder="—" />
                <input name="production:{{id}}" inputmode="decimal" placeholder="—" />
                {{#if ../structureCreateIsConstruction}}<input name="cost:{{id}}" inputmode="decimal" placeholder="—" /><select name="costMode:{{id}}"><option value="reserved">Reservado</option><option value="progressive">Progressivo</option></select>{{/if}}
              </div>
            {{else}}<div class="dm-muted">Cadastre recursos no catálogo para configurar vetores econômicos.</div>{{/each}}
          </section>
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelCreateStructure">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitCreateStructure">{{#if structureCreateIsConstruction}}INICIAR CONSTRUÇÃO{{else}}REGISTRAR ATIVO{{/if}}</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if editingStructure}}
    <div class="dm-modal-layer">
      <form id="dm-structure-control-form" class="dm-system-dialog dm-system-dialog--wide dm-structure-dialog" autocomplete="off">
        <header class="dm-system-dialog__header">
          <div><span class="dm-kicker">CONTROLE DE INFRAESTRUTURA // {{editingStructure.entityId}}</span><h2>{{editingStructure.name}}</h2></div>
          <button type="button" class="dm-icon-button" data-action="closeStructureControl"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="dm-system-dialog__telemetry">
          <span><small>ESTADO</small><strong>{{editingStructure.statusLabel}}</strong></span>
          <span><small>CONDIÇÃO</small><strong>{{editingStructure.conditionDisplay}}</strong></span>
          <span><small>NÍVEL</small><strong>{{editingStructure.tier}} / {{editingStructure.maxTier}}</strong></span>
          <span><small>CAPACIDADE</small><strong>{{editingStructure.capacity}}</strong></span>
        </div>
        <div class="dm-system-dialog__body">
          <input type="hidden" name="expectedModifiedTime" value="{{editingStructure.expectedModifiedTime}}" />
          {{#if isGM}}
            <label class="dm-field"><span>Designação</span><input name="name" value="{{editingStructure.name}}" required /></label>
            <label class="dm-field"><span>Categoria</span><input name="category" value="{{editingStructure.rawCategory}}" required /></label>
            <label class="dm-field"><span>Nível</span><input name="tier" type="number" min="1" value="{{editingStructure.tier}}" required /></label>
            <label class="dm-field"><span>Nível máximo</span><input name="maxTier" type="number" min="1" value="{{editingStructure.maxTier}}" required /></label>
            <label class="dm-field"><span>Condição</span><input name="condition" type="number" min="0" max="100" value="{{editingStructure.condition}}" required /></label>
            <label class="dm-field"><span>Capacidade</span><input name="capacity" type="number" min="0" value="{{editingStructure.capacity}}" required /></label>
            <label class="dm-field"><span>Prioridade de manutenção</span><input name="maintenancePriority" type="number" min="0" max="100" value="{{editingStructure.maintenancePriority}}" required /></label>
            <label class="dm-field"><span>Trabalhadores necessários</span><input name="workforceRequired" type="number" min="0" value="{{editingStructure.workforceRequired}}" required /></label>
            <label class="dm-field"><span>Estado</span><select name="status">{{#each structureStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label class="dm-field"><span>Marcadores</span><input name="tags" value="{{#each editingStructure.tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}" /></label>
          {{else}}
            <label class="dm-field"><span>Estado operacional</span><select name="status">{{#each structureOperatorStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{/if}}
          <label class="dm-field dm-field--wide"><span>Descrição operacional</span><textarea name="description" rows="3">{{editingStructure.description}}</textarea></label>

          {{#if isGM}}
            <section class="dm-resource-matrix dm-field--wide">
              <header><div><span class="dm-kicker">FLUXO ECONÔMICO</span><h3>Manutenção e Produção</h3></div><span>valores por tick</span></header>
              <div class="dm-resource-matrix__head"><span>RECURSO</span><span>MANUTENÇÃO</span><span>PRODUÇÃO</span></div>
              {{#each structureResourceOptions}}
                <div class="dm-resource-matrix__row"><strong>{{name}} {{#if unit}}<small>{{unit}}</small>{{/if}}</strong><input name="maintenance:{{id}}" inputmode="decimal" value="{{maintenanceValue}}" placeholder="—" /><input name="production:{{id}}" inputmode="decimal" value="{{productionValue}}" placeholder="—" /></div>
              {{/each}}
            </section>
          {{/if}}
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="closeStructureControl">CANCELAR</button><button type="button" class="dm-action-button" data-action="submitStructureControl">SINCRONIZAR ATIVO</button></footer>
      </form>
    </div>
  {{/if}}

  {{#if pendingPopulationGroupRemoval}}
    <div class="dm-modal-layer"><section class="dm-system-dialog dm-project-cost-remove-dialog" role="dialog" aria-modal="true" aria-labelledby="dm-population-remove-title">
      <header class="dm-system-dialog__header"><div><span class="dm-kicker">POPULAÇÃO // CONFIRMAÇÃO</span><h2 id="dm-population-remove-title">Remover {{pendingPopulationGroupRemoval.name}}?</h2><p>O grupo será retirado do cadastro populacional deste domínio.</p></div><button type="button" class="dm-icon-button" data-action="cancelRemovePopulationGroup" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button></header>
      <div class="dm-system-dialog__body"><section class="dm-project-cost-remove-summary"><span><small>GRUPO</small><strong>{{pendingPopulationGroupRemoval.name}}</strong></span><span><small>POPULAÇÃO</small><strong>{{pendingPopulationGroupRemoval.count}}</strong></span><span><small>ELEGÍVEIS</small><strong>{{pendingPopulationGroupRemoval.workforceEligible}}</strong></span></section><div class="dm-project-dialog__guardrail"><i class="fa-solid fa-triangle-exclamation"></i><span><strong>REMOÇÃO PERMANENTE</strong><small>A operação será recusada se o grupo ou o domínio tiver mudado desde a abertura desta confirmação.</small></span></div></div>
      <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelRemovePopulationGroup">CANCELAR</button><button type="button" class="dm-action-button dm-action-button--critical" data-action="confirmRemovePopulationGroup"><i class="fa-solid fa-trash"></i> REMOVER GRUPO</button></footer>
    </section></div>
  {{/if}}

  {{#if pendingRelationRemoval}}
    <div class="dm-modal-layer"><section class="dm-system-dialog dm-project-cost-remove-dialog" role="dialog" aria-modal="true" aria-labelledby="dm-relation-remove-title">
      <header class="dm-system-dialog__header"><div><span class="dm-kicker">RELAÇÕES // CONFIRMAÇÃO</span><h2 id="dm-relation-remove-title">Remover relação com {{pendingRelationRemoval.targetName}}?</h2><p>O vínculo diplomático local será removido; acordos independentes permanecem preservados.</p></div><button type="button" class="dm-icon-button" data-action="cancelRemoveRelation" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button></header>
      <div class="dm-system-dialog__body"><section class="dm-project-cost-remove-summary"><span><small>CONTRAPARTE</small><strong>{{pendingRelationRemoval.targetName}}</strong></span><span><small>POSTURA</small><strong>{{pendingRelationRemoval.postureLabel}}</strong></span><span><small>ACORDOS</small><strong>PRESERVADOS</strong></span></section><div class="dm-project-dialog__guardrail"><i class="fa-solid fa-triangle-exclamation"></i><span><strong>CONFIRMAÇÃO NECESSÁRIA</strong><small>A revisão do domínio é validada novamente antes da remoção.</small></span></div></div>
      <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelRemoveRelation">CANCELAR</button><button type="button" class="dm-action-button dm-action-button--critical" data-action="confirmRemoveRelation"><i class="fa-solid fa-unlink"></i> REMOVER RELAÇÃO</button></footer>
    </section></div>
  {{/if}}

  {{#if pendingAgreementStatus}}
    <div class="dm-modal-layer"><section class="dm-system-dialog dm-project-cost-remove-dialog" role="dialog" aria-modal="true" aria-labelledby="dm-agreement-status-title">
      <header class="dm-system-dialog__header"><div><span class="dm-kicker">ACORDO // ENCERRAMENTO</span><h2 id="dm-agreement-status-title">Encerrar {{pendingAgreementStatus.name}}?</h2><p>O registro será preservado, mas seu ciclo de vida ficará definitivamente encerrado.</p></div><button type="button" class="dm-icon-button" data-action="cancelAgreementStatus" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button></header>
      <div class="dm-system-dialog__body"><section class="dm-project-cost-remove-summary"><span><small>ACORDO</small><strong>{{pendingAgreementStatus.name}}</strong></span><span><small>ESTADO ATUAL</small><strong>{{pendingAgreementStatus.fromLabel}}</strong></span><span><small>NOVO ESTADO</small><strong>{{pendingAgreementStatus.toLabel}}</strong></span></section><div class="dm-project-dialog__guardrail"><i class="fa-solid fa-lock"></i><span><strong>ESTADO TERMINAL</strong><small>Um acordo encerrado não pode ser reativado. Uma renegociação deve gerar um novo acordo.</small></span></div></div>
      <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelAgreementStatus">CANCELAR</button><button type="button" class="dm-action-button dm-action-button--critical" data-action="confirmAgreementStatus"><i class="fa-solid fa-ban"></i> ENCERRAR ACORDO</button></footer>
    </section></div>
  {{/if}}

  {{#if pendingIntelAction}}
    <div class="dm-modal-layer"><section class="dm-system-dialog dm-project-cost-remove-dialog" role="dialog" aria-modal="true" aria-labelledby="dm-intel-action-title">
      <header class="dm-system-dialog__header"><div><span class="dm-kicker">INTELIGÊNCIA // CONFIRMAÇÃO</span><h2 id="dm-intel-action-title">{{#if pendingIntelAction.isRemove}}Remover{{else}}Revelar{{/if}} {{pendingIntelAction.title}}?</h2><p>{{#if pendingIntelAction.isRemove}}A informação será excluída do domínio.{{else}}O conteúdo passará a ser público para todos os jogadores.{{/if}}</p></div><button type="button" class="dm-icon-button" data-action="cancelIntelAction" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button></header>
      <div class="dm-system-dialog__body"><section class="dm-project-cost-remove-summary"><span><small>INFORMAÇÃO</small><strong>{{pendingIntelAction.title}}</strong></span><span><small>VISIBILIDADE ATUAL</small><strong>{{pendingIntelAction.visibilityLabel}}</strong></span><span><small>DESTINO</small><strong>{{#if pendingIntelAction.isRemove}}EXCLUÍDA{{else}}PÚBLICA{{/if}}</strong></span></section><div class="dm-project-dialog__guardrail"><i class="fa-solid fa-triangle-exclamation"></i><span><strong>{{#if pendingIntelAction.isRemove}}REMOÇÃO PERMANENTE{{else}}DIVULGAÇÃO IRREVERSÍVEL{{/if}}</strong><small>A revisão do domínio será conferida novamente antes da operação.</small></span></div></div>
      <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelIntelAction">CANCELAR</button><button type="button" class="dm-action-button {{#if pendingIntelAction.isRemove}}dm-action-button--critical{{/if}}" data-action="confirmIntelAction"><i class="fa-solid {{#if pendingIntelAction.isRemove}}fa-trash{{else}}fa-eye{{/if}}"></i> {{#if pendingIntelAction.isRemove}}REMOVER{{else}}REVELAR AO PÚBLICO{{/if}}</button></footer>
    </section></div>
  {{/if}}

</div>
