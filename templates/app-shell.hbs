            {{#if selectedDomain.activeImage}}
              <img
                src="{{selectedDomain.activeImage}}"
                class="dm-base-hero__img"
                style="object-fit: {{selectedDomain.imageFit}}; object-position: {{selectedDomain.imagePosX}}% {{selectedDomain.imagePosY}}%; transform: scale({{selectedDomain.imageScale}});"
                alt="{{selectedDomain.name}}"
              />
