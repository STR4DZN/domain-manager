                    <span><strong>{{count}}</strong><small>{{#if includedInTotal}}incluído{{else}}externo{{/if}}</small></span>
                    <span><strong class="dm-tone-{{moraleTone}}">{{moraleDisplay}}</strong><small>{{quality}}</small></span>
                    <span><strong>{{assigned}} / {{workforceEligible}}</strong><small>{{available}} disponíveis</small></span>
                    <span class="dm-cohort-row__state"><em class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</em>{{#if canEdit}}<button type="button" class="dm-icon-button" data-action="openPopulationGroup" data-group-id="{{localId}}" title="Editar grupo populacional"><i class="fa-solid fa-pen"></i></button>{{/if}}</span>
                  </div>
                {{else}}<div class="dm-empty"><i class="fa-solid fa-people-group"></i><strong>NENHUM GRUPO CADASTRADO</strong><span>Crie um grupo para organizar população e força de trabalho.</span>{{#if canManagePopulation}}<button type="button" class="dm-action-button" data-action="openPopulationGroup">CRIAR PRIMEIRO GRUPO</button>{{/if}}</div>{{/each}}
              </section>
              <section class="dm-workforce-board">
