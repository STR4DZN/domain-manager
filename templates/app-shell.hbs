              <div class="dm-mod-box">
                <label>+DEF Defesa</label>
                <input type="number" class="dm-input dm-input--compact" id="dm-project-mod-def" value="0" />
              </div>
              <div class="dm-mod-box">
                <label>+/tick Renda</label>
                <input type="number" class="dm-input dm-input--compact" id="dm-project-mod-income" value="0" />
              </div>
              <div class="dm-mod-box">
                <label>-Agit Agitação</label>
                <input type="number" class="dm-input dm-input--compact" id="dm-project-mod-unrest" value="0" />
