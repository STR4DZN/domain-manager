            <div class="dm-force-grid">{{#each squads}}<article class="dm-squad-card {{#if controlledByMe}}is-controlled{{/if}}"><header><div><span class="dm-kicker">UNIDADE // {{entityIdShort}}</span><small>{{controllerLabel}}</small></div><span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span></header><div class="dm-squad-card__body"><div class="dm-force-glyph"><strong>{{strength}}</strong><small>/{{capacity}}</small></div><div><h3>{{name}}</h3><p>{{#if description}}{{description}}{{else}}Sem resumo operacional.{{/if}}</p><div class="dm-dual-meter"><div><span>MORAL</span><div class="dm-meter">{{#each moraleSegments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div><strong>{{moraleDisplay}}</strong></div><div><span>COND.</span><div class="dm-meter">{{#each conditionSegments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div><strong>{{conditionDisplay}}</strong></div></div></div></div><footer class="dm-squad-card__footer"><span><small>MISSÃO</small><strong>{{currentMissionName}}</strong></span><div>{{#if canUseSupply}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openSquadSupply" data-uuid="{{uuid}}">SUPRIMENTOS</button>{{/if}}{{#if canOperate}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openSquadControl" data-uuid="{{uuid}}">CONTROLE</button>{{/if}}</div></footer></article>{{else}}<div class="dm-empty dm-empty--force"><i class="fa-solid fa-person-military-rifle"></i><strong>NENHUMA FORÇA</strong><span>Crie uma unidade para começar a gerenciar suas forças.</span>{{#if canCreateSquad}}<button type="button" class="dm-action-button" data-action="openCreateSquad">CRIAR PRIMEIRA UNIDADE</button>{{/if}}</div>{{/each}}</div>
          </section>
        {{/if}}

        {{#if view.missions}}
          <section class="dm-view dm-view--missions dm-page--forensic dm-mission-control"><header class="dm-view-header"><div><span class="dm-kicker">OPERAÇÕES // MISSÕES</span><h2>Missões</h2><p>Crie, prepare, inicie e resolva missões.</p></div><div class="dm-view-header__actions"><span class="dm-view-code">{{missions.length}} MISSÃO(ÕES)</span>{{#if canCreateMission}}<button type="button" class="dm-action-button" data-action="openCreateMission"><i class="fa-solid fa-plus"></i> NOVA MISSÃO</button>{{/if}}</div></header>
            <div class="dm-mission-list">{{#each missions}}<article class="dm-mission-card dm-mission-card--{{status}}"><div class="dm-mission-card__summary"><i class="fa-solid fa-clipboard-check"></i><strong>{{completedObjectives}} / {{objectiveCount}}</strong><small>OBJETIVOS</small></div><div class="dm-mission-card__body"><header><span class="dm-kicker">MISSÃO // {{entityIdShort}}</span><span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span></header><h3>{{name}}</h3><p>{{description}}</p><div class="dm-mission-telemetry"><span><small>VISIBILIDADE</small><strong>{{audienceLabel}}</strong></span><span><small>OBJETIVOS</small><strong>{{completedObjectives}} / {{objectiveCount}}</strong></span><span><small>FALHOU</small><strong>{{failedObjectives}}</strong></span><span><small>UNIDADES</small><strong>{{assignmentCount}}</strong></span></div><div class="dm-objective-grid">{{#each objectives}}<div class="dm-objective-row is-{{status}}"><span class="dm-objective-row__status"></span><div><strong>{{title}}</strong>{{#if description}}<small>{{description}}</small>{{/if}}</div><span>{{status}}</span></div>{{else}}<div class="dm-muted">SEM OBJETIVOS</div>{{/each}}</div>{{#if assignments.length}}<div class="dm-mission-units"><div class="dm-mission-subhead"><span>UNIDADES DESIGNADAS</span><strong>{{assignmentCount}}</strong></div>{{#each assignments}}<div class="dm-mission-unit"><div class="dm-mission-unit__id"><span class="dm-status-pip dm-status-pip--{{../tone}}"></span><div><strong>{{squadName}}</strong><small>{{stateLabel}} · {{committedStrength}} efetivo</small></div></div><div class="dm-mission-unit__resources">{{#each resources}}<span>{{name}} <strong>{{amountDisplay}}{{#if unit}} {{unit}}{{/if}}</strong></span>{{else}}<span>SEM SUPRIMENTOS DESIGNADOS</span>{{/each}}</div>{{#if canRelease}}<button type="button" class="dm-icon-button" title="Liberar unidade" data-action="releaseMissionAssignment" data-mission-uuid="{{../uuid}}" data-squad-uuid="{{squadUuid}}"><i class="fa-solid fa-link-slash"></i></button>{{/if}}</div>{{/each}}</div>{{/if}}{{#if isAvailable}}<div class="dm-mission-ready-units"><div class="dm-mission-subhead"><span>FORÇAS DISPONÍVEIS</span><strong>{{eligibleSquads.length}}</strong></div><div class="dm-mission-ready-grid">{{#each eligibleSquads}}<button type="button" class="dm-mission-ready-unit {{#if isPrepared}}is-prepared{{/if}}" data-action="openMissionPrepare" data-mission-uuid="{{../uuid}}" data-squad-uuid="{{uuid}}"><span><strong>{{name}}</strong><small>{{strength}} / {{capacity}} · {{statusLabel}}</small></span><span>{{prepareLabel}}</span></button>{{else}}<div class="dm-muted">NENHUMA FORÇA DISPONÍVEL</div>{{/each}}</div></div>{{/if}}{{#if outcomeSummary}}<div class="dm-mission-outcome"><span>RELATÓRIO FINAL</span><p>{{outcomeSummary}}</p></div>{{/if}}<footer class="dm-mission-card__actions">{{#if canEdit}}<button type="button" class="dm-action-button dm-action-button--secondary" data-action="openEditMission" data-mission-uuid="{{uuid}}"><i class="fa-solid fa-pen"></i> EDITAR</button>{{/if}}{{#if canPublish}}<button type="button" class="dm-action-button" data-action="publishMission" data-mission-uuid="{{uuid}}"><i class="fa-solid fa-bullhorn"></i> DISPONIBILIZAR</button>{{/if}}{{#if canLaunch}}<button type="button" class="dm-action-button" data-action="launchMission" data-mission-uuid="{{uuid}}"><i class="fa-solid fa-play"></i> INICIAR MISSÃO</button>{{/if}}{{#if canResolve}}<button type="button" class="dm-action-button dm-action-button--critical" data-action="openMissionResolve" data-mission-uuid="{{uuid}}"><i class="fa-solid fa-flag-checkered"></i> RESOLVER MISSÃO</button>{{/if}}</footer></div></article>{{else}}<div class="dm-empty dm-empty--force"><i class="fa-solid fa-clipboard-list"></i><strong>NENHUMA MISSÃO CADASTRADA</strong><span>As missões aparecerão aqui quando forem cadastradas.</span>{{#if canCreateMission}}<button type="button" class="dm-action-button" data-action="openCreateMission">CRIAR PRIMEIRA MISSÃO</button>{{/if}}</div>{{/each}}</div>
          </section>
        {{/if}}

        {{#if view.security}}
          <section class="dm-view dm-view--security dm-page--forensic">
            <header class="dm-view-header">
              <div><span class="dm-kicker">OPERAÇÕES // DEFESA</span><h2>Defesa</h2><p>Defesa, guarnição, fortificações e riscos do domínio.</p></div>
              <div class="dm-view-header__actions"><span class="dm-view-code">DEFESA // {{defense.effectiveDefense}}</span>{{#if canManageSecurity}}<button type="button" class="dm-action-button" data-action="openSecurityEditor"><i class="fa-solid fa-shield-halved"></i> CONFIGURAR DEFESA</button>{{/if}}</div>
