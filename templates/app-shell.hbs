          <h3 class="dm-section-title"><i class="fa-solid fa-book-journal-whills"></i> Livro de Crônicas Completo</h3>
          {{#if isGM}}
            <button type="button" class="dm-btn dm-btn--outline dm-btn--sm" data-action="openAddHistoryModal">
              <i class="fa-solid fa-plus"></i> Nova Crônica
            </button>
          {{/if}}
        </div>

        {{#if fullHistory.length}}
          <ul class="dm-feed">
            {{#each fullHistory}}
              <li class="dm-feed__item is-{{category}}">
                <div class="dm-feed__body">
                  <div class="dm-feed__top-row">
                    <strong class="dm-feed__title">{{title}}</strong>
                    <div class="dm-row-actions">
                      <span class="dm-feed__date">{{timestamp}}</span>
                      {{#if @root.isGM}}
                        <button type="button" class="dm-icon-btn" data-action="openEditHistoryModal" data-index="{{@index}}" title="Editar Crônica">
                          <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button type="button" class="dm-icon-btn dm-icon-btn--danger" data-action="deleteHistory" data-index="{{@index}}" title="Excluir Crônica">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      {{/if}}
                    </div>
                  </div>
                  {{#if summary}}<p class="dm-feed__summary">{{summary}}</p>{{/if}}
                  {{#if details}}<p class="dm-feed__details">{{details}}</p>{{/if}}
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="dm-empty-state">Nenhum registro histórico registrado.</p>
        {{/if}}
      </div>
    {{/if}}
</div>
{{#if isNotificationModalOpen}}
  <div class="dm-modal-backdrop">
    <div class="dm-modal dm-modal--sm">
      <header class="dm-modal__header">
        <h3><i class="fa-solid fa-bullhorn text-crimson"></i> Emitir Notificação Oficial</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelNotificationModal"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <div class="dm-modal__body">
        <div class="dm-form-group">
          <label for="dm-notif-title">Título do Aviso *</label>
          <input type="text" id="dm-notif-title" class="dm-input" placeholder="Ex: Ataque Iminente, Crise de Fome, Decreto..." required />
        </div>
        <div class="dm-form-group">
          <label for="dm-notif-severity">Severidade / Nível de Urgência</label>
          <select id="dm-notif-severity" class="dm-select">
            <option value="info">Informativo (Azul)</option>
            <option value="warning">Atenção / Alerta (Amarelo)</option>
            <option value="critical">Crítico / Urgente (Vermelho)</option>
            <option value="success">Comemoração / Sucesso (Verde)</option>
          </select>
        </div>
        <div class="dm-form-group">
          <label for="dm-notif-target-tab">Vincular a uma Seção (Opcional)</label>
          <select id="dm-notif-target-tab" class="dm-select">
            <option value="overview">Visão Geral</option>
            <option value="economy">Economia & Finanças</option>
            <option value="projects">Obras & Projetos</option>
            <option value="people">População & Notáveis</option>
            <option value="diplomacy">Diplomacia & Acordos</option>
            <option value="intel">Intel & Segredos</option>
            <option value="history">Crônicas & Histórico</option>
          </select>
        </div>
        <div class="dm-form-group">
          <label for="dm-notif-message">Mensagem / Ordens Oficiais</label>
          <textarea id="dm-notif-message" class="dm-textarea" rows="4" placeholder="Descreva a mensagem ou ordem oficial que os jogadores devem ler na Visão Geral..."></textarea>
        </div>
      </div>
      <footer class="dm-modal__footer">
        <button type="button" class="dm-btn dm-btn--ghost" data-action="cancelNotificationModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitNotification"><i class="fa-solid fa-paper-plane"></i> Publicar Aviso</button>
      </footer>
    </div>
  </div>
{{/if}}


{{#if isEditingNotableStatsModal}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact" style="max-width: 680px;">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-user-pen text-crimson"></i> Editar Dossiê Operacional // {{activeNotableDossier.name}}</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelNotableStatsModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable" style="max-height: 70vh;">
        <!-- Seção 1: Identidade e Cargo -->
        <span class="dm-biomonitor__subhead mb-2">// 01. DADOS DE IDENTIFICAÇÃO & DESIGNAÇÃO</span>
        <div class="dm-form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          <div class="dm-form-group">
            <label for="dm-dossier-edit-name">Nome do Agente:</label>
            <input type="text" id="dm-dossier-edit-name" class="dm-input dm-input--compact" value="{{activeNotableDossier.name}}" required />
          </div>
          <div class="dm-form-group">
            <label for="dm-dossier-edit-role">Cargo / Função:</label>
            <input type="text" id="dm-dossier-edit-role" class="dm-input dm-input--compact" value="{{activeNotableDossier.role}}" placeholder="Ex: Conselheiro, Espião, General" />
          </div>
          <div class="dm-form-group">
            <label for="dm-dossier-edit-spec">Especialização Tática:</label>
            <input type="text" id="dm-dossier-edit-spec" class="dm-input dm-input--compact" value="{{activeNotableDossier.specialization}}" placeholder="Ex: Infiltração, Operações Táticas" />
          </div>
          <div class="dm-form-group">
            <label for="dm-dossier-edit-status">Status Operacional:</label>
            <select id="dm-dossier-edit-status" class="dm-select dm-select--compact">
              <option value="active" {{#if (eq activeNotableDossier.status 'active')}}selected{{/if}}>Disponível na Base</option>
              <option value="away" {{#if (eq activeNotableDossier.status 'away')}}selected{{/if}}>Em Missão de Campo</option>
              <option value="unavailable" {{#if (eq activeNotableDossier.status 'unavailable')}}selected{{/if}}>Indisponível / Ferido</option>
              <option value="missing" {{#if (eq activeNotableDossier.status 'missing')}}selected{{/if}}>Desaparecido</option>
              <option value="dead" {{#if (eq activeNotableDossier.status 'dead')}}selected{{/if}}>Falecido</option>
              <option value="retired" {{#if (eq activeNotableDossier.status 'retired')}}selected{{/if}}>Aposentado</option>
            </select>
          </div>
          <div class="dm-form-group">
            <label for="dm-dossier-edit-loyalty">Lealdade:</label>
            <input type="text" id="dm-dossier-edit-loyalty" class="dm-input dm-input--compact" value="{{activeNotableDossier.loyalty}}" placeholder="Alta, Média, Baixa" />
          </div>
          <div class="dm-form-group">
            <label for="dm-dossier-edit-missions">Missões Cumpridas:</label>
            <input type="number" id="dm-dossier-edit-missions" class="dm-input dm-input--compact" min="0" value="{{activeNotableDossier.missionsCount}}" />
          </div>
        </div>

        <!-- Seção 2: Atributos Táticos Operacionais (0 a 20) -->
        <span class="dm-biomonitor__subhead mt-3 mb-2">// 02. ATRIBUTOS TÁTICOS OPERACIONAIS (0 A 20)</span>
        <div class="dm-form-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
          <div class="dm-form-group">
            <label for="dm-stat-combat">⚔️ Combate:</label>
            <input type="number" id="dm-stat-combat" class="dm-input dm-input--compact" min="0" max="20" value="{{activeNotableDossier.attributes.combat}}" />
          </div>
          <div class="dm-form-group">
            <label for="dm-stat-stealth">🎯 Furtividade:</label>
            <input type="number" id="dm-stat-stealth" class="dm-input dm-input--compact" min="0" max="20" value="{{activeNotableDossier.attributes.stealth}}" />
          </div>
          <div class="dm-form-group">
            <label for="dm-stat-cunning">🧠 Astúcia:</label>
            <input type="number" id="dm-stat-cunning" class="dm-input dm-input--compact" min="0" max="20" value="{{activeNotableDossier.attributes.cunning}}" />
          </div>
          <div class="dm-form-group">
            <label for="dm-stat-diplomacy">🤝 Diplomacia:</label>
            <input type="number" id="dm-stat-diplomacy" class="dm-input dm-input--compact" min="0" max="20" value="{{activeNotableDossier.attributes.diplomacy}}" />
          </div>
          <div class="dm-form-group">
            <label for="dm-stat-technique">🛠️ Técnica:</label>
            <input type="number" id="dm-stat-technique" class="dm-input dm-input--compact" min="0" max="20" value="{{activeNotableDossier.attributes.technique}}" />
          </div>
          <div class="dm-form-group">
            <label for="dm-stat-survival">🛡️ Sobrevivência:</label>
            <input type="number" id="dm-stat-survival" class="dm-input dm-input--compact" min="0" max="20" value="{{activeNotableDossier.attributes.survival}}" />
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelNotableStatsModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitNotableStats"><i class="fa-solid fa-check"></i> Salvar Dossiê</button>
      </div>
    </div>
  </div>
{{/if}}

      </main>
    </div>
  </div>

  <footer class="dm-footer" aria-label="Estado técnico do módulo">
  <div class="dm-footer__left">
    <span><strong>{{localize 'DOMAIN_MANAGER.Footer.User'}}:</strong> {{userName}}</span>
    <span><strong>{{localize 'DOMAIN_MANAGER.Footer.Foundry'}}:</strong> {{foundryVersion}}</span>
  </div>

  {{#if isGM}}
    <div class="dm-footer__right">
      <span>
        <strong>{{localize 'DOMAIN_MANAGER.Footer.Authority'}}:</strong>
        {{#if authorityReady}}
          <span class="dm-status-dot is-active"></span> {{localize 'DOMAIN_MANAGER.Footer.AuthorityReady'}}
        {{else}}
          <span class="dm-status-dot is-inactive"></span> {{localize 'DOMAIN_MANAGER.Footer.AuthorityDisconnected'}}
        {{/if}}
      </span>
      <span><strong>{{localize 'DOMAIN_MANAGER.Footer.IndexedDomains'}}:</strong> {{counts.domains}}</span>
      <span><strong>{{localize 'DOMAIN_MANAGER.Footer.SyncStatus'}}:</strong> {{timekeeping.tickDurationLabel}}</span>
    </div>
  {{/if}}
</footer>

</div>
