                <option value="Inabalável">Inabalável</option>
                <option value="Alta" selected>Alta</option>
                <option value="Estável">Estável</option>
                <option value="Duvidosa">Duvidosa</option>
              </select>
            </div>
            <div class="dm-form-group">
              <label>Status:</label>
              <select class="dm-select" id="dm-notable-status">
                <option value="active" selected>Ativo / Presente</option>
                <option value="away">Em Missão / Ausente</option>
                <option value="unavailable">Indisponível</option>
                <option value="retired">Aposentado</option>
              </select>
            </div>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelNotableModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitNotable"><i class="fa-solid fa-check"></i> Salvar Notável</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if isGroupModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-people-group text-emerald"></i> Adicionar Grupo Populacional</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelGroupModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
