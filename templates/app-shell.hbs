              <div class="dm-base-hero__placeholder">
                <i class="fa-solid fa-mountain-sun dm-base-hero__placeholder-icon"></i>
                <span>Nenhuma ilustração definida para esta base</span>
              </div>
            {{/if}}

            <div class="dm-base-hero__overlay">
              <div class="dm-base-hero__text">
                <h2 class="dm-base-hero__name">{{selectedDomain.name}}</h2>
                <div class="dm-base-hero__tags">
                  <span class="dm-pill dm-pill--category">{{selectedDomain.categoryLabel}}</span>
                  <span class="dm-pill dm-pill--nature">{{selectedDomain.natureLabel}}</span>
                  <span class="dm-badge dm-badge--{{selectedDomain.state}}">{{selectedDomain.stateLabel}}</span>
                </div>
              </div>

              <div class="dm-base-hero__actions">
                {{#if @root.isGM}}
                  <button type="button" class="dm-btn dm-btn--outline dm-btn--xs dm-base-hero__edit-btn" data-action="openEditDomain" title="Editar Base e Galeria">
                    <i class="fa-solid fa-camera"></i>
                    <span>Editar Imagens</span>
                  </button>
                {{/if}}
              </div>
            </div>

            <!-- Faixa Seletora de Miniaturas da Galeria (Múltiplas Imagens) -->
            {{#if selectedDomain.hasMultipleImages}}
              <div class="dm-base-gallery-strip">
                {{#each selectedDomain.allImages}}
                  <button type="button" class="dm-gallery-thumb-btn {{#if (eq this @root.selectedDomain.activeImage)}}is-active{{/if}}" data-action="selectGalleryImage" data-src="{{this}}" title="Ver imagem">
                    <img src="{{this}}" class="dm-gallery-thumb-img" alt="Foto {{@index}}" />
                  </button>
                {{/each}}
              </div>
            {{/if}}
          </div>
        {{/if}}

        {{#if selectedDomain.description}}
