              <input type="number" step="0.1" min="0" class="dm-input dm-input--compact" id="dm-upkeep-water-rate" value="{{#if sustenanceSettings.waterPer100}}{{sustenanceSettings.waterPer100}}{{else}}1.0{{/if}}" />
            </div>
          </div>

          <div class="dm-form-group">
            <label>Manutenção / Soldo por Guarda (Créditos / Tick):</label>
            <input type="number" step="0.1" min="0" class="dm-input dm-input--compact" id="dm-upkeep-guard-rate" value="{{#if sustenanceSettings.guardUpkeep}}{{sustenanceSettings.guardUpkeep}}{{else}}1.0{{/if}}" />
          </div>

          <div class="dm-prose mt-1">
            <p class="dm-text-muted" style="font-size: 0.85em;">
              <i class="fa-solid fa-info-circle text-blue"></i> Quando os estoques de alimento ou água chegam a zero, o motor temporal dispara crise de fome, elevando a agitação civil e reduzindo a satisfação.
            </p>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelUpkeepModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitUpkeep"><i class="fa-solid fa-floppy-disk"></i> Salvar Configurações</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 22. MODAL: EDITAR ESTOQUE (GM) -->
{{#if isEditingStockModal}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-cubes-stacked text-amber"></i> Editar Estoque: {{editingStock.name}}</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelEditStockModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Recurso:</label>
            <input type="text" class="dm-input dm-input--compact" value="{{editingStock.name}} ({{editingStock.resourceId}})" disabled />
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Estoque Total:</label>
              <input type="number" step="any" class="dm-input dm-input--compact" id="dm-edit-stock-amount" value="{{editingStock.stockAmountMajor}}" />
            </div>
            <div class="dm-form-group">
              <label>Quantidade Reservada:</label>
              <input type="number" step="any" class="dm-input dm-input--compact" id="dm-edit-stock-reserved" value="{{editingStock.reservedAmountMajor}}" />
            </div>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelEditStockModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitEditStock"><i class="fa-solid fa-floppy-disk"></i> Salvar Estoque</button>
      </div>
    </div>
  </div>
{{/if}}

<!-- 23. MODAL: EDITAR FLUXO ECONÔMICO (GM) -->
{{#if isEditingFlowModal}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-arrow-right-arrow-left text-amber"></i> Editar Fluxo: {{editingFlow.name}}</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelEditFlowModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Nome / Descrição do Fluxo *</label>
            <input type="text" class="dm-input dm-input--compact" id="dm-edit-flow-name" value="{{editingFlow.name}}" />
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Direção:</label>
              <select class="dm-select dm-input--compact" id="dm-edit-flow-direction">
                <option value="inflow" {{#if (eq editingFlow.direction 'inflow')}}selected{{/if}}>Entrada (Receita)</option>
                <option value="outflow" {{#if (eq editingFlow.direction 'outflow')}}selected{{/if}}>Saída (Despesa)</option>
              </select>
            </div>
            <div class="dm-form-group">
              <label>Recurso:</label>
              <select class="dm-select dm-input--compact" id="dm-edit-flow-resource">
                {{#each availableResources}}
                  <option value="{{id}}" {{#if (eq id @root.editingFlow.resourceId)}}selected{{/if}}>{{name}} ({{id}})</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Quantidade por Período:</label>
              <input type="number" step="any" class="dm-input dm-input--compact" id="dm-edit-flow-amount" value="{{editingFlow.displayAmount}}" />
            </div>
            <div class="dm-form-group">
              <label>Período (Ticks):</label>
              <input type="number" min="1" class="dm-input dm-input--compact" id="dm-edit-flow-period" value="{{editingFlow.periodTicks}}" />
            </div>
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>Categoria:</label>
              <input type="text" class="dm-input dm-input--compact" id="dm-edit-flow-category" value="{{editingFlow.category}}" />
            </div>
            <div class="dm-form-group">
              <label>Status:</label>
              <select class="dm-select dm-input--compact" id="dm-edit-flow-active">
                <option value="true" {{#if editingFlow.active}}selected{{/if}}>Ativo</option>
                <option value="false" {{#unless editingFlow.active}}selected{{/unless}}>Inativo</option>
              </select>
            </div>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelEditFlowModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitEditFlow"><i class="fa-solid fa-floppy-disk"></i> Salvar Fluxo</button>
      </div>
    </div>
  </div>
{{/if}}

