                      <span class="dm-person-list-row__main"><strong>{{name}}</strong><small>{{role}}{{#if specialization}} · {{specialization}}{{/if}}</small></span>
                      <span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span>
                    </button>
                  {{else}}
                    <div class="dm-empty dm-empty--people"><i class="fa-solid fa-users"></i><strong>Nenhuma pessoa cadastrada</strong><span>Use “Nova pessoa” para adicionar personagens e pessoas importantes.</span>{{#if canManagePeople}}<button type="button" class="dm-action-button" data-action="openPersonEditor">NOVA PESSOA</button>{{/if}}</div>
                  {{/each}}
                </div>
              </section>

              <section class="dm-person-profile" aria-label="Detalhes da pessoa selecionada">
