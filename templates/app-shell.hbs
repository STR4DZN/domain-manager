                  {{#if selectedPerson.tags.length}}<section class="dm-person-profile__section"><h4>Marcadores</h4><div class="dm-tag-list">{{#each selectedPerson.tags}}<span>{{this}}</span>{{/each}}</div></section>{{/if}}
                  <footer class="dm-person-profile__footer"><span>{{selectedPerson.entityId}}</span>{{#if selectedPerson.legacy}}<strong>Registro legado · somente leitura</strong>{{/if}}</footer>
                {{else}}
                  <div class="dm-empty dm-empty--person-detail"><i class="fa-solid fa-user"></i><strong>Selecione uma pessoa</strong><span>Os detalhes aparecem aqui sem abrir outra janela.</span></div>
                {{/if}}
              </section>
            </div>
          </section>
        {{/if}}

        {{#if view.structures}}
          <section class="dm-view dm-view--structures dm-page--structures dm-page--infrastructure">
            <header class="dm-view-header"><div><span class="dm-kicker">BASE // INFRAESTRUTURA</span><h2>Infraestrutura</h2><p>Estruturas, condição, manutenção, produção e capacidade.</p></div><div class="dm-view-header__actions"><span class="dm-view-code">{{structures.length}} ESTRUTURA(S)</span>{{#if canBeginStructureConstruction}}<button type="button" class="dm-action-button" data-action="openCreateStructure" data-mode="construction"><i class="fa-solid fa-compass-drafting"></i> CONSTRUIR</button>{{/if}}{{#if canRegisterStructure}}<button type="button" class="dm-action-button dm-action-button--secondary" data-action="openCreateStructure" data-mode="direct"><i class="fa-solid fa-building-circle-check"></i> CADASTRAR</button>{{/if}}</div></header>
            <div class="dm-infra-bus"><span><small>CADASTRADOS</small><strong>{{structureStats.total}}</strong></span><span><small>ATIVOS</small><strong>{{structureStats.operational}}</strong></span><span><small>PLANEJADAS</small><strong>{{structureStats.planned}}</strong></span><span><small>DANIFICADAS</small><strong>{{structureStats.damaged}}</strong></span><span><small>INATIVAS</small><strong>{{structureStats.disabled}}</strong></span><i></i></div>
            <div class="dm-infrastructure-grid">
              {{#each structures}}
                <article class="dm-infrastructure-card dm-infrastructure-card--{{status}}">
                  <header class="dm-infrastructure-card__header"><div><span class="dm-kicker">ESTRUTURA // {{category}}</span><span class="dm-row-code">{{entityId}}</span></div><span class="dm-chip dm-chip--{{tone}}">{{statusLabel}}</span></header>
                  <div class="dm-infrastructure-card__title"><div><h3>{{name}}</h3>{{#if description}}<p>{{description}}</p>{{else}}<p class="dm-muted">Sem descrição técnica.</p>{{/if}}</div><div class="dm-infrastructure-card__tier"><small>NÍVEL</small><strong>{{tier}}</strong><span>/{{maxTier}}</span></div></div>
                  <div class="dm-infrastructure-card__condition"><div><span>CONDIÇÃO</span><strong>{{conditionDisplay}}</strong></div><div class="dm-meter">{{#each conditionSegments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div></div>
                  <div class="dm-infrastructure-vectors"><section><header><span>MANUTENÇÃO / T</span><i class="fa-solid fa-arrow-trend-down"></i></header>{{#each maintenance}}<div><span>{{name}}</span><strong>-{{displayAmount}} {{unit}}</strong></div>{{else}}<div class="dm-muted">SEM MANUTENÇÃO</div>{{/each}}</section><section><header><span>PRODUÇÃO / T</span><i class="fa-solid fa-arrow-trend-up"></i></header>{{#each production}}<div><span>{{name}}</span><strong>+{{displayAmount}} {{unit}}</strong></div>{{else}}<div class="dm-muted">SEM PRODUÇÃO</div>{{/each}}</section></div>
                  {{#if project}}<div class="dm-construction-link"><header><span class="dm-kicker">PROJETO VINCULADO</span><span class="dm-chip dm-chip--{{project.tone}}">{{project.statusLabel}}</span></header><div><strong>{{project.name}}</strong><span>{{project.progressDisplay}}</span></div><div class="dm-meter">{{#each project.segments}}<span class="{{#if on}}is-on{{/if}}"></span>{{/each}}</div></div>{{/if}}
                  <footer class="dm-infrastructure-card__footer"><span><small>CAPACIDADE</small><strong>{{capacity}}</strong></span><span><small>FLUXOS</small><strong>{{maintenance.length}} / {{production.length}}</strong></span>{{#if canOperate}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openStructureControl" data-structure-uuid="{{uuid}}"><i class="fa-solid fa-sliders"></i> CONTROLE</button>{{else}}{{#if canAdmin}}<button type="button" class="dm-action-button dm-action-button--secondary dm-action-button--compact" data-action="openStructureControl" data-structure-uuid="{{uuid}}"><i class="fa-solid fa-screwdriver-wrench"></i> GERENCIAR</button>{{/if}}{{/if}}</footer>
                </article>
              {{else}}<div class="dm-empty dm-empty--infrastructure"><i class="fa-solid fa-city"></i><strong>NENHUMA ESTRUTURA CADASTRADA</strong><span>Construa ou cadastre a primeira estrutura.</span>{{#if canBeginStructureConstruction}}<button type="button" class="dm-action-button" data-action="openCreateStructure" data-mode="construction">INICIAR CONSTRUÇÃO</button>{{/if}}</div>{{/each}}
            </div>
          </section>
