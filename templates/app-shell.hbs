              <div class="dm-mod-box">
                <label>+Pop População</label>
                <input type="number" class="dm-input dm-input--compact" id="dm-project-mod-pop" value="0" />
              </div>
            </div>
          </div>

          <div class="dm-form-group">
            <label>Descrição da Obra:</label>
            <textarea class="dm-textarea" id="dm-project-desc" rows="2" placeholder="Propósito e detalhes da construção..."></textarea>
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelProjectModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitProject"><i class="fa-solid fa-hammer"></i> Iniciar Projeto</button>
      </div>
    </div>
