            <div><small>REGISTRO SELECIONADO</small><strong>{{domainDeleteReport.domain.name}}</strong><code>{{domainDeleteReport.domain.entityId}}</code></div>
            <em class="dm-chip dm-chip--{{#if domainDeleteReport.blocked}}critical{{else}}warning{{/if}}">{{domainDeleteReport.total}} VINCULAÇÃO(ÕES)</em>
          </section>
          {{#if domainDeleteReport.blocked}}
            <section class="dm-domain-delete-blocked"><i class="fa-solid fa-shield-halved"></i><div><strong>Exclusão bloqueada para proteger os dados relacionados.</strong><p>Abra as áreas indicadas, reatribua ou encerre cada vínculo e volte a esta confirmação.</p></div></section>
            <div class="dm-domain-dependency-list">
              {{#each domainDeleteReport.groups}}
                <section class="dm-domain-dependency-group">
                  <header><div><strong>{{label}}</strong><small>Área: {{view}}</small></div><span>{{count}}</span></header>
                  <div>{{#each items}}<article><span><strong>{{name}}</strong><small>{{entityId}}</small></span><em>{{detail}}</em></article>{{/each}}</div>
                </section>
              {{/each}}
            </div>
          {{else}}
            <section class="dm-domain-delete-ready"><i class="fa-solid fa-triangle-exclamation"></i><div><strong>Nenhuma dependência foi encontrada.</strong><p>Esta operação remove o JournalEntry e não pode ser desfeita pela interface. Digite o identificador abaixo para habilitar a ação final.</p></div></section>
            <label class="dm-field dm-field--wide"><span>Confirmação obrigatória</span><input name="confirmation" data-domain-delete-confirmation data-confirmation="{{domainDeleteReport.domain.entityId}}" placeholder="Digite {{domainDeleteReport.domain.entityId}}" spellcheck="false" /></label>
          {{/if}}
        </div>
        <footer class="dm-system-dialog__footer"><button type="button" class="dm-action-button dm-action-button--secondary" data-action="cancelDeleteDomain" {{#if isDomainBusy}}disabled{{/if}}>CANCELAR</button>{{#if domainDeleteReport.blocked}}<button type="button" class="dm-action-button dm-action-button--critical" disabled><i class="fa-solid fa-lock"></i> EXCLUSÃO BLOQUEADA</button>{{else}}<button type="button" class="dm-action-button dm-action-button--critical" data-action="submitDeleteDomain" data-domain-delete-submit disabled><i class="fa-solid fa-trash"></i> EXCLUIR PERMANENTEMENTE</button>{{/if}}</footer>
      </form>
    </div>
  {{/if}}


