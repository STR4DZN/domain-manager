        <div class="dm-form-grid mt-2">
          <div class="dm-form-group">
            <label>Nome do Grupo *</label>
            <input type="text" class="dm-input" id="dm-group-name" placeholder="Ex: Mineiros das Crateras, Cidadãos da Capital..." />
          </div>
          <div class="dm-form-row">
            <div class="dm-form-group">
              <label>População (Contagem):</label>
              <input type="number" class="dm-input" id="dm-group-count" value="1000" />
            </div>
            <div class="dm-form-group">
              <label>Satisfação:</label>
              <select class="dm-select" id="dm-group-happiness">
                <option value="Muito Alta">Muito Alta (Agitação 0)</option>
                <option value="Estável" selected>Estável (Agitação 2)</option>
                <option value="Insatisfeito">Insatisfeito (Agitação 6)</option>
                <option value="Rebelde">Rebelde / Em Revolta (Agitação 9)</option>
              </select>
            </div>
          </div>
          <div class="dm-form-group">
            <label>Ajuste Fino de Agitação (Opcional, 0 a 10):</label>
            <input type="number" class="dm-input" id="dm-group-unrest" min="0" max="10" placeholder="Automático pela satisfação" />
          </div>
        </div>
      </div>
      <div class="dm-dialog-card__actions">
        <button type="button" class="dm-btn dm-btn--outline" data-action="cancelGroupModal">Cancelar</button>
        <button type="button" class="dm-btn dm-btn--primary" data-action="submitGroup"><i class="fa-solid fa-check"></i> Adicionar Grupo</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if isRelationModalOpen}}
  <div class="dm-overlay-panel">
    <div class="dm-dialog-card dm-modal-compact">
      <div class="dm-dialog-card__header">
        <h3><i class="fa-solid fa-handshake text-purple"></i> Nova Relação Diplomática</h3>
        <button type="button" class="dm-icon-btn" data-action="cancelRelationModal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="dm-dialog-card__body dm-scrollable">
        <div class="dm-form-grid">
          <div class="dm-form-group">
            <label>Domínio Parceiro *</label>
            <select class="dm-select" id="dm-relation-target">
              {{#each availableParentDomains}}
                <option value="{{uuid}}">{{name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="dm-form-group">
            <label>Postura Diplomática:</label>
            <select class="dm-select" id="dm-relation-posture">
              <option value="allied">Aliança Firme</option>
              <option value="friendly">Amigável / Cooperativo</option>
              <option value="neutral" selected>Neutro</option>
              <option value="tense">Tenso / Fricção</option>
              <option value="hostile">Hostil / Beligerante</option>
              <option value="at_war">Em Guerra Declarada</option>
