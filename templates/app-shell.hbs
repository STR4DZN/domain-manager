                    <div class="dm-person-profile__identity"><span class="dm-kicker">PESSOA SELECIONADA</span><h3>{{selectedPerson.name}}</h3><p>{{selectedPerson.role}}{{#if selectedPerson.specialization}} · {{selectedPerson.specialization}}{{/if}}</p><span class="dm-chip dm-chip--{{selectedPerson.tone}}">{{selectedPerson.statusLabel}}</span></div>
                    {{#if selectedPerson.canEdit}}<button type="button" class="dm-action-button dm-action-button--secondary" data-action="openPersonEditor" data-uuid="{{selectedPerson.uuid}}"><i class="fa-solid fa-pen"></i> EDITAR</button>{{/if}}
                  </header>
                  <div class="dm-person-profile__facts">
                    <article><small>Moral</small><strong>{{selectedPerson.moraleDisplay}}</strong></article>
                    <article><small>Condição</small><strong>{{selectedPerson.conditionDisplay}}</strong></article>
                    <article><small>Unidade</small><strong>{{#if selectedPerson.squad}}{{selectedPerson.squad.entityId}}{{else}}—{{/if}}</strong></article>
                    <article><small>Ator vinculado</small><strong>{{#if selectedPerson.actorUuid}}Sim{{else}}Não{{/if}}</strong></article>
                  </div>
